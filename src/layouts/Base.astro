---
import '../styles/global.css';
import LiveBanner from '../components/LiveBanner.astro';
import MobileBar from '../components/MobileBar.astro';

interface Props {
  title: string;
  description?: string;
  image?: string; // path relative to site base, e.g. "brand/church-reduce.png"
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const {
  title,
  description = 'Riverside Community Church in Horsham, PA. People Equipping People to Reflect the Transformational Love of Jesus.',
  image = 'media/og.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(`${base}/${image}`, Astro.site);

// Self-hosted fonts (latin subset). Inline so URLs follow the BASE env switch.
const range = 'unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const face = (family: string, style: string, weight: string, file: string) =>
  `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:swap;src:url(${base}/fonts/${file}.woff2) format('woff2');${range}}`;
const fontCss = [
  face('DM Serif Text', 'normal', '400', 'dmserif'),
  face('DM Serif Text', 'italic', '400', 'dmserif-italic'),
  face('Source Sans 3', 'normal', '400 700', 'sourcesans'),
  face('Source Sans 3', 'italic', '400', 'sourcesans-italic'),
  // Size-matched local fallbacks limit layout shift during swap.
  "@font-face{font-family:'DM Serif Fallback';src:local('Georgia');size-adjust:97%;ascent-override:94%;descent-override:29%;line-gap-override:0%}",
  "@font-face{font-family:'Source Sans Fallback';src:local('Arial');size-adjust:96%;ascent-override:101%;descent-override:39%;line-gap-override:0%}",
].join('');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}/icon-512.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <meta name="apple-mobile-web-app-title" content="Riverside" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#1c1c1c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Riverside Community Church" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Riverside Community Church, Horsham, PA" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="font" type="font/woff2" href={`${base}/fonts/dmserif.woff2`} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={`${base}/fonts/sourcesans.woff2`} crossorigin />
    <style set:html={fontCss}></style>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <LiveBanner />
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <MobileBar />
  </body>
</html>
