---
/**
 * Inner-page header.
 * image: path under public/, e.g. "/media/photos/welcome.jpg" (base is added for you).
 *        Omit for the plain stone header. Photos are decorative (alt=""), so the h1 carries meaning.
 * focus: optional CSS object-position for the photo, e.g. "30% 40%". Default "center".
 */
import { photo } from '../lib/site';
interface Props { eyebrow: string; title: string; lede?: string; image?: string; focus?: string }
const { eyebrow, title, lede, image, focus = 'center' } = Astro.props;
---
<section class:list={['page-head', image && 'has-image']}>
  {image && (
    <div class="page-head-media" aria-hidden="true">
      <img {...photo(image)} sizes="(min-width: 900px) 58vw, 100vw" alt="" fetchpriority="high" decoding="async" style={`object-position:${focus}`} />
    </div>
  )}
  <div class="container page-head-body">
    <p class="eyebrow fade-up">{eyebrow}</p>
    <h1 class="fade-up" style="--i:1">{title}</h1>
    {lede && <p class="lede fade-up" style="--i:2">{lede}</p>}
    <slot />
  </div>
</section>
