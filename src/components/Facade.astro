---
// Click-to-load YouTube player. Without JS the link opens YouTube.
interface Props { embed: string; href: string; thumb: string; title: string }
const { embed, href, thumb, title } = Astro.props;
---
<a class="yt-facade" href={href} data-embed={embed} data-title={title}>
  <img src={thumb} alt="" width="1280" height="720" loading="lazy" decoding="async" />
  <span class="yt-play" aria-hidden="true"></span>
  <span class="sr-only">Play {title}</span>
</a>

<script>
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a.yt-facade');
    if (!a) return;
    e.preventDefault();
    const f = document.createElement('iframe');
    f.src = a.dataset.embed!;
    f.title = a.dataset.title || 'YouTube video';
    f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    f.allowFullscreen = true;
    f.className = 'yt-frame';
    a.replaceWith(f);
  });
</script>

<style is:global>
  .yt-facade, .yt-frame {
    position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; border: 0;
    border-radius: var(--radius); overflow: hidden; background: var(--ink); box-shadow: var(--shadow-l);
  }
  .yt-facade img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .yt-facade::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle, rgb(28 28 28 / 0.1), rgb(28 28 28 / 0.45)); }
  .yt-play {
    position: absolute; z-index: 1; left: 50%; top: 50%; translate: -50% -50%;
    width: clamp(56px, 5vw + 32px, 88px); aspect-ratio: 1; border-radius: 50%; background: var(--gold);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.3); transition: transform 0.35s var(--ease), background-color 0.25s;
  }
  .yt-play::before { content: ''; position: absolute; left: 53%; top: 50%; translate: -50% -50%; border-block: 11px solid transparent; border-left: 17px solid var(--ink); }
  .yt-facade:hover img { transform: scale(1.03); }
  .yt-facade:hover .yt-play { transform: scale(1.08); background: var(--gold-soft); }
</style>
