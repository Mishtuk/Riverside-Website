---
import { CHURCH, href } from '../../lib/site';
const tel = `tel:+1${CHURCH.phone.replace(/\D/g, '')}`;
---

<section class="section visit" aria-labelledby="visit-title">
  <div class="container visit-grid">
    <div class="visit-copy">
      <h2 id="visit-title" class="h1">Join us <span class="accent">this Sunday.</span></h2>

      <dl class="facts">
        <div>
          <dt>Services</dt>
          <dd>Sundays at {CHURCH.services.map((s) => s.label).join(' and ')}</dd>
        </div>
        <div>
          <dt>Kids &amp; livestream</dt>
          <dd>During the 10:30am service</dd>
        </div>
        <div>
          <dt>Address</dt>
          <dd>{CHURCH.street}<br />{CHURCH.city}, {CHURCH.region} {CHURCH.zip}</dd>
        </div>
        <div>
          <dt>Questions?</dt>
          <dd><a href={tel}>{CHURCH.phone}</a></dd>
        </div>
      </dl>

      <div class="btn-row">
        <a class="btn" href={CHURCH.mapsUrl} rel="noopener">Get directions</a>
        <a class="btn btn-outline" href={href('/im-new')}>Plan your visit</a>
      </div>
    </div>

    <div class="map reveal">
      <iframe
        src={CHURCH.mapsEmbed}
        title="Map showing Riverside Community Church at 239 Columbia Avenue, Horsham"
        width="800" height="600" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .visit-grid { display: grid; gap: clamp(2.5rem, 2rem + 3vw, 4.5rem); align-items: center; }
  .facts { display: grid; gap: 1.5rem; margin-top: 2.25rem; }
  .facts div { padding-left: 1.25rem; border-left: 2px solid var(--gold); }
  dt { font-size: var(--step--1); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold-ink-sm); }
  dd { margin-top: 0.2rem; font-family: var(--font-display); font-size: var(--step-1); line-height: 1.35; }
  dd a { color: inherit; text-decoration-color: var(--gold); text-underline-offset: 4px; }
  .visit .btn-row { margin-top: 2.5rem; }

  .map {
    position: relative; overflow: hidden; aspect-ratio: 4 / 3.4; border-radius: var(--radius);
    background: var(--stone); box-shadow: var(--shadow-l);
  }
  .map iframe { width: 100%; height: 100%; border: 0; filter: grayscale(0.85) sepia(0.2) contrast(1.02); transition: filter 0.5s var(--ease); }
  .map:hover iframe, .map:focus-within iframe { filter: none; }

  @media (min-width: 640px) { .facts { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .visit-grid { grid-template-columns: 1fr 1.15fr; } }
</style>
