---
import { CHURCH, href } from '../../lib/site';
const sms = `sms:+1${CHURCH.textToGive.replace(/\D/g, '')}`;
---

<section class="section band-feature give" aria-labelledby="give-title">
  <img class="give-badge" src={href('/brand/church-reduce.png')} alt="" width="622" height="622" loading="lazy" />
  <div class="container">
    <h2 id="give-title" class="display give-title">Generosity <em class="accent">changes lives.</em></h2>
    <p class="lede">Your giving supports ministry in Horsham and partners around the world. Choose the way that works for you.</p>

    <div class="ways">
      <div class="way">
        <h3>Give online</h3>
        <p>Secure one-time or recurring gifts.</p>
        <a class="btn" href={href('/give')}>Give online</a>
      </div>
      <div class="way">
        <h3>Text to give</h3>
        <p>Send any amount by text message.</p>
        <a class="big-number" href={sms}>{CHURCH.textToGive}</a>
      </div>
      <div class="way">
        <h3>By mail</h3>
        <p>Make checks payable to {CHURCH.name}.</p>
        <address>{CHURCH.street}<br />{CHURCH.city}, {CHURCH.region} {CHURCH.zip}</address>
      </div>
    </div>
  </div>
</section>

<style>
  .give { overflow: hidden; }
  .give-badge {
    position: absolute; z-index: -1; right: -7rem; top: -5rem; width: clamp(20rem, 40vw, 38rem); height: auto;
    opacity: 0.07; pointer-events: none;
  }
  .give-title { max-width: 14ch; }
  .give .lede { margin-top: 1.25rem; max-width: 46ch; }

  .ways { display: grid; margin-top: clamp(2.5rem, 2rem + 3vw, 4rem); border-block: 1px solid var(--line-gold); }
  .way { display: flex; flex-direction: column; align-items: flex-start; gap: 0.5rem; padding: 2rem 0; }
  .way + .way { border-top: 1px solid var(--line-gold); }
  .way h3 { font-size: var(--step-2); }
  .way .btn { margin-top: 1rem; }
  .way address { margin-top: 0.75rem; font-style: normal; font-family: var(--font-display); font-size: var(--step-1); line-height: 1.35; color: var(--ink); }
  .big-number {
    margin-top: 0.5rem; font-family: var(--font-display); font-size: var(--step-4); line-height: 1.05;
    color: var(--gold-ink); text-decoration: none; white-space: nowrap; letter-spacing: -0.01em;
    background: linear-gradient(var(--gold), var(--gold)) 0 100% / 100% 2px no-repeat; padding-bottom: 4px;
    transition: color 0.25s var(--ease);
  }
  .big-number:hover { color: var(--ink); }

  @media (min-width: 900px) {
    .ways { grid-template-columns: repeat(3, 1fr); }
    .way { padding: 2.5rem 2.5rem 2.5rem 0; }
    .way + .way { padding-left: 2.5rem; border-top: 0; border-left: 1px solid var(--line-gold); }
  }
</style>
