---
import { getVideos } from '../../lib/youtube';
import { CHURCH, href } from '../../lib/site';

const videos = await getVideos(4);
const [latest, ...recent] = videos;
const watch = (id: string) => `https://www.youtube.com/watch?v=${id}`;
---

<section class="section band-paper latest" aria-labelledby="latest-title">
  <div class="container">
    <h2 id="latest-title" class="h1">Latest message</h2>

    {latest ? (
      <div class="feature">
        <a class="player" href={watch(latest.id)} data-yt={latest.id} data-vid={latest.id} data-date={latest.dateLabel} data-title={`${latest.displayTitle}, ${latest.dateLabel}`}>
          <img data-vid={latest.id}
            src={latest.thumbnail} data-fb={latest.thumbFallback} onerror="this.onerror=null;this.src=this.dataset.fb"
            alt="" width="1280" height="720" loading="lazy" decoding="async"
          />
          <span class="play" aria-hidden="true"></span>
          <span class="sr-only">Play <span data-vid={latest.id}>{latest.displayTitle}</span>, {latest.dateLabel}</span>
        </a>
        <div class="feature-meta">
          <p class="date"><time datetime={latest.dateISO}>{latest.dateLabel}</time></p>
          <h3 data-vid={latest.id}>{latest.displayTitle}</h3>
          <p class="muted">Missed Sunday? Catch up on the full service, worship and message from Riverside.</p>
          <div class="btn-row">
            <a class="btn btn-outline" href={href('/watch')}>All messages</a>
          </div>
        </div>
      </div>
    ) : (
      <div class="empty card">
        <h3>Watch on YouTube</h3>
        <p>Every Sunday service is streamed live at 10:30am.</p>
        <a class="btn btn-outline" href={CHURCH.socials.youtube}>Open our channel</a>
      </div>
    )}

    {recent.length > 0 && (
      <ul class="recent" role="list">
        {recent.map((v) => (
          <li>
            <a class="recent-item" href={watch(v.id)}>
              <div class="vthumb">
                <img data-vid={v.id} src={v.thumbnail} data-fb={v.thumbFallback} onerror="this.onerror=null;this.src=this.dataset.fb" alt="" width="1280" height="720" loading="lazy" decoding="async" />
                <span class="vplay" aria-hidden="true"></span>
              </div>
              <div>
                <p class="date"><time datetime={v.dateISO}>{v.dateCard}</time></p>
                <h3 data-vid={v.id}>{v.displayTitle}</h3>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<script is:inline>
  // Facade: swap in the privacy-enhanced player only when asked. No JS: link opens YouTube.
  document.querySelectorAll('.player[data-yt]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      navigator.sendBeacon?.('/api/stats/play', 'video'); // play count for the admin Statistics (no cookies)
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1&rel=0`;
      f.title = a.dataset.title || 'YouTube video';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      a.replaceWith(f);
    }, { once: true })
  );
</script>

<style>
  .latest h2 { margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem); }
  .feature { display: grid; gap: 1.75rem; align-items: center; }
  .player, .feature :global(iframe) {
    position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; border: 0;
    border-radius: var(--radius); overflow: hidden; background: var(--ink); box-shadow: var(--shadow-l);
  }
  .player img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease), filter 0.5s; }
  .player::after { /* ink gradient: calms burned-in lyrics */
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgb(28 28 28 / 0.05) 35%, rgb(28 28 28 / 0.72) 100%);
  }
  .play {
    position: absolute; z-index: 1; left: 50%; top: 50%; translate: -50% -50%;
    width: clamp(64px, 5vw + 40px, 96px); aspect-ratio: 1; border-radius: 50%;
    background: var(--gold); box-shadow: 0 10px 40px rgb(0 0 0 / 0.3);
    transition: transform 0.35s var(--ease), background-color 0.25s;
  }
  .play::before {
    content: ''; position: absolute; left: 53%; top: 50%; translate: -50% -50%;
    border-block: 12px solid transparent; border-left: 19px solid var(--ink);
  }
  .player:hover img { transform: scale(1.03); }
  .player:hover .play { transform: scale(1.08); background: var(--gold-soft); }

  .date { white-space: nowrap; font-size: var(--step--1); font-weight: 700; color: var(--gold-ink-sm); letter-spacing: 0.02em; }
  .feature-meta h3 { margin-top: 0.5rem; font-size: var(--step-3); }
  .feature-meta .muted { margin-top: 0.9rem; max-width: 38ch; }
  .feature-meta .btn-row { margin-top: 1.75rem; }

  .recent {
    list-style: none; padding: 0; display: grid; gap: 1.25rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem); padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .recent-item { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; align-items: center; text-decoration: none; color: inherit; }
  .vthumb { position: relative; overflow: hidden; aspect-ratio: 16 / 9; background: var(--ink); isolation: isolate; border-radius: var(--radius-s); }
  .vthumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .vthumb::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgb(28 28 28 / 0.7)); }
  .vplay { position: absolute; z-index: 1; right: 0.6rem; bottom: 0.55rem; width: 2.1rem; aspect-ratio: 1; border-radius: 50%; background: var(--gold); box-shadow: 0 4px 14px rgb(0 0 0 / 0.35); }
  .vplay::before { content: ''; position: absolute; left: 54%; top: 50%; translate: -50% -50%; border-block: 6px solid transparent; border-left: 10px solid var(--ink); }
  .recent-item:hover .vthumb img { transform: scale(1.04); }
  .recent-item h3 { margin-top: 0.2rem; font-size: var(--step-1); line-height: 1.25; }
  .recent-item:hover h3 { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 4px; }

  .empty { max-width: 40rem; }
  .empty .btn { margin-top: 1.25rem; }

  @media (min-width: 900px) {
    .feature { grid-template-columns: 1.75fr 1fr; gap: clamp(2rem, 4vw, 4rem); }
    .recent { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    .recent-item { grid-template-columns: 1fr; }
  }
</style>
