---
import { CHURCH, NAV, href } from '../lib/site';
const tel = `tel:+1${CHURCH.phone.replace(/\D/g, '')}`;

interface Props {
  /** Transparent header over a full-bleed hero (home page). Solid cream otherwise. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (path: string) => here === href(path) || here.startsWith(href(path) + '/');
---

{overlay && <div class="header-sentinel" aria-hidden="true"></div>}
<header class:list={['site-header', { 'is-overlay': overlay }]} data-overlay={overlay ? '' : undefined}>
  <div class="container header-bar">
    <a class="brand" href={href('/')}>
      <img src={href('/brand/logo-header.webp')} alt="Riverside Community Church home" width="156" height="52" />
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {NAV.map((l) => (
          <li><a href={href(l.path)} aria-current={isCurrent(l.path) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="btn btn-sm" href={href('/give')}>Give</a>
      <details class="nav-mobile">
        <summary>
          <span class="burger" aria-hidden="true"><span></span></span>
          <span class="menu-label">Menu</span>
        </summary>
        <div class="sheet">
          <nav aria-label="Main menu">
            <ul>
              {NAV.map((l) => (
                <li><a href={href(l.path)} aria-current={isCurrent(l.path) ? 'page' : undefined}>{l.label}</a></li>
              ))}
            </ul>
          </nav>
          <div class="sheet-info">
            <p class="sheet-times">{CHURCH.times}<span>{CHURCH.timesNote}</span></p>
            <a href={CHURCH.mapsUrl} rel="noopener">{CHURCH.street}, {CHURCH.city}, {CHURCH.region}</a>
            <a href={tel}>Call {CHURCH.phone}</a>
            <a class="btn" href={href('/give')}>Give online</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  // Phone menu: focus moves in on open; Escape or tapping a link closes it.
  (() => {
    const d = document.querySelector('.nav-mobile');
    if (!d) return;
    const sum = d.querySelector('summary');
    d.addEventListener('toggle', () => { if (d.open) d.querySelector('.sheet a').focus(); });
    d.addEventListener('click', (e) => { if (e.target.closest('.sheet a')) d.open = false; });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && d.open) { d.open = false; sum.focus(); } });
  })();
</script>

{overlay && (
  <script is:inline>
    // Solid header once the hero top scrolls away. No JS: header stays absolute and scrolls off.
    (() => {
      const h = document.querySelector('.site-header[data-overlay]');
      const s = document.querySelector('.header-sentinel');
      if (!h || !s || !('IntersectionObserver' in window)) return;
      h.classList.add('is-fixed');
      new IntersectionObserver(([e]) => h.classList.toggle('is-solid', !e.isIntersecting)).observe(s);
    })();
  </script>
)}

<style>
  .header-sentinel { position: absolute; inset: 0 0 auto; height: 120px; pointer-events: none; }

  .site-header {
    --fg: var(--ink);
    position: sticky; top: 0; z-index: 50;
    background: rgb(239 237 232 / 0.92);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
    color: var(--fg);
    transition: background-color 0.35s var(--ease), border-color 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .site-header.is-overlay {
    --fg: #fff;
    position: absolute; inset: 0 0 auto;
    background: transparent; border-color: transparent; backdrop-filter: none;
  }
  .site-header.is-overlay.is-fixed { position: fixed; }
  .site-header.is-overlay.is-solid,
  .site-header.is-overlay:has(details[open]) {
    --fg: var(--ink);
    background: rgb(239 237 232 / 0.94);
    backdrop-filter: saturate(1.4) blur(12px);
    border-color: var(--line);
    box-shadow: var(--shadow-s);
  }

  .header-bar { display: flex; align-items: center; gap: 1.5rem; min-height: var(--header-h); }
  .brand { display: block; flex-shrink: 0; margin-right: auto; padding-block: 0.4rem; }
  .brand img { height: 52px; width: auto; transition: filter 0.35s var(--ease); }
  .is-overlay:not(.is-solid):not(:has(details[open])) .brand img { filter: invert(1); }

  ul { list-style: none; padding: 0; }

  .nav-desktop { display: none; }
  .nav-desktop ul { display: flex; gap: clamp(0.25rem, 1vw, 1rem); }
  .nav-desktop a {
    position: relative; display: inline-flex; align-items: center; min-height: 44px; padding-inline: 0.6rem;
    color: var(--fg); text-decoration: none; font-weight: 600; font-size: 1.02rem; white-space: nowrap;
  }
  .nav-desktop a::after {
    content: ''; position: absolute; left: 0.6rem; right: 0.6rem; bottom: 6px; height: 2px;
    background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--ease);
  }
  .nav-desktop a:hover::after, .nav-desktop a[aria-current='page']::after { transform: scaleX(1); }

  .header-actions { display: flex; align-items: center; gap: 0.5rem; }

  /* Mobile menu (native details) */
  .nav-mobile summary {
    display: flex; align-items: center; gap: 0.5rem; min-height: 44px; min-width: 44px; padding: 0 0.75rem;
    border-radius: var(--radius-pill); color: var(--fg); font-weight: 700; list-style: none; cursor: pointer;
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .burger { position: relative; display: block; width: 22px; height: 14px; }
  .burger::before, .burger::after, .burger span {
    content: ''; position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px; background: currentColor;
    transition: transform 0.3s var(--ease), opacity 0.2s;
  }
  .burger::before { top: 0; }
  .burger span { top: 6px; }
  .burger::after { top: 12px; }
  details[open] .burger::before { transform: translateY(6px) rotate(45deg); }
  details[open] .burger span { opacity: 0; }
  details[open] .burger::after { transform: translateY(-6px) rotate(-45deg); }

  /* Full-screen sheet below the header bar. Fixed would be trapped by the header's backdrop-filter, so absolute + viewport height. */
  .sheet {
    position: absolute; left: 0; right: 0; top: 100%;
    height: calc(100dvh - var(--header-h) - var(--live-off, 0px) - env(safe-area-inset-top));
    display: flex; flex-direction: column; gap: 1.5rem;
    padding: 0.5rem max(var(--gutter), env(safe-area-inset-right)) calc(1.5rem + env(safe-area-inset-bottom)) max(var(--gutter), env(safe-area-inset-left));
    background: var(--cream); border-top: 1px solid var(--line);
    overflow-y: auto; overscroll-behavior: contain;
  }
  .sheet > * { width: 100%; max-width: 40rem; margin-inline: auto; }
  .sheet li + li { border-top: 1px solid var(--line); }
  .sheet nav a {
    display: flex; align-items: center; justify-content: space-between; min-height: 60px;
    font-family: var(--font-display); font-size: clamp(1.6rem, 1.3rem + 1.5vw, 2rem); color: var(--ink); text-decoration: none;
  }
  .sheet nav a::after { content: '\2192'; font-family: var(--font-body); font-size: 1.1rem; color: var(--gold-ink); }
  .sheet nav a[aria-current='page'] { color: var(--gold-ink); }
  .sheet nav a:active { opacity: 0.6; }

  .sheet-info {
    display: grid; gap: 0.25rem; margin-top: auto; padding: 1.25rem 1.25rem 1.25rem;
    background: var(--paper); border-radius: var(--radius); box-shadow: var(--shadow-s);
  }
  .sheet-times { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.2; }
  .sheet-times span { display: block; margin-top: 0.2rem; font-family: var(--font-body); font-size: var(--step--1); color: var(--muted); }
  .sheet-info a:not(.btn) {
    display: flex; align-items: center; min-height: 48px; color: var(--gold-ink); font-weight: 700;
    text-decoration: underline 1.5px var(--line-gold); text-underline-offset: 4px;
  }
  .sheet-info a:not(.btn) + a:not(.btn) { border-top: 1px solid var(--line); }
  .sheet-info .btn { margin-top: 0.75rem; min-height: 52px; font-size: 1.05rem; }

  @media (max-width: 1079px) {
    :global(html:has(.nav-mobile[open])), :global(html:has(.nav-mobile[open]) body) { overflow: hidden; }
  }

  @media (prefers-reduced-motion: no-preference) {
    details[open] .sheet { animation: sheet-in 0.35s var(--ease); }
    @keyframes sheet-in { from { opacity: 0; transform: translateY(-10px); } }
  }

  /* Phones: the bottom bar carries Give, so the header is just logo + menu. Landscape phones: compact bar. */
  @media (max-width: 699px) { .header-actions > .btn-sm { display: none; } }
  @media (orientation: landscape) and (max-height: 500px) { .brand img { height: 40px; } }
  .site-header { padding-top: env(safe-area-inset-top); }

  @media (max-width: 420px) {
    .menu-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .brand img { height: 44px; }
  }
  @media (min-width: 1080px) {
    .nav-desktop { display: block; }
    .nav-mobile { display: none; }
  }
</style>
