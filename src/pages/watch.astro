---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHead from '../components/PageHead.astro';
import Cta from '../components/Cta.astro';
import Facade from '../components/Facade.astro';
import VideoCard from '../components/VideoCard.astro';
import { CHURCH, LIVE, href } from '../lib/site';
import { getVideos } from '../lib/youtube';

const CHANNEL_ID = 'UCWcjfHPkDfMiiGgp0L8zDjQ';
const PLAYLIST = 'https://www.youtube.com/playlist?list=PLbS1l_W_y15idxZN2oJY6xpN-6NlCaRNE';
const videos = await getVideos(12);
---

<Base
  title="Watch | Riverside Community Church"
  description="Watch Riverside Community Church's Sunday service live at 10:30am, or catch up on recent messages and previous livestreams on YouTube."
>
  <Header slot="header" />

  <PageHead eyebrow="Watch" title="Church, wherever you are." image="/media/photos/message.jpg" focus="center" lede="Our Sunday service is livestreamed at 10:30am. Missed it? Every message stays on YouTube." />

  <section class="section" id="live">
    <div class="container live">
      <div>
        <Facade
          embed={`https://www.youtube-nocookie.com/embed/live_stream?channel=${CHANNEL_ID}&autoplay=1&rel=0`}
          href={`${CHURCH.socials.youtube}/live`}
          thumb={href('/media/hero-poster.jpg')}
          title="Riverside Sunday livestream"
        />
      </div>
      <div class="stack">
        <p class="eyebrow">Livestream</p>
        <p class="next" id="next-live">Sundays at {LIVE.serviceLabel}</p>
        <script is:inline define:vars={{ LIVE }}>
          (() => {
            const el = document.getElementById('next-live');
            const p = Object.fromEntries(new Intl.DateTimeFormat('en-US', { timeZone: LIVE.tz, weekday: 'short', year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).formatToParts(new Date()).map((x) => [x.type, x.value]));
            const mins = (hm) => hm.split(':')[0] * 60 + +hm.split(':')[1];
            const now = +p.hour * 60 + +p.minute;
            const wd = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(p.weekday);
            if (document.documentElement.hasAttribute('data-live')) { el.textContent = 'Live now'; el.dataset.live = ''; return; } // set by LiveBanner
            let add = (LIVE.day - wd + 7) % 7;
            if (add === 0 && (now >= mins(LIVE.banner.end) || document.documentElement.dataset.liveForce === 'off')) add = 7;
            const d = new Date(Date.UTC(+p.year, +p.month - 1, +p.day + add));
            el.textContent = 'Next livestream: ' + d.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric', timeZone: 'UTC' }) + ' at ' + LIVE.serviceLabel;
          })();
        </script>
        <h2 class="h1">Sundays at <span class="accent">10:30am</span></h2>
        <p class="muted">Press play to join the service. If nothing is streaming right now, the player will show the most recent broadcast or stay blank until we go live.</p>
        <div class="btn-row">
          <a class="btn" href={`${CHURCH.socials.youtube}/live`} rel="noopener">Open on YouTube</a>
          <a class="btn btn-outline" href={PLAYLIST} rel="noopener">Previous livestreams</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-paper" id="messages">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Recent messages</p>
        <h2 class="h1">Catch up on <span class="accent">Sunday.</span></h2>
      </div>
      {videos.length > 0 ? (
        <ul class="grid" role="list">
          {videos.map((v) => (
            <li><VideoCard v={v} /></li>
          ))}
        </ul>
      ) : (
        <p class="muted">Recent videos are unavailable right now. Please visit <a class="link" href={CHURCH.socials.youtube} rel="noopener">our YouTube channel</a>.</p>
      )}
      <div class="btn-row more">
        <a class="btn btn-outline" href={PLAYLIST} rel="noopener">Previous livestreams playlist</a>
        <a class="btn btn-outline" href={CHURCH.socials.youtube} rel="noopener">Visit our YouTube channel</a>
      </div>
    </div>
  </section>

  <Cta title="Prefer to listen?" text="Take Sunday with you on the go.">
    <a class="btn" href={href('/podcast')}>Podcast</a>
    <a class="btn btn-light" href={href('/im-new')}>Visit in person</a>
  </Cta>

  <Footer slot="footer" />
</Base>

<style>
  .live { display: grid; gap: clamp(2rem, 1.5rem + 3vw, 4rem); align-items: center; }
  .live h2 { margin-top: 0.5rem; }
  .next { font-weight: 600; color: var(--gold-ink-sm); }
  .next[data-live] { color: var(--ink); }
  .grid { list-style: none; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  .more { margin-top: 2.5rem; }
  @media (min-width: 900px) { .live { grid-template-columns: 1.6fr 1fr; } }
</style>
