---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHead from '../components/PageHead.astro';
import { CHURCH, href } from '../lib/site';
---

<Base title="Page not found | Riverside Community Church" description="That page could not be found.">
  <Header slot="header" />
  <PageHead eyebrow="404" title="We couldn't find that page." lede={`It may have moved. Here are a few places to start. We meet ${CHURCH.times}.`}>
    <div class="btn-row" style="margin-top:2rem">
      <a class="btn" href={href('/')}>Go home</a>
      <a class="btn btn-outline" href={href('/im-new')}>Service times</a>
      <a class="btn btn-outline" href={href('/watch')}>Watch</a>
    </div>
  </PageHead>
  <Footer slot="footer" />
</Base>

<script>
  // ponytail: client-side redirect from a 404, so search engines still see a 404; real 301s in server.js are the upgrade path.
  import { movedHome } from '../lib/moved.js';
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const path = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname;
  const to = movedHome(path);
  if (to) location.replace(base + to);
</script>

<style>
  /* Fill the phone screen so the 404 doesn't read as a footer with a header on top. */
  :global(.page-head) { min-height: calc(85svh - var(--header-h)); display: grid; align-content: center; }
</style>
