  // Resize in the browser (centre crop), so uploads stay small: 1280×720 for video cards, 600×600 for team photos.
  async function toThumb(file: File, w = 1280, h = 720): Promise<Blob> {
    const img = await createImageBitmap(file);
    const c = Object.assign(document.createElement('canvas'), { width: w, height: h });
    const s = Math.max(w / img.width, h / img.height);
    c.getContext('2d')!.drawImage(img, (w - img.width * s) / 2, (h - img.height * s) / 2, img.width * s, img.height * s);
    return new Promise((res, rej) => c.toBlob((b) => (b ? res(b) : rej(new Error('encode'))), 'image/jpeg', 0.85));
  }
  const list = $('#item-list');
  const rowOf = (t: EventTarget | null) => (t as HTMLElement).closest<HTMLElement>('.item')!;
