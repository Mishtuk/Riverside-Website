  .ithumb { width: 120px; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-s); background: var(--ink); }
  .ifields { display: grid; gap: 0.5rem; min-width: 0; }
  .item .btn-row { align-items: center; }
  .file:focus-within { outline: 3px solid var(--gold-ink); outline-offset: 3px; }
  .dirty { display: flex; align-items: center; gap: 0.75rem; font-weight: 700; color: var(--ink) !important; }
  .dirty[hidden] { display: none; }
  button.link { border: 0; cursor: pointer; font-size: 1rem; }
  .gcard { margin-top: 0; padding: 0; }
  .gcard > summary { position: relative; display: grid; gap: 0.35rem; min-height: 56px; padding: 1rem 3.25rem 1rem clamp(1.25rem, 1rem + 1vw, 2rem); cursor: pointer; list-style: none; color: var(--ink); }
  .gcard > summary::-webkit-details-marker { display: none; }
  .gcard > summary::after { content: '+'; position: absolute; right: 1.4rem; top: 1rem; font-size: 1.6rem; line-height: 1; color: var(--gold-ink); }
  .gcard[open] > summary::after { content: '\2212'; }
  .gname { font-weight: 700; font-size: var(--step-0); }
  .gmeta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.75rem; font-size: 0.95rem; }
  .gmeta .hint { font-size: 0.9rem; }
  .gform { margin: 0; padding: 0 clamp(1.25rem, 1rem + 1vw, 2rem) clamp(1.25rem, 1rem + 1vw, 2rem); }
  .chip-status { display: inline-flex; align-items: center; min-height: 32px; padding: 0.3rem 0.8rem; border-radius: var(--radius-pill); font-size: 0.9rem; font-weight: 700; line-height: 1.2; color: var(--ink); white-space: nowrap; }
  .chip-status.is-meeting { background: var(--gold-soft); border: 1.5px solid var(--gold); }
  .chip-status.is-off { background: var(--stone); border: 1.5px solid var(--stone-2); }
  .chip-status.is-break { border: 1.5px dashed var(--muted); color: var(--muted); }
  .news-list { list-style: none; padding: 0; display: grid; }
  /* Our team fields sit outside .form: same 16px inputs, so phones don't zoom. */
  #team-list input:not([type=file]), #team-list textarea { font: 400 max(1rem, 16px)/1.45 var(--font-body); padding: 0.65rem 0.9rem; min-height: 48px; width: 100%; border: 1.5px solid var(--stone-2); border-radius: var(--radius-s); background: #fff; }
  #team-list textarea { min-height: 7.5rem; }
  #team-list label { display: grid; gap: 0.3rem; font-weight: 700; font-size: var(--step--1); }
  .chip-imp { display: inline-flex; align-items: center; min-height: 32px; padding: 0.3rem 0.8rem; border-radius: var(--radius-pill); border: 1.5px solid var(--stone-2); font-size: 0.9rem; font-weight: 700; color: var(--ink); }
  .chip-imp.is-major { background: var(--gold-soft); border-color: var(--gold); }
  .reset-staff[aria-expanded='true'] { --btn-bg: var(--ink); --btn-fg: var(--cream); --btn-border: var(--ink); }
  #app .subnav .chips a { min-height: 44px; padding-block: 0.4rem; }
  .team-photo { width: 96px; height: 96px; object-fit: cover; border-radius: 50%; background: var(--stone); }
  .item.member-row { grid-template-columns: 96px 1fr; }
  #team-dirty:not([hidden]) { display: block; margin-top: 0.75rem; }
  .email-to { padding-left: 2rem !important; }
  .news-list > li { padding-block: 0.75rem; border-top: 1px solid var(--line); }
  .news-list p + p { margin-top: 0.15rem; }
  .ev { display: grid; gap: 0.6rem; padding: 0.9rem 0 0.9rem 1rem; border-left: 2px solid var(--line-gold) !important; }
  .ev-list { display: grid; gap: 0.75rem; }
  .two { display: grid; gap: 0.6rem; grid-template-columns: 1fr 1fr; }
  #confirm { margin: auto; width: min(28rem, calc(100% - 2rem)); border: 0; box-shadow: var(--shadow-l); }
  #confirm:not([open]) { display: none; }
  /* .btn and other display rules must not beat the hidden attribute anywhere in the admin */
  .admin-top [hidden], #gate [hidden], #must-change [hidden], #app [hidden] { display: none !important; }
  .admin-body button.link { padding-block: 0.6rem; } /* 44px tap rows */
  #confirm::backdrop { background: rgb(28 28 28 / 0.5); }
