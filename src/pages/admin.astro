    const a = (state.alerts ?? []).find((x: any) => x.id === (b.dataset.edit ?? b.dataset.end));
    if (!a) return;
    if (b.dataset.edit) {
      el.type.value = a.type; el.message.value = a.message; el.link.value = a.link ?? ''; el.expires.value = local(new Date(a.expires));
      el.group.value = a.group ?? ''; el.sitewide.checked = Boolean(a.sitewide); sitewideTouched = true;
      el.popup.checked = Boolean(a.popup); popupTouched = true; editingPopup = Boolean(a.popup); el.showAgain.checked = false;
