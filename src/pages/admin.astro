      + (news.length ? `<ul class="news-list" role="list">${news.map((n: any) => `<li data-nid="${esc(n.id)}"><p class="hint">${short(n.date, { weekday: 'short', month: 'short', day: 'numeric' })}</p><p><strong>${esc(n.title)}</strong></p>${n.body ? `<p class="hint">${esc(n.body.split('\n')[0])}</p>` : ''}<p><button type="button" class="link del-news">Delete</button></p></li>`).join('')}</ul>` : '<p class="hint">No updates yet.</p>');
  };
  function groupCard(g: any, open = false) {
