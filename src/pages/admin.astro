  .label { font-weight: 700; font-size: var(--step--1); margin-top: 0.5rem; }
  .err, .card p.err { color: var(--ink); font-weight: 700; }
  .note { padding: 0.6rem 0.9rem; background: var(--parchment); border-left: 3px solid var(--gold); color: var(--ink) !important; }
  .admin-body .alert-x { display: none; }
  .active-row { display: grid; gap: 0.5rem; }
  .preview { margin-bottom: 0.5rem; }
  .preview.is-empty .alert-msg { font-weight: 400; font-style: italic; opacity: 0.75; }
  .seg { margin-block: 1rem; }
  .chip { display: inline-flex; align-items: center; min-height: 44px; padding: 0.4rem 1.1rem; border-radius: var(--radius-pill); background: var(--paper); border: 1.5px solid var(--line); font-weight: 700; font-size: 0.95rem; }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--cream); border-color: var(--ink); }
  .item-list { list-style: none; padding: 0; display: grid; gap: 1rem; }
