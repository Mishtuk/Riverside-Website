  });

  // ---------- groups ----------
  // One collapsible card per group (closed by default). The form saves the group; "Post update" publishes a news
  // post on its own, so the group's other unsaved edits stay as they are.
  const TYPE_LABEL = Object.fromEntries(GROUP_TYPES) as Record<string, string>;
  const nextDay = (day: number) => { // the group's meeting day this week (ET), for a one-tap "Not meeting"
    const today = etDay(new Date());
    const d = new Date(`${today}T12:00:00Z`);
    if (day !== VARIES) d.setUTCDate(d.getUTCDate() + ((day - d.getUTCDay() + 7) % 7));
    return d.toISOString().slice(0, 10);
  };
  const short = (iso: string, o: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' }) => new Date(iso).toLocaleDateString('en-US', { ...o, timeZone: TZ });
  const updated = (iso?: string) => (iso ? `Updated ${short(iso)}` : 'Not saved yet');
  const eventRow = (e: any, place = '') => `<fieldset class="ev" data-id="${esc(e.id ?? crypto.randomUUID())}"><legend class="sr-only">Event</legend>
      <label>Event title <input data-f="title" required maxlength="80" value="${esc(e.title)}"></label>
      <div class="two"><label>Date <input type="date" data-f="date" required min="${etDay(new Date())}" value="${esc(e.date)}"></label>
      <label>Starts <input type="time" data-f="start" required value="${esc(e.start)}"></label></div>
      <div class="two"><label>Ends (optional) <input type="time" data-f="end" value="${esc(e.end)}"></label>
      <label>Place <input data-f="place" maxlength="80" value="${esc(e.place)}" placeholder="${esc(place || 'Same as the group')}"></label></div>
      <label>Note (optional) <input data-f="note" maxlength="140" value="${esc(e.note)}"></label>
      <p><button type="button" class="link ev-remove">Remove event</button></p>
    </fieldset>`;
  const summary = (g: any) => {
    const s = groupStatus(g, new Date());
    const alertOn = activeAlerts(state.alerts).some((a: any) => a.group === g.id);
    return `<span class="gname">${esc(g.name || 'New group')}</span><span class="gmeta"><span class="chip-status is-${s.kind}">${s.label}</span><span>${esc(TYPE_LABEL[g.type] ?? TYPE_LABEL.other)}</span>${alertOn ? "<span><strong>Alert on</strong></span>" : ""}<span class="hint">${updated(g.updated)}</span></span>`;
  };
  const newsList = (g: any) => {
    const news = g.news ?? [];
    const warn = news.length >= MAX_NEWS ? ` This group has ${MAX_NEWS} updates, so posting another removes the oldest.` : '';
    return `<p class="hint" id="nh-${esc(g.id)}">Plain text. Leave a blank line between paragraphs. Links work as-is.${warn}</p>`
