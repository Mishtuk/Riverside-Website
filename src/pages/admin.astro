  function renderItems() {
    const list = ITEMS[kind];
    const map = overrides();
    $('#item-list').innerHTML = !list.length
      ? `<li class="muted">${kind === 'video' ? 'No videos yet. New YouTube uploads appear here automatically.' : 'No podcast episodes found.'}</li>`
