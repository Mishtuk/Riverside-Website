---
// Staff tool. A static page with no secrets: signed-out visitors see the sign-in form, and every read or save
// goes to /api/admin/*, where the server checks the session cookie. Videos and episodes are the build-time feeds.
// The server fills <!--rs:email--> with the email module's section.
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
import { getVideos } from '../lib/youtube';
import { getSermons } from '../lib/podcast';
import { ALERT_CSS } from '../lib/state.js';

const [videos, sermons] = await Promise.all([getVideos(12), getSermons()]);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
const items = {
  video: videos.map((v) => ({ id: v.id, title: v.displayTitle, date: v.dateCard, thumb: v.thumbFallback })),
  podcast: sermons.map((s) => ({ id: s.guid, title: s.title, date: fmt(s.pubDate) })),
};
const icon = (d: string) => `<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">${d}</svg>`;
---

<Base title="Admin | Riverside Community Church" admin>
  <Fragment slot="head">
    <style set:html={ALERT_CSS}></style>
    <script type="application/json" id="items-data" set:html={JSON.stringify(items).replace(/</g, '\\u003c')}></script>
  </Fragment>

  <header slot="header" class="admin-top">
    <div class="container-narrow admin-bar">
      <a class="admin-brand" href={href('/')}><img src={href('/brand/logo-header.webp')} alt="Riverside Community Church" width="108" height="36" /><span>Admin</span></a>
      <a class="link" href={href('/')} target="_blank" rel="noopener">View site <span aria-hidden="true">&#x2197;</span></a>
      <button class="btn btn-sm btn-outline" type="button" id="sign-out" hidden>Sign out</button>
    </div>
  </header>

  <div id="gate" class="container-narrow gate" hidden>
    <form class="card form" id="pw-form" data-api={href('/api/login/password')} novalidate>
      <h1 class="h3">Staff sign in</h1>
      <label>Username <input name="username" required autocomplete="username" autocapitalize="off" spellcheck="false" /></label>
      <label>Password <input name="password" type="password" required autocomplete="current-password" /></label>
      <p class="err" id="pw-err" role="alert" hidden></p>
      <p><button class="btn" type="submit">Sign in</button></p>
    </form>
    <form class="card form" id="login-form" data-api={href('/api/login')} novalidate>
      <h2 class="h3">Or email me a sign-in link</h2>
      <p>Enter your church email address. We&rsquo;ll email you a link that signs you in.</p>
      <label>Email address <input type="email" name="email" required autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" /></label>
      <p class="err" id="login-err" hidden>&#x26A0; Enter an email like name@example.com.</p>
      <p><button class="btn btn-outline" type="submit">Email me a sign-in link</button></p>
      <p class="note" id="login-sent" role="status" hidden></p>
    </form>
  </div>

  <div id="must-change" class="container-narrow gate" hidden>
    <form class="card form" id="change-form" novalidate>
      <h1 class="h3">Choose a new password</h1>
      <p>This account still has a temporary or default password. Choose your own before doing anything else.</p>
      <label>New password <input name="password" type="password" required minlength="12" autocomplete="new-password" aria-describedby="np-help" /></label>
      <p class="hint" id="np-help">At least 12 characters. Not “admin” and not your username. A short sentence works well.</p>
      <label>New password again <input name="again" type="password" required autocomplete="new-password" /></label>
      <p class="err" id="change-err" role="alert" hidden></p>
      <p><button class="btn" type="submit">Save new password</button></p>
    </form>
  </div>

  <div id="app" data-api={href('/api/admin')} hidden>
    <div class="container-narrow default-warning" id="default-warning" hidden>
      <div class="alert alert-urgent" role="status">
        <svg class="ic" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 3.5 2.5 20h19z"/><path d="M12 10v4.5"/><circle cx="12" cy="17.3" r=".6"/></svg>
        <div><p class="alert-label">Important</p><p class="alert-msg">Default password in use: change it before launch.</p><p class="alert-more"><a class="link link-arrow" href="#staff">Staff accounts</a></p></div>
      </div>
    </div>
    <nav class="subnav" aria-label="Admin sections">
      <div class="container-narrow">
        <ul class="chips"><li><a href="#alerts">Alerts</a></li><li><a href="#stats">Statistics</a></li><li><a href="#email">Email</a></li><li><a href="#items">Videos &amp; podcast</a></li><li><a href="#groups">Groups</a></li><li><a href="#events">Events</a></li><li><a href="#team">Our team</a></li><li><a href="#live">Livestream</a></li><li><a href="#staff">Staff</a></li><li><a href="#activity">Activity</a></li><li><a href="#help">Help</a></li></ul>
      </div>
    </nav>

    <div class="container-narrow admin-body">
      <h1 class="sr-only">Admin</h1>
      <section id="alerts" aria-labelledby="alerts-h">
        <h2 id="alerts-h" class="h2">Alerts</h2>
        <h3 class="h3">Active alerts</h3>
        <div id="active" class="stack-s"></div>

        <form id="compose" class="card form" novalidate>
          <h3 class="h3">Post an alert</h3>
          <p id="editing" class="note" hidden>Editing an active alert. Posting replaces it. <button type="button" class="link" id="cancel-edit">Cancel edit</button></p>
          <fieldset class="types">
            <legend>Type</legend>
            <label class="type-card"><input type="radio" name="type" value="urgent" checked /><Fragment set:html={icon('<path d="M12 3.5 2.5 20h19z"/><path d="M12 10v4.5"/><circle cx="12" cy="17.3" r=".6"/>')} />Weather / closing (urgent)</label>
            <label class="type-card"><input type="radio" name="type" value="news" /><Fragment set:html={icon('<path d="M3.5 10v4h3l7 4.5v-13l-7 4.5z"/><path d="M17 9.5a3.5 3.5 0 0 1 0 5"/>')} />News / general</label>
          </fieldset>
          <label>Message <textarea name="message" rows="3" maxlength="200" required></textarea></label>
          <p class="hint" id="count">0 / 200</p>
          <label>Group (optional) <select name="group" aria-describedby="group-help"><option value="">None</option></select></label>
          <p class="hint" id="group-help">Pick a group to pin this alert to its section on the Groups page. Write when and where in the message. If the group isn’t meeting, also set “This week” on its card in Groups.</p>
          <label class="check" id="sitewide-row" hidden><input type="checkbox" name="sitewide" /> <span>Also show site-wide (the banner on every page)</span></label>
          <label class="check" id="popup-row"><input type="checkbox" name="popup" /> <span>Also show as a pop-up the first time someone visits (each person sees it once)</span></label>
          <label class="check" id="again-row" hidden><input type="checkbox" name="showAgain" /> <span>Show the pop-up again to people who already closed it</span></label>
          <label>Link (optional) <input name="link" type="text" inputmode="url" autocapitalize="off" spellcheck="false" placeholder="https://" /></label>
          <label>Expires <input name="expires" type="datetime-local" required aria-describedby="exp-help" /></label>
          <p class="hint" id="exp-help">It disappears from the site automatically after this.</p>
          <label class="check"><input type="checkbox" name="email" /> <span>Also email subscribers to <strong id="topic-name">Weather &amp; closing alerts</strong></span></label>
          <fieldset id="email-to" class="email-to" hidden><legend>Send the email to</legend>
            <label class="check"><input type="checkbox" name="etopic" value="group" checked /> <span id="etopic-group">The group’s list</span></label>
            <label class="check"><input type="checkbox" name="etopic" value="news" /> Latest happenings</label>
            <label class="check"><input type="checkbox" name="etopic" value="alerts" /> Weather &amp; closing alerts</label>
          </fieldset>
          <p class="hint" id="email-off" hidden>Email isn&rsquo;t configured yet, so alerts can only be posted on the site.</p>
          <p class="err" id="compose-err" hidden></p>
          <p class="label">Preview</p>
          <div id="preview" class="preview"></div>
          <div class="btn-row">
            <button class="btn" type="submit" id="post-btn">Post alert</button>
            <button class="btn btn-sm btn-outline" type="button" id="test-btn">Send a test to me</button>
          </div>
        </form>
      </section>

      <Fragment set:html="<!--rs:stats-->" />

      <Fragment set:html="<!--rs:email-->" />

      <section id="items" aria-labelledby="items-h">
        <h2 id="items-h" class="h2">Videos &amp; podcast</h2>
        <p class="muted">Tip: titles fixed on YouTube fix the site automatically. Use this when that isn&rsquo;t possible.</p>
        <ul class="chips seg" role="list">
          <li><button type="button" class="chip" data-kind="video" aria-pressed="true">Videos</button></li>
          <li><button type="button" class="chip" data-kind="podcast" aria-pressed="false">Podcast</button></li>
        </ul>
        <ul id="item-list" class="item-list" role="list"></ul>
      </section>

      <section id="groups" aria-labelledby="groups-h">
        <h2 id="groups-h" class="h2">Groups</h2>
        <p><button class="btn" type="button" id="add-group">Add a group</button></p>
        <div id="group-list" class="stack-s"></div>
      </section>

      <section id="events" aria-labelledby="events-h">
        <h2 id="events-h" class="h2">Events</h2>
        <p class="muted">Church-wide events. They show on the home page and the Events page, together with group events and this week’s group meetings.</p>
        <p><button class="btn" type="button" id="add-event">Add an event</button></p>
        <div id="event-list" class="stack-s"></div>
        <p class="hint">Past events are removed automatically.</p>
      </section>

      <section id="team" aria-labelledby="team-h">
        <h2 id="team-h" class="h2">Our team</h2>
        <p class="muted">Shown on the About page under “Meet the people”. The first person is featured with a large photo.</p>
        <ol id="team-list" class="item-list" role="list"></ol>
        <div class="btn-row"><button class="btn btn-sm btn-outline" type="button" id="add-member">Add a person</button><button class="btn btn-sm" type="button" id="save-team">Save team</button></div>
        <p class="dirty" id="team-dirty" hidden>Unsaved changes</p>
      </section>

      <section id="staff" aria-labelledby="staff-h">
        <h2 id="staff-h" class="h2">Staff accounts</h2>
        <form class="card form" id="own-pw" hidden novalidate>
          <h3 class="h3">Change your password</h3>
          <label>Current password <input name="current" type="password" required autocomplete="current-password" /></label>
          <label>New password <input name="password" type="password" required minlength="12" autocomplete="new-password" aria-describedby="own-help" /></label>
          <p class="hint" id="own-help">At least 12 characters. Not “admin” and not your username.</p>
          <label>New password again <input name="again" type="password" required autocomplete="new-password" /></label>
          <p class="err" id="own-err" role="alert" hidden></p>
          <p><button class="btn btn-sm" type="submit">Change password</button></p>
        </form>
        <h3 class="h3">Accounts</h3>
        <ul id="accounts" class="news-list" role="list"></ul>
        <form class="card form" id="add-staff" novalidate>
          <h3 class="h3">Add a staff account</h3>
          <label>Username <input name="username" required pattern="[a-z0-9._\-]{3,32}" autocapitalize="off" spellcheck="false" aria-describedby="add-help" /></label>
          <label>Temporary password <input name="password" type="text" required minlength="12" autocomplete="off" spellcheck="false" /></label>
          <p class="hint" id="add-help">Username: 3–32 lowercase letters, numbers, dots, dashes or underscores. Give them the temporary password in person or by phone; they must change it the first time they sign in.</p>
          <p class="err" id="add-err" role="alert" hidden></p>
          <p><button class="btn btn-sm" type="submit">Add account</button></p>
        </form>
        <h3 class="h3">Recent sign-ins</h3>
        <ul id="logins" class="news-list" role="list"></ul>
      </section>

      <section id="activity" aria-labelledby="activity-h">
        <h2 id="activity-h" class="h2">Activity</h2>
        <p class="muted">Who changed what, newest first (the last 200 changes and sign-ins).</p>
        <ul id="activity-list" class="news-list" role="list"></ul>
        <p><a class="btn btn-sm btn-outline" href={href('/api/admin/backup')} download>Download a backup</a></p>
        <p class="hint">One file with the site’s content (alerts, events, groups, team, edits) and the subscriber list. Keep it somewhere safe; the server also keeps 7 nightly copies.</p>
      </section>

      <section id="live" aria-labelledby="live-h">
        <h2 id="live-h" class="h2">Livestream</h2>
        <form id="live-form" class="card form">
          <fieldset>
            <legend>Home page live video</legend>
            <label class="check"><input type="radio" name="mode" value="auto" checked /> Automatic, on the usual Sunday schedule</label>
            <label class="check"><input type="radio" name="mode" value="on" /> Live now: show the stream</label>
            <label class="check"><input type="radio" name="mode" value="off" /> Not live: hide the stream</label>
          </fieldset>
          <label>YouTube video ID (optional) <input name="video" maxlength="11" pattern="[\w\-]{11}" autocapitalize="off" spellcheck="false" aria-describedby="vid-help" /></label>
          <p class="hint" id="vid-help">Only if the stream doesn&rsquo;t show on its own: the 11 characters after <code>watch?v=</code>.</p>
          <p><button class="btn btn-sm" type="submit">Save</button></p>
        </form>
      </section>
      <Fragment set:html="<!--rs:help-->" />
    </div>
  </div>

  <dialog id="confirm" class="card">
    <form method="dialog">
      <h2 class="h3" id="c-title"></h2>
      <p id="c-text"></p>
      <div class="btn-row">
        <button class="btn btn-outline" value="cancel" id="c-cancel">Cancel</button>
        <button class="btn btn-dark" value="ok" id="c-ok"></button>
      </div>
    </form>
  </dialog>
  <div class="toasts">
    <div id="toast" class="toast" role="status"></div>
    <div id="toast-err" class="toast" role="alert"></div>
  </div>
</Base>

<script>
  import { timeLabel, DAYS, GROUP_TYPES, MAX_NEWS, VARIES, TZ, alertCard, activeAlerts, applyOverride, esc, etDay, groupStatus } from '../lib/state.js';

  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as unknown as T;
  const app = $('#app');
  const API = app.dataset.api!;
  const ITEMS = JSON.parse($('#items-data').textContent!);
  const TOPIC = { urgent: 'Weather & closing alerts', news: 'Latest happenings' } as Record<string, string>;
  let state: any = {};
  let emailOn = false;
  let me = '';

  async function call(method: string, path: string, body?: unknown, raw?: Blob) {
    const r = await fetch(API + path, {
      method,
      headers: raw ? { 'Content-Type': raw.type } : body ? { 'Content-Type': 'application/json' } : {},
      body: raw ?? (body === undefined ? undefined : JSON.stringify(body)),
    });
    const j = await r.json().catch(() => ({}));
    if (r.status === 401) gate();
    if (!r.ok) throw Object.assign(new Error(j.error || String(r.status)), { data: j, status: r.status });
    return j;
  }

  // ---------- feedback ----------
  let toastTimer = 0;
  function toast(msg: string) {
    const t = $('#toast');
    t.textContent = msg;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (t.textContent = ''), 4000);
  }
  function fail(retry?: () => void, msg = 'Couldn’t save. Check your connection and try again.') {
    const t = $('#toast-err');
    t.innerHTML = `<span>${esc(msg)}</span>`;
    if (retry) {
      const b = Object.assign(document.createElement('button'), { type: 'button', className: 'btn btn-sm btn-light', textContent: 'Try again' });
      b.onclick = () => { t.textContent = ''; retry(); };
      t.append(b);
    }
    const x = Object.assign(document.createElement('button'), { type: 'button', className: 'toast-x', textContent: '✕' });
    x.setAttribute('aria-label', 'Dismiss');
    x.onclick = () => (t.textContent = '');
    t.append(x);
  }
  // Runs a save; on error keeps the fields as they are and offers "Try again".
  async function save(fn: () => Promise<void>, ok: string) {
    try { await fn(); $('#toast-err').textContent = ''; toast(ok); }
    catch (e: any) { if (e.status !== 401) fail(() => save(fn, ok)); }
  }
  function ask(title: string, text: string, verb: string): Promise<boolean> {
    const d = $<HTMLDialogElement>('#confirm');
    $('#c-title').textContent = title;
    $('#c-text').textContent = text;
    $('#c-ok').textContent = verb;
    d.returnValue = '';
    d.showModal();
    $('#c-cancel').focus();
    return new Promise((res) => d.addEventListener('close', () => res(d.returnValue === 'ok'), { once: true }));
  }
  function gate() {
    app.hidden = true;
    $('#must-change').hidden = true;
    $('#sign-out').hidden = true;
    $('#gate').hidden = false;
  }
  const PW_ERR: Record<string, string> = {
    too_short: 'Use at least 12 characters.', too_long: 'That is too long (200 characters at most).', too_easy: 'Choose something other than “admin” or your username.',
    same: 'Choose a password you haven’t used for this account.', current: 'Your current password isn’t right.', taken: 'That username is taken.',
    username: 'Use 3–32 lowercase letters, numbers, dots, dashes or underscores.', last: 'You can’t remove the last account.', self: 'Someone else has to remove your account.',
  };
  const showErr = (id: string, msg: string) => { const e = $(id); e.textContent = msg ? `⚠ ${msg}` : ''; e.hidden = !msg; };

  // Username + password.
  const NO_SERVER = 'Staff sign-in isn’t available on this preview. It will work once the site moves to its new hosting.';
  const pf = $<HTMLFormElement>('#pw-form');
  pf.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = pf.elements as any;
    if (!v.username.value.trim() || !v.password.value) return showErr('#pw-err', 'Enter your username and password.');
    const r = await fetch(pf.dataset.api!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: v.username.value, password: v.password.value }) }).catch(() => null);
    const j = await r?.json().catch(() => null);
    // No JSON back = no server behind the page (the static GitHub Pages preview).
    if (r && !j) { v.password.value = ''; return showErr('#pw-err', NO_SERVER); }
    if (!r?.ok) { v.password.value = ''; return showErr('#pw-err', j?.message ?? 'Something went wrong. Check your connection and try again.'); }
    location.reload();
  });
  // Forced change: the only thing a new account (or admin/admin) can do.
  const cf = $<HTMLFormElement>('#change-form');
  cf.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = cf.elements as any;
    if (v.password.value.length < 12) return showErr('#change-err', PW_ERR.too_short);
    if (v.password.value !== v.again.value) return showErr('#change-err', 'The two passwords don’t match.');
    try { await call('POST', '/password', { password: v.password.value }); location.reload(); }
    catch (err: any) { showErr('#change-err', PW_ERR[err.data?.error] ?? 'Couldn’t save. Try again.'); }
  });

  // ---------- sign in / out ----------
  const lg = $<HTMLFormElement>('#login-form');
  lg.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = (lg.elements as any).email as HTMLInputElement;
    $('#login-err').hidden = input.checkValidity();
    if (!input.checkValidity()) return input.focus();
    const r = await fetch(lg.dataset.api!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: input.value }) }).catch(() => null);
    const j = await r?.json().catch(() => null);
    const sent = $('#login-sent');
    sent.textContent = j?.message ?? (r ? NO_SERVER : 'Something went wrong. Check your connection and try again.');
    sent.hidden = false;
  });
  $('#sign-out').onclick = async () => {
    await fetch(API.replace(/admin$/, 'logout'), { method: 'POST' }).catch(() => null);
    location.reload();
  };

  // ---------- alerts ----------
  const f = $<HTMLFormElement>('#compose');
  const el = f.elements as any;
  let editing = '';
  let expTouched = false;
  let sitewideTouched = false;
  let popupTouched = false;
  let editingPopup = false;
  const groupName = (id: string) => (state.groups ?? []).find((g: any) => g.id === id)?.name ?? '';
  /** Email topics for the alert being written: the group's list and/or the site-wide topics. */
  const emailTopics = () => (el.group.value
    ? [...f.querySelectorAll<HTMLInputElement>('[name=etopic]:checked')].map((b) => (b.value === 'group' ? `group:${el.group.value}` : b.value))
    : [el.type.value === 'urgent' ? 'alerts' : 'news']);
  const local = (d: Date) => new Date(+d - d.getTimezoneOffset() * 6e4).toISOString().slice(0, 16);
  const ends = (iso: string) => new Date(iso).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: TZ }).replace(/\s([AP]M)/, (m) => m.trim().toLowerCase());
  function defaultExpiry() {
    const d = new Date();
    if (el.type.value === 'news') d.setDate(d.getDate() + 7);
    d.setHours(23, 59, 0, 0);
    el.expires.value = local(d);
  }
  function syncCompose() {
    const type = el.type.value;
    const n = el.message.value.length;
    const count = $('#count');
    count.textContent = `${n} / 200`;
    if (n >= 180) count.setAttribute('aria-live', 'polite'); else count.removeAttribute('aria-live');
    const group = el.group.value;
    $('#topic-name').textContent = group ? 'the lists below' : TOPIC[type];
    $('#sitewide-row').hidden = !group;
    // Urgent group alerts ("not meeting") default to the site-wide banner too; group news stays on the group.
    if (group && !sitewideTouched) el.sitewide.checked = false; // optional: a small group's change shouldn't fill every page
    // Pop-ups are for alerts on every page; weather / closing ones start ticked.
    const everyPage = !group || el.sitewide.checked;
    $('#popup-row').hidden = !everyPage;
    if (!popupTouched) el.popup.checked = everyPage && type === 'urgent';
    $('#again-row').hidden = !(editingPopup && everyPage && el.popup.checked);
    $('#email-to').hidden = !group || !el.email.checked;
    $('#etopic-group').textContent = group ? `${groupName(group)} list` : 'The group’s list';
    el.link.placeholder = group ? 'Leave blank to link to the group’s section' : 'https://';
    el.email.disabled = !emailOn;
    $('#email-off').hidden = emailOn;
    $('#post-btn').textContent = el.email.checked ? 'Post alert and email' : 'Post alert';
    ($('#test-btn') as HTMLButtonElement).hidden = !emailOn || !String(me).includes('@'); // password accounts have no address to test to
    let link = '';
    link = el.link.value.trim() || (group ? `/groups#${group}` : '');
    $('#preview').innerHTML = alertCard({ id: 'preview', type, message: el.message.value.trim() || 'Your message appears here.', link });
    $('#preview').classList.toggle('is-empty', !el.message.value.trim());
  }
  f.addEventListener('input', (e) => { if (e.target === el.expires) expTouched = true; if (e.target === el.sitewide) sitewideTouched = true; if (e.target === el.popup) popupTouched = true; syncCompose(); });
  f.addEventListener('change', (e) => { if (e.target === el.type[0] || e.target === el.type[1]) { if (!expTouched) defaultExpiry(); } syncCompose(); });

  function renderAlerts() {
    const list = activeAlerts(state.alerts);
    $('#active').innerHTML = list.length
