---
// Staff tool. A static page with no secrets: signed-out visitors see the sign-in form, and every read or save
// goes to /api/admin/*, where the server checks the session cookie. Videos and episodes are the build-time feeds.
// Layout: a dashboard shell (sidebar, top bar, one view at a time by #hash). The server fills <!--rs:email-->,
// <!--rs:stats--> and <!--rs:help--> inside the main area with those modules' views.
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
import { getVideos } from '../lib/youtube';
import { getSermons } from '../lib/podcast';
import { ALERT_CSS, ALERT_PRESETS } from '../lib/state.js';

const [videos, sermons] = await Promise.all([getVideos(12), getSermons()]);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
const items = {
  video: videos.map((v) => ({ id: v.id, title: v.displayTitle, date: v.dateCard, thumb: v.thumbFallback })),
  podcast: sermons.map((s) => ({ id: s.guid, title: s.title, date: fmt(s.pubDate) })),
};
const icon = (d: string) => `<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">${d}</svg>`;

// Sidebar: simple 24px line icons (drawn here, not copied from anywhere).
const I = {
  dashboard: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>',
  alerts: '<path d="M12 3.5 2.5 20h19z"/><path d="M12 10v4.5"/><circle cx="12" cy="17.3" r=".6"/>',
  events: '<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>',
  groups: '<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><circle cx="16.5" cy="9.5" r="2.5"/><path d="M15.5 14.2a4.5 4.5 0 0 1 5 5.3"/>',
  email: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  items: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m10 9 5 3-5 3z"/>',
  live: '<circle cx="12" cy="12" r="1.8"/><path d="M8.2 8.2a5.4 5.4 0 0 0 0 7.6M15.8 8.2a5.4 5.4 0 0 1 0 7.6M5.4 5.4a9.3 9.3 0 0 0 0 13.2M18.6 5.4a9.3 9.3 0 0 1 0 13.2"/>',
  team: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="10" r="3"/><path d="M6.6 18.2a6.5 6.5 0 0 1 10.8 0"/>',
  stats: '<path d="M4 20h16"/><path d="M7 16v-5M12 16V7M17 16v-8"/>',
  activity: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/><path d="M3.5 6.5V3.5M3.5 6.5h3"/>',
  staff: '<circle cx="8" cy="15" r="4"/><path d="m11 12 8.5-8.5M16.5 6.5l2.5 2.5M14.5 8.5l2 2"/>',
  backup: '<path d="M12 4v10M8 10l4 4 4-4"/><path d="M4 15v3.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V15"/>',
  help: '<circle cx="12" cy="12" r="9"/><path d="M9.6 9.3a2.5 2.5 0 1 1 3.4 2.3c-.6.3-1 .9-1 1.6v.6"/><circle cx="12" cy="17" r=".6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
};
const svg = (k: keyof typeof I) => `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">${I[k]}</svg>`;
const NAV: [string | null, [string, string, keyof typeof I][]][] = [
  [null, [['dashboard', 'Dashboard', 'dashboard']]],
  ['Publish', [['alerts', 'Alerts', 'alerts'], ['events', 'Events', 'events'], ['groups', 'Groups', 'groups'], ['email', 'Email', 'email']]],
  ['Media', [['items', 'Videos & podcast', 'items'], ['live', 'Livestream', 'live']]],
  ['Church', [['team', 'Our team', 'team']]],
  ['Insights', [['stats', 'Statistics', 'stats'], ['activity', 'Activity', 'activity']]],
  ['Settings', [['staff', 'Staff accounts', 'staff'], ['backup', 'Backup', 'backup']]],
];
---

<Base title="Admin | Riverside Community Church" admin>
  <Fragment slot="head">
    <style set:html={ALERT_CSS}></style>
    <script type="application/json" id="items-data" set:html={JSON.stringify(items).replace(/</g, '\\u003c')}></script>
  </Fragment>

  <Fragment slot="header">
    <aside class="a-side" id="a-side" aria-label="Admin menu">
      <a class="a-brand" href={href('/')}><img src={href('/brand/logo-header.webp')} alt="Riverside Community Church" width="96" height="32" /><span>Admin</span></a>
      <nav class="a-navs" aria-label="Admin sections">
        {NAV.map(([label, links], i) => (
          <>
            {label && <p class="a-group-label" id={`a-g${i}`}>{label}</p>}
            <ul aria-labelledby={label ? `a-g${i}` : undefined}>
              {links.map(([id, text, ic]) => (
                <li><a class="a-nav" href={`#${id}`} data-view={id}><Fragment set:html={svg(ic)} /><span>{text}</span>{id === 'alerts' && <span class="a-badge" id="a-alert-count" hidden></span>}</a></li>
              ))}
            </ul>
          </>
        ))}
      </nav>
      <div class="a-side-foot">
        <a class="a-nav" href="#help" data-view="help"><Fragment set:html={svg('help')} /><span>Help</span></a>
      </div>
    </aside>
    <div class="a-scrim" id="a-scrim" hidden></div>
    <header class="a-top">
      <button class="a-menu" id="a-menu" type="button" aria-label="Menu" aria-expanded="false" aria-controls="a-side"><Fragment set:html={svg('menu')} /></button>
      <a class="a-top-brand" href={href('/')}><img src={href('/brand/logo-header.webp')} alt="Riverside Community Church" width="96" height="32" /><span>Admin</span></a>
      <nav class="a-crumbs" aria-label="Breadcrumb"><ol><li>Admin</li><li aria-current="page" id="a-crumb">Dashboard</li></ol></nav>
      <span class="a-spacer"></span>
      <a class="a-link" href={href('/')} target="_blank" rel="noopener">View site <span aria-hidden="true">&#x2197;</span></a>
      <div class="a-user" id="a-user" hidden>
        <button class="a-user-btn" id="a-user-btn" type="button" aria-expanded="false" aria-controls="a-user-menu"><span class="a-avatar" id="a-initials" aria-hidden="true"></span><span class="a-user-name" id="a-user-name"></span><span class="sr-only"> account menu</span></button>
        <div class="a-user-menu" id="a-user-menu" hidden>
          <p id="a-user-who"></p>
          <a href="#staff" id="a-change-pw">Change password</a>
          <button type="button" id="sign-out" hidden>Sign out</button>
        </div>
      </div>
    </header>
  </Fragment>

  <div id="gate" class="gate" hidden>
    <form class="card form" id="pw-form" data-api={href('/api/login/password')} novalidate>
      <h1 class="a-title">Staff sign in</h1>
      <label>Username <input name="username" required autocomplete="username" autocapitalize="off" spellcheck="false" /></label>
      <label>Password <input name="password" type="password" required autocomplete="current-password" /></label>
      <p class="err" id="pw-err" role="alert" hidden></p>
      <p><button class="btn" type="submit">Sign in</button></p>
    </form>
    <form class="card form" id="login-form" data-api={href('/api/login')} novalidate>
      <h2 class="a-h2">Or email me a sign-in link</h2>
      <p>Enter your church email address. We&rsquo;ll email you a link that signs you in.</p>
      <label>Email address <input type="email" name="email" required autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" /></label>
      <p class="err" id="login-err" hidden>&#x26A0; Enter an email like name@example.com.</p>
      <p><button class="btn btn-outline" type="submit">Email me a sign-in link</button></p>
      <p class="note" id="login-sent" role="status" hidden></p>
    </form>
  </div>

  <div id="must-change" class="gate" hidden>
    <form class="card form" id="change-form" novalidate>
      <h1 class="a-title">Choose a new password</h1>
      <p>This account still has a temporary or default password. Choose your own before doing anything else.</p>
      <label>New password <input name="password" type="password" required minlength="12" autocomplete="new-password" aria-describedby="np-help" /></label>
      <p class="hint" id="np-help">At least 12 characters. Not “admin” and not your username. A short sentence works well.</p>
      <label>New password again <input name="again" type="password" required autocomplete="new-password" /></label>
      <p class="err" id="change-err" role="alert" hidden></p>
      <p><button class="btn" type="submit">Save new password</button></p>
    </form>
  </div>

  <div id="app" data-api={href('/api/admin')} hidden>
    <div class="a-warn" id="default-warning" hidden>
      <div class="alert alert-urgent" role="status">
        <svg class="ic" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 3.5 2.5 20h19z"/><path d="M12 10v4.5"/><circle cx="12" cy="17.3" r=".6"/></svg>
        <div><p class="alert-label">Important</p><p class="alert-msg">Default password in use: change it before launch.</p><p class="alert-more"><a class="link link-arrow" href="#staff">Staff accounts</a></p></div>
      </div>
    </div>

    <section id="dashboard" class="a-view" aria-labelledby="dashboard-h">
      <div class="a-head"><div><h1 class="a-title" id="dashboard-h" tabindex="-1">Dashboard</h1><p class="a-sub" id="a-greeting">Welcome.</p></div></div>
      <div class="a-quick">
        <button type="button" class="a-card a-quick-btn" data-quick="alerts" data-area="alerts"><Fragment set:html={svg('alerts')} />Post an alert</button>
        <button type="button" class="a-card a-quick-btn" data-quick="events" data-area="events"><Fragment set:html={svg('events')} />Add an event</button>
        <button type="button" class="a-card a-quick-btn" data-quick="email" data-area="email"><Fragment set:html={svg('email')} />Send an email</button>
        <button type="button" class="a-card a-quick-btn" data-quick="groups" data-area="groups"><Fragment set:html={svg('groups')} />Post a group update</button>
      </div>
      <div class="a-card" data-area="stats">
        <div class="a-card-h"><h2 class="a-h2">This week at a glance</h2><p class="a-card-tools"><span class="a-muted">Last 7 days</span> <a class="a-link" href="#stats">See statistics <span aria-hidden="true">&rarr;</span></a></p></div>
        <div class="a-tiles" id="d-tiles"></div>
        <p class="hint" id="d-tiles-note" hidden>Statistics aren&rsquo;t available right now.</p>
      </div>
      <div class="a-grid2">
        <div class="a-card" data-area="alerts">
          <div class="a-card-h"><h2 class="a-h2">Active alerts</h2><a class="a-link" href="#alerts">Alerts <span aria-hidden="true">&rarr;</span></a></div>
          <div id="d-alerts" class="stack-s"></div>
        </div>
        <div class="a-card" data-area="events">
          <div class="a-card-h"><h2 class="a-h2">Coming up</h2><a class="a-link" href="#events">All events <span aria-hidden="true">&rarr;</span></a></div>
          <ul class="a-list" id="d-events"></ul>
        </div>
        <div class="a-card" data-area="groups">
          <div class="a-card-h"><h2 class="a-h2">Groups this week</h2><a class="a-link" href="#groups">Groups <span aria-hidden="true">&rarr;</span></a></div>
          <ul class="a-list" id="d-groups"></ul>
        </div>
        <div class="a-card" data-area="activity">
          <div class="a-card-h"><h2 class="a-h2">Recent activity</h2><a class="a-link" href="#activity">See all <span aria-hidden="true">&rarr;</span></a></div>
          <ul class="a-list" id="d-activity"></ul>
        </div>
      </div>
    </section>

    <section id="alerts" class="a-view" aria-labelledby="alerts-h" hidden>
      <div class="a-head"><div><h1 id="alerts-h" class="a-title" tabindex="-1">Alerts</h1><p class="a-sub">What visitors see at the top of every page.</p></div></div>
      <div class="a-card">
        <div class="a-card-h"><h2 class="a-h2">Active alerts</h2></div>
        <div id="active" class="stack-s"></div>
      </div>

      <form id="compose" class="card form" novalidate>
        <h2 class="a-h2">Post an alert</h2>
        <p id="editing" class="note" hidden>Editing an active alert. Posting replaces it. <button type="button" class="link" id="cancel-edit">Cancel edit</button></p>
        <label>Alert type <select name="label" id="alert-label">{ALERT_PRESETS.map((l) => <option value={l}>{l}</option>)}<option value="custom">Custom…</option></select></label>
        <div class="form" id="custom-row" hidden>
          <label>Your own type <input name="customLabel" id="custom-label" maxlength="24" aria-describedby="custom-help" /></label>
          <p class="hint" id="custom-help">Up to 24 characters, e.g. “Parking” or “Youth trip”. <span id="custom-count">0 / 24</span></p>
        </div>
        <fieldset class="types">
          <legend>How urgent?</legend>
          <label class="type-card"><input type="radio" name="type" value="urgent" checked /><Fragment set:html={icon('<path d="M12 3.5 2.5 20h19z"/><path d="M12 10v4.5"/><circle cx="12" cy="17.3" r=".6"/>')} /><span><strong>Important:</strong> dark banner</span></label>
          <label class="type-card"><input type="radio" name="type" value="news" /><Fragment set:html={icon('<path d="M3.5 10v4h3l7 4.5v-13l-7 4.5z"/><path d="M17 9.5a3.5 3.5 0 0 1 0 5"/>')} /><span><strong>News:</strong> light banner</span></label>
        </fieldset>
        <label>Message <textarea name="message" rows="3" maxlength="200" required></textarea></label>
        <p class="hint" id="count">0 / 200</p>
        <label>Group (optional) <select name="group" aria-describedby="group-help"><option value="">None</option></select></label>
        <p class="hint" id="group-help">Pick a group to pin this alert to its section on the Groups page. Write when and where in the message. If the group isn’t meeting, also set “This week” on its card in Groups.</p>
        <label class="check" id="sitewide-row" hidden><input type="checkbox" name="sitewide" /> <span>Also show site-wide (the banner on every page)</span></label>
        <label class="check" id="popup-row"><input type="checkbox" name="popup" /> <span>Also show as a pop-up the first time someone visits (each person sees it once)</span></label>
        <label class="check" id="again-row" hidden><input type="checkbox" name="showAgain" /> <span>Show the pop-up again to people who already closed it</span></label>
        <label>Link (optional) <input name="link" type="text" inputmode="url" autocapitalize="off" spellcheck="false" placeholder="https://" /></label>
        <label>Expires <input name="expires" type="datetime-local" required aria-describedby="exp-help" /></label>
        <p class="hint" id="exp-help">It disappears from the site automatically after this.</p>
        <label class="check"><input type="checkbox" name="email" /> <span>Also email subscribers to <strong id="topic-name">Weather &amp; closing alerts</strong></span></label>
        <fieldset id="email-to" class="email-to" hidden><legend>Send the email to</legend>
          <label class="check"><input type="checkbox" name="etopic" value="group" checked /> <span id="etopic-group">The group’s list</span></label>
          <label class="check"><input type="checkbox" name="etopic" value="news" /> Latest happenings</label>
          <label class="check"><input type="checkbox" name="etopic" value="alerts" /> Weather &amp; closing alerts</label>
        </fieldset>
        <p class="hint" id="email-off" hidden>Email isn&rsquo;t configured yet, so alerts can only be posted on the site.</p>
        <p class="err" id="compose-err" hidden></p>
        <p class="label">Preview</p>
        <div id="preview" class="preview a-sunken"></div>
        <div class="btn-row">
          <button class="btn" type="submit" id="post-btn">Post alert</button>
          <button class="btn btn-sm btn-outline" type="button" id="test-btn">Send a test to me</button>
        </div>
      </form>
    </section>

    <Fragment set:html="<!--rs:stats-->" />

    <Fragment set:html="<!--rs:email-->" />

    <section id="items" class="a-view" aria-labelledby="items-h" hidden>
      <div class="a-head"><div><h1 id="items-h" class="a-title" tabindex="-1">Videos &amp; podcast</h1><p class="a-sub">Tip: titles fixed on YouTube fix the site automatically. Use this when that isn&rsquo;t possible.</p></div><div class="a-actions"><button class="btn" type="button" id="add-video">Add a video</button><button class="btn" type="button" id="add-episode" hidden>Add a podcast episode</button></div></div>
      <div class="a-tabs" role="group" aria-label="Videos or podcast">
        <button type="button" data-kind="video" aria-pressed="true">Videos</button>
        <button type="button" data-kind="podcast" aria-pressed="false">Podcast</button>
      </div>
      <ul id="item-list" class="item-list" role="list"></ul>
    </section>

    <section id="groups" class="a-view" aria-labelledby="groups-h" hidden>
      <div class="a-head"><div><h1 id="groups-h" class="a-title" tabindex="-1">Groups</h1><p class="a-sub">Who’s meeting this week, news and events for each group.</p></div><div class="a-actions"><button class="btn" type="button" id="add-group">Add a group</button></div></div>
      <div id="group-list" class="stack-s"></div>
    </section>

    <section id="events" class="a-view" aria-labelledby="events-h" hidden>
      <div class="a-head"><div><h1 id="events-h" class="a-title" tabindex="-1">Events</h1><p class="a-sub">Church-wide events. They show on the home page and the Events page, together with group events and this week’s group meetings.</p></div><div class="a-actions"><button class="btn" type="button" id="add-event">Add an event</button></div></div>
      <div id="event-list" class="stack-s"></div>
      <p class="hint">Past events are removed automatically.</p>
    </section>

    <section id="team" class="a-view" aria-labelledby="team-h" hidden>
      <div class="a-head"><div><h1 id="team-h" class="a-title" tabindex="-1">Our team</h1><p class="a-sub">Shown on the About page under “Meet the people”. The first person is featured with a large photo.</p></div><div class="a-actions"><button class="btn btn-outline" type="button" id="add-member">Add a person</button><button class="btn" type="button" id="save-team">Save team</button></div></div>
      <p class="dirty" id="team-dirty" hidden>Unsaved changes</p>
      <ol id="team-list" class="item-list" role="list"></ol>
    </section>

    <section id="staff" class="a-view" aria-labelledby="staff-h" hidden>
      <div class="a-head"><div><h1 id="staff-h" class="a-title" tabindex="-1">Staff accounts</h1><p class="a-sub">Who can sign in to this admin.</p></div></div>
      <div class="a-tabs" role="group" aria-label="Staff accounts sections" id="staff-tabs">
        <button type="button" data-staff-tab="accounts" aria-pressed="true">Accounts</button>
        <button type="button" data-staff-tab="permissions" aria-pressed="false">Permissions</button>
      </div>
      <form class="card form" id="own-pw" hidden novalidate>
        <h2 class="a-h2">Change your password</h2>
        <label>Current password <input name="current" type="password" required autocomplete="current-password" /></label>
        <label>New password <input name="password" type="password" required minlength="12" autocomplete="new-password" aria-describedby="own-help" /></label>
        <p class="hint" id="own-help">At least 12 characters. Not “admin” and not your username.</p>
        <label>New password again <input name="again" type="password" required autocomplete="new-password" /></label>
        <p class="err" id="own-err" role="alert" hidden></p>
        <p><button class="btn btn-sm" type="submit">Change password</button></p>
      </form>
      <div id="staff-perms" class="stack-s" hidden></div>
      <div id="staff-accounts" class="a-stack">
      <div class="a-card">
        <div class="a-card-h"><h2 class="a-h2">Accounts</h2></div>
        <ul id="accounts" class="a-list news-list" role="list"></ul>
      </div>
      <form class="card form" id="add-staff" novalidate>
        <h2 class="a-h2">Add a staff account</h2>
        <label>Username <input name="username" required pattern="[a-z0-9._\-]{3,32}" autocapitalize="off" spellcheck="false" aria-describedby="add-help" /></label>
        <label>Temporary password <input name="password" type="text" required minlength="12" autocomplete="off" spellcheck="false" /></label>
        <p class="hint" id="add-help">Username: 3–32 lowercase letters, numbers, dots, dashes or underscores. Give them the temporary password in person or by phone; they must change it the first time they sign in.</p>
        <fieldset class="types"><legend>Role</legend>
          <label class="type-card"><input type="radio" name="role" value="admin" /> Admin: can do everything</label>
          <label class="type-card"><input type="radio" name="role" value="limited" checked /> Limited: only the areas ticked below</label>
        </fieldset>
        <p class="hint all-areas" hidden>Admins can use every area.</p>
        <fieldset class="area-boxes"><legend>Areas</legend><div class="two" id="add-staff-areas"></div></fieldset>
        <p class="hint">You can change this later in Permissions.</p>
        <p class="err" id="add-err" role="alert" hidden></p>
        <p><button class="btn btn-sm" type="submit">Add account</button></p>
      </form>
      <div class="a-card">
        <div class="a-card-h"><h2 class="a-h2">Recent sign-ins</h2></div>
        <ul id="logins" class="a-list news-list" role="list"></ul>
      </div>
      </div>
    </section>

    <section id="a-denied" class="a-view" aria-labelledby="denied-h" hidden>
      <div class="a-head"><div><h1 class="a-title" id="denied-h" tabindex="-1">No access</h1></div></div>
      <div class="a-card"><p>You don’t have access to this area. Ask an admin to change your permissions.</p><p><a class="btn btn-outline" href="#dashboard">Back to the dashboard</a></p></div>
    </section>

    <section id="activity" class="a-view" aria-labelledby="activity-h" hidden>
      <div class="a-head"><div><h1 id="activity-h" class="a-title" tabindex="-1">Activity</h1><p class="a-sub">Who changed what, newest first (the last 200 changes and sign-ins).</p></div></div>
      <div class="a-card"><ul id="activity-list" class="a-list news-list" role="list"></ul></div>
    </section>

    <section id="backup" class="a-view" aria-labelledby="backup-h" hidden>
      <div class="a-head"><div><h1 id="backup-h" class="a-title" tabindex="-1">Backup</h1><p class="a-sub">Keep your own copy of everything the church has put on the site.</p></div></div>
      <div class="a-card">
        <p><a class="btn" href={href('/api/admin/backup')} download>Download a backup</a></p>
        <p class="hint">One file with the site’s content (alerts, events, groups, team, edits) and the subscriber list. Keep it somewhere safe; the server also keeps 7 nightly copies.</p>
      </div>
    </section>

    <section id="live" class="a-view" aria-labelledby="live-h" hidden>
      <div class="a-head"><div><h1 id="live-h" class="a-title" tabindex="-1">Livestream</h1><p class="a-sub">The live video on the home page.</p></div></div>
      <form id="live-form" class="card form">
        <fieldset>
          <legend>Home page live video</legend>
          <label class="check"><input type="radio" name="mode" value="auto" checked /> Automatic, on the usual Sunday schedule</label>
          <label class="check"><input type="radio" name="mode" value="on" /> Live now: show the stream</label>
          <label class="check"><input type="radio" name="mode" value="off" /> Not live: hide the stream</label>
        </fieldset>
        <label>YouTube video ID (optional) <input name="video" maxlength="11" pattern="[\w\-]{11}" autocapitalize="off" spellcheck="false" aria-describedby="vid-help" /></label>
        <p class="hint" id="vid-help">Only if the stream doesn&rsquo;t show on its own: the 11 characters after <code>watch?v=</code>.</p>
        <p><button class="btn btn-sm" type="submit">Save</button></p>
      </form>
    </section>
    <Fragment set:html="<!--rs:help-->" />
  </div>

  <dialog id="confirm" class="card">
    <form method="dialog">
      <h2 class="a-h2" id="c-title"></h2>
      <p id="c-text"></p>
      <div class="btn-row">
        <button class="btn btn-outline" value="cancel" id="c-cancel">Cancel</button>
        <button class="btn btn-dark" value="ok" id="c-ok"></button>
      </div>
    </form>
  </dialog>
  <div class="toasts">
    <div id="toast" class="toast" role="status"></div>
    <div id="toast-err" class="toast" role="alert"></div>
  </div>
</Base>

<script>
  import { timeLabel, upcomingItems, ALERT_PRESETS, URGENT_PRESETS, LABEL_MAX, DAYS, GROUP_TYPES, MAX_NEWS, VARIES, TZ, alertCard, activeAlerts, applyOverride, esc, etDay, groupStatus } from '../lib/state.js';

  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as unknown as T;
  const app = $('#app');
  const API = app.dataset.api!;
  const ITEMS = JSON.parse($('#items-data').textContent!);
  const TOPIC = { urgent: 'Weather & closing alerts', news: 'Latest happenings' } as Record<string, string>;
  let state: any = {};
  let emailOn = false;
  let me = '';

  async function call(method: string, path: string, body?: unknown, raw?: Blob) {
    const r = await fetch(API + path, {
      method,
      headers: raw ? { 'Content-Type': raw.type } : body ? { 'Content-Type': 'application/json' } : {},
      body: raw ?? (body === undefined ? undefined : JSON.stringify(body)),
    });
    const j = await r.json().catch(() => ({}));
    if (r.status === 401) gate();
    if (r.status === 403 && j.error === 'forbidden') {
      fail(undefined, 'You don’t have permission to change this. Ask an admin.');
      throw Object.assign(new Error('forbidden'), { data: j, status: 403, handled: true });
    }
    if (!r.ok) throw Object.assign(new Error(j.error || String(r.status)), { data: j, status: r.status });
    return j;
  }

  // ---------- feedback ----------
  let toastTimer = 0;
  function toast(msg: string) {
    const t = $('#toast');
    t.textContent = msg;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (t.textContent = ''), 4000);
  }
  function fail(retry?: () => void, msg = 'Couldn’t save. Check your connection and try again.') {
    const t = $('#toast-err');
    t.innerHTML = `<span>${esc(msg)}</span>`;
    if (retry) {
      const b = Object.assign(document.createElement('button'), { type: 'button', className: 'btn btn-sm btn-light', textContent: 'Try again' });
      b.onclick = () => { t.textContent = ''; retry(); };
      t.append(b);
    }
    const x = Object.assign(document.createElement('button'), { type: 'button', className: 'toast-x', textContent: '✕' });
    x.setAttribute('aria-label', 'Dismiss');
    x.onclick = () => (t.textContent = '');
    t.append(x);
  }
  // Runs a save; on error keeps the fields as they are and offers "Try again".
  async function save(fn: () => Promise<void>, ok: string) {
    try { await fn(); $('#toast-err').textContent = ''; toast(ok); }
    catch (e: any) { if (e.status !== 401 && !e.handled) fail(() => save(fn, ok)); }
  }
  function ask(title: string, text: string, verb: string): Promise<boolean> {
    const d = $<HTMLDialogElement>('#confirm');
    $('#c-title').textContent = title;
    $('#c-text').textContent = text;
    $('#c-ok').textContent = verb;
    d.returnValue = '';
    d.showModal();
    $('#c-cancel').focus();
    return new Promise((res) => d.addEventListener('close', () => res(d.returnValue === 'ok'), { once: true }));
  }
  function gate() {
    body.classList.remove('a-in', 'a-must');
    $('#a-user').hidden = true;
    app.hidden = true;
    $('#must-change').hidden = true;
    $('#sign-out').hidden = true;
    $('#gate').hidden = false;
  }
  const PW_ERR: Record<string, string> = {
    too_short: 'Use at least 12 characters.', too_long: 'That is too long (200 characters at most).', too_easy: 'Choose something other than “admin” or your username.',
    same: 'Choose a password you haven’t used for this account.', current: 'Your current password isn’t right.', taken: 'That username is taken.',
    username: 'Use 3–32 lowercase letters, numbers, dots, dashes or underscores.', last: 'You can’t remove the last account.', self: 'Someone else has to remove your account.', last_admin: 'There must always be at least one admin. Make someone else an admin first.',
  };
  const showErr = (id: string, msg: string) => { const e = $(id); e.textContent = msg ? `⚠ ${msg}` : ''; e.hidden = !msg; };

  // Username + password.
  const NO_SERVER = 'Staff sign-in isn’t available on this preview. It will work once the site moves to its new hosting.';
  const pf = $<HTMLFormElement>('#pw-form');
  pf.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = pf.elements as any;
    if (!v.username.value.trim() || !v.password.value) return showErr('#pw-err', 'Enter your username and password.');
    const r = await fetch(pf.dataset.api!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: v.username.value, password: v.password.value }) }).catch(() => null);
    const j = await r?.json().catch(() => null);
    // No JSON back = no server behind the page (the static GitHub Pages preview).
    if (r && !j) { v.password.value = ''; return showErr('#pw-err', NO_SERVER); }
    if (!r?.ok) { v.password.value = ''; return showErr('#pw-err', j?.message ?? 'Something went wrong. Check your connection and try again.'); }
    location.reload();
  });
  // Forced change: the only thing a new account (or admin/admin) can do.
  const cf = $<HTMLFormElement>('#change-form');
  cf.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = cf.elements as any;
    if (v.password.value.length < 12) return showErr('#change-err', PW_ERR.too_short);
    if (v.password.value !== v.again.value) return showErr('#change-err', 'The two passwords don’t match.');
    try { await call('POST', '/password', { password: v.password.value }); location.reload(); }
    catch (err: any) { showErr('#change-err', PW_ERR[err.data?.error] ?? 'Couldn’t save. Try again.'); }
  });

  // ---------- sign in / out ----------
  const lg = $<HTMLFormElement>('#login-form');
  lg.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = (lg.elements as any).email as HTMLInputElement;
    $('#login-err').hidden = input.checkValidity();
    if (!input.checkValidity()) return input.focus();
    const r = await fetch(lg.dataset.api!, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: input.value }) }).catch(() => null);
    const j = await r?.json().catch(() => null);
    const sent = $('#login-sent');
    sent.textContent = j?.message ?? (r ? NO_SERVER : 'Something went wrong. Check your connection and try again.');
    sent.hidden = false;
  });
  $('#sign-out').onclick = async () => {
    await fetch(API.replace(/admin$/, 'logout'), { method: 'POST' }).catch(() => null);
    location.reload();
  };

  // ---------- alerts ----------
  const f = $<HTMLFormElement>('#compose');
  const el = f.elements as any;
  let editing = '';
  let expTouched = false;
  let sitewideTouched = false;
  let popupTouched = false;
  let editingPopup = false;
  let typeTouched = false;
  // Seal and other site images follow the site's base path (the admin's own logo tells us what it is).
  const BASE = ($('.a-brand img')?.getAttribute('src') ?? '').replace(/\/brand\/.*$/, '');
  const chosenLabel = () => (el.label.value === 'custom' ? el.customLabel.value.trim() : el.label.value);
  const groupName = (id: string) => (state.groups ?? []).find((g: any) => g.id === id)?.name ?? '';
  /** Email topics for the alert being written: the group's list and/or the site-wide topics. */
  const emailTopics = () => (el.group.value
    ? [...f.querySelectorAll<HTMLInputElement>('[name=etopic]:checked')].map((b) => (b.value === 'group' ? `group:${el.group.value}` : b.value))
    : [el.type.value === 'urgent' ? 'alerts' : 'news']);
  const local = (d: Date) => new Date(+d - d.getTimezoneOffset() * 6e4).toISOString().slice(0, 16);
  const ends = (iso: string) => new Date(iso).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: TZ }).replace(/\s([AP]M)/, (m) => m.trim().toLowerCase());
  function defaultExpiry() {
    const d = new Date();
    if (el.type.value === 'news') d.setDate(d.getDate() + 7);
    d.setHours(23, 59, 0, 0);
    el.expires.value = local(d);
  }
  function syncCompose() {
    const type = el.type.value;
    const n = el.message.value.length;
    const count = $('#count');
    count.textContent = `${n} / 200`;
    if (n >= 180) count.setAttribute('aria-live', 'polite'); else count.removeAttribute('aria-live');
    const group = el.group.value;
    $('#topic-name').textContent = group ? 'the lists below' : TOPIC[type];
    $('#sitewide-row').hidden = !group;
    // Urgent group alerts ("not meeting") default to the site-wide banner too; group news stays on the group.
    if (group && !sitewideTouched) el.sitewide.checked = false; // optional: a small group's change shouldn't fill every page
    // Pop-ups are for alerts on every page; weather / closing ones start ticked.
    const everyPage = !group || el.sitewide.checked;
    $('#popup-row').hidden = !everyPage;
    if (!popupTouched) el.popup.checked = everyPage && type === 'urgent';
    $('#again-row').hidden = !(editingPopup && everyPage && el.popup.checked);
    $('#email-to').hidden = !group || !el.email.checked;
    $('#etopic-group').textContent = group ? `${groupName(group)} list` : 'The group’s list';
    el.link.placeholder = group ? 'Leave blank to link to the group’s section' : 'https://';
    el.email.disabled = !emailOn;
    $('#email-off').hidden = emailOn;
    $('#post-btn').textContent = el.email.checked ? 'Post alert and email' : 'Post alert';
    ($('#test-btn') as HTMLButtonElement).hidden = !emailOn || !String(me).includes('@'); // password accounts have no address to test to
    let link = '';
    link = el.link.value.trim() || (group ? `/groups#${group}` : '');
    const custom = el.label.value === 'custom';
    $('#custom-row').hidden = !custom;
    $('#custom-count').textContent = `${el.customLabel.value.length} / ${LABEL_MAX}`;
    $('#preview').innerHTML = alertCard({ id: 'preview', type, label: chosenLabel(), message: el.message.value.trim() || 'Your message appears here.', link }, BASE);
    $('#preview').classList.toggle('is-empty', !el.message.value.trim());
  }
  f.addEventListener('input', (e) => { if (e.target === el.expires) expTouched = true; if (e.target === el.sitewide) sitewideTouched = true; if (e.target === el.popup) popupTouched = true; syncCompose(); });
  f.addEventListener('change', (e) => {
    if (e.target === el.label && !typeTouched) { // Weather, Closing, Cancelled start as Important; the rest as News
      el.type.value = URGENT_PRESETS.includes(el.label.value) ? 'urgent' : 'news';
      if (!expTouched) defaultExpiry();
    }
    if (e.target === el.type[0] || e.target === el.type[1]) { typeTouched = true; if (!expTouched) defaultExpiry(); }
    syncCompose();
  });

  function renderAlerts() {
    const list = activeAlerts(state.alerts);
    const badge = $('#a-alert-count');
    badge.textContent = String(list.length);
    badge.hidden = !list.length;
    badge.setAttribute('aria-label', `${list.length} active`);
    $('#active').innerHTML = list.length
      ? list.map((a: any) => `<div class="active-row">${alertCard(a, BASE)}<p class="hint">${a.group ? `${esc(groupName(a.group))} · ${a.sitewide ? 'Also site-wide' : 'Only on the group'} · ` : ''}Ends ${ends(a.expires)}${a.popup ? ' · Pop-up' : ''}${a.emailed ? ' · Emailed' : ''}</p><div class="btn-row"><button type="button" class="btn btn-sm btn-outline" data-edit="${esc(a.id)}">Edit</button><button type="button" class="btn btn-sm btn-outline" data-end="${esc(a.id)}">End now</button></div></div>`).join('')
      : '<p class="muted">No active alerts. The site shows no banner.</p>';
  }
  function resetCompose() {
    f.reset();
    editing = '';
    expTouched = false;
    sitewideTouched = false;
    popupTouched = false;
    editingPopup = false;
    typeTouched = false;
    $('#editing').hidden = true;
    defaultExpiry();
    syncCompose();
  }
  $('#cancel-edit').onclick = resetCompose;
  $('#active').addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    const a = (state.alerts ?? []).find((x: any) => x.id === (b.dataset.edit ?? b.dataset.end));
    if (!a) return;
    if (b.dataset.edit) {
      el.type.value = a.type; el.message.value = a.message; el.link.value = a.link ?? ''; el.expires.value = local(new Date(a.expires));
      el.group.value = a.group ?? ''; el.sitewide.checked = Boolean(a.sitewide); sitewideTouched = true;
      el.popup.checked = Boolean(a.popup); popupTouched = true; editingPopup = Boolean(a.popup); el.showAgain.checked = false;
      const preset = ALERT_PRESETS.includes(a.label);
      el.label.value = preset ? a.label : 'custom'; el.customLabel.value = preset ? '' : (a.label ?? ''); typeTouched = true;
      editing = a.id; expTouched = true; $('#editing').hidden = false; syncCompose();
      el.message.focus();
      return;
    }
    if (!(await ask('End this alert now?', 'It disappears from every page right away.', 'End alert'))) return;
    save(async () => { await call('DELETE', `/alerts/${encodeURIComponent(a.id)}`); state.alerts = state.alerts.filter((x: any) => x !== a); renderAlerts(); }, 'Alert ended.');
  });
  const alertBody = () => ({ type: el.type.value, label: chosenLabel(), message: el.message.value, link: el.link.value.trim(), expires: new Date(el.expires.value).toISOString(),
    group: el.group.value || undefined, sitewide: el.group.value ? el.sitewide.checked : undefined,
    popup: !$('#popup-row').hidden && el.popup.checked, showAgain: el.showAgain.checked });
  const linkOk = (v: string) => { if (!v || /^\/(?!\/)/.test(v)) return true; try { return /^https?:$/.test(new URL(v).protocol); } catch { return false; } };
  function checkCompose() {
    const err = $('#compose-err');
    const msg = el.label.value === 'custom' && !el.customLabel.value.trim() ? 'Write your own type, or pick one from the list.' : !el.message.value.trim() ? 'Write a message.' : !el.expires.value || new Date(el.expires.value) <= new Date() ? 'Choose an end time in the future.' : !linkOk(el.link.value.trim()) ? 'Enter a full link starting with https://, or a page on this site starting with /' : el.email.checked && el.group.value && !emailTopics().length ? 'Choose who gets the email.' : '';
    err.textContent = msg ? `⚠ ${msg}` : '';
    err.hidden = !msg;
    return !msg;
  }
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!checkCompose()) return;
    const body = { ...alertBody(), email: el.email.checked, topics: el.email.checked ? emailTopics() : undefined, replaces: editing || undefined };
    if (body.email) {
      let count: number;
      try { ({ count } = await call('GET', `/recipients?type=${body.type}&group=${encodeURIComponent(body.group ?? '')}&topics=${encodeURIComponent(body.topics.join(','))}`)); }
      catch { return fail(undefined, 'Couldn’t count subscribers. Try again.'); }
      if (!(await ask(`Post and email ${count} ${count === 1 ? 'person' : 'people'}?`, `${body.group ? 'Each person gets it once, whichever lists they are on.' : `They’re on “${TOPIC[body.type]}”.`} Emails can’t be unsent.`, 'Post and email'))) return;
    }
    try {
      const { alert, recipients } = await call('POST', '/alerts', body);
      state.alerts = [...(state.alerts ?? []).filter((x: any) => x.id !== editing), alert];
      renderAlerts(); resetCompose();
      toast(recipients === undefined ? 'Alert posted. It’s live on every page.' : `Alert posted. Emailing ${recipients} ${recipients === 1 ? 'person' : 'people'}…`);
    } catch (e: any) {
      if (e.data?.alert) { // posted, but the email could not be queued
        state.alerts = [...(state.alerts ?? []).filter((x: any) => x.id !== editing), e.data.alert];
        renderAlerts(); resetCompose();
        return fail(undefined, 'The alert is on the site, but the email wasn’t sent. Send it from the Email tab.');
      }
      if (e.status !== 401) fail(() => f.requestSubmit());
    }
  });
  // The test goes through the email module, so it looks exactly like the real email.
  $('#test-btn').onclick = async () => {
    if (!checkCompose()) return;
    const a = alertBody();
    try { const { to } = await call('POST', '/email/test', { subject: a.message.slice(0, 90), body: `${a.message}${a.link ? `\n\n[Learn more →](${a.link})` : ''}` }); toast(`Test sent to ${to}.`); }
    catch (e: any) { if (e.status !== 401) fail(undefined, 'Couldn’t send the test. Check the email settings and try again.'); }
  };

  // ---------- videos & podcast (feed items + items added here) ----------
  let kind: 'video' | 'podcast' = 'video';
  const pending = new Map<string, Blob>();
  const overrides = () => (kind === 'video' ? (state.videos ??= {}) : (state.podcast ??= {}));
  const addedKey = () => (kind === 'video' ? 'videos' : 'episodes');
  const addedList = (): any[] => ((state.added ??= {})[addedKey()] ??= []);
  const AUDIO_ERR: Record<string, string> = { audio: 'That file isn’t an MP3. Choose an .mp3 file.', too_large: 'That file is over 200 MB.', title: 'Give it a title.', date: 'Choose a date.', id: 'That isn’t a YouTube video.' };
  function addedRow(x: any) {
    const ep = kind === 'podcast';
    return `<li class="card item${ep ? ' no-thumb' : ''}" data-added="${esc(x.id)}">`
      + (ep ? '' : `<img class="ithumb" src="https://i.ytimg.com/vi/${esc(x.id)}/hqdefault.jpg" alt="" width="120" height="68" loading="lazy">`)
      + `<div class="ifields"><p><span class="chip-imp">Added here</span></p>`
      + `<label>Title <input name="title" maxlength="120" value="${esc(x.title)}"></label>`
      + `<label>Date <input name="date" type="date" value="${esc(x.date)}"></label>`
      + (ep ? `<label>Description (optional) <textarea name="about" rows="3" maxlength="600">${esc(x.about)}</textarea></label><p class="hint">Audio: ${x.audio.startsWith('/api/audio/') ? 'an uploaded MP3' : esc(x.audio)}</p>` : '')
      + '<div class="btn-row">'
      + (ep ? '<label class="btn btn-sm btn-outline file">Replace audio<input type="file" accept="audio/mpeg,.mp3" class="sr-only" data-replace></label>' : '')
      + '<button type="button" class="link remove-added">Remove</button></div>'
      + '<progress max="100" value="0" hidden></progress>'
      + '<p class="dirty" hidden><span>Unsaved changes</span> <button type="button" class="btn btn-sm save-added">Save</button></p></div></li>';
  }
  function renderItems() {
    $('#add-video').hidden = kind !== 'video';
    $('#add-episode').hidden = kind !== 'podcast';
    const feed = ITEMS[kind];
    const added = [...addedList()].sort((a, b) => b.date.localeCompare(a.date));
    const map = overrides();
    const rows = feed.map((it: any) => {
      const o = map[it.id] ?? {};
      const shown = applyOverride(it, o);
      return `<li class="card item${kind === 'podcast' ? ' no-thumb' : ''}" data-id="${esc(it.id)}">`
        + (kind === 'video' ? `<img class="ithumb" src="${esc(shown.thumb)}" alt="" width="120" height="68" loading="lazy">` : '')
        + `<div class="ifields"><p><span class="chip-imp">${kind === 'video' ? 'From YouTube' : 'From the podcast feed'}</span> <span class="hint">${esc(it.date)}</span></p><label>Title <input name="title" maxlength="120" value="${esc(shown.title)}"></label><p class="hint">Original: ${esc(it.title)}</p>`
        + '<div class="btn-row">'
        + (kind === 'video' ? '<label class="btn btn-sm btn-outline file">Change thumbnail<input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only"></label>' : '')
        + `${o.title || o.thumb ? '<button type="button" class="link reset">Reset to original</button>' : ''}</div>`
        + (kind === 'video' ? '<p class="hint">JPG, PNG or WebP up to 5 MB. 1280×720 works best.</p>' : '')
        + '<p class="dirty" hidden><span>Unsaved changes</span> <button type="button" class="btn btn-sm save">Save</button></p></div></li>';
    });
    $('#item-list').innerHTML = added.length || rows.length ? added.map(addedRow).join('') + rows.join('')
      : `<li class="a-muted">${kind === 'video' ? 'No videos yet. New YouTube uploads appear here automatically.' : 'No podcast episodes found.'}</li>`;
  }
  document.querySelectorAll<HTMLButtonElement>('#items [data-kind]').forEach((b) => (b.onclick = () => {
    kind = b.dataset.kind as typeof kind;
    document.querySelectorAll('#items [data-kind]').forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
    pending.clear();
    renderItems();
  }));

  /** Streams an MP3 to the server (XHR, for upload progress). Resolves to its /api/audio/… address. */
  function uploadMp3(file: File, onProgress: (pct: number) => void): Promise<string> {
    return new Promise((res, rej) => {
      const x = new XMLHttpRequest();
      x.open('POST', `${API}/audio`);
      x.setRequestHeader('Content-Type', 'audio/mpeg');
      x.upload.onprogress = (e) => { if (e.lengthComputable) onProgress(Math.round((e.loaded / e.total) * 100)); };
      x.onload = () => {
        let j: any = {};
        try { j = JSON.parse(x.responseText); } catch {}
        if (x.status === 200) res(j.audio);
        else rej(Object.assign(new Error(j.error || 'upload'), { status: x.status, data: j }));
      };
      x.onerror = () => rej(new Error('network'));
      x.send(file);
    });
  }
  const okMp3 = (f: File) => (f.type === 'audio/mpeg' || /\.mp3$/i.test(f.name)) && f.size <= 200 * 1024 * 1024;

  // Add a video: paste a YouTube link, the server looks it up, then title and date can be edited.
  $('#add-video').onclick = () => {
    if ($('#video-form')) return $<HTMLInputElement>('#yt-url').focus();
    $('#item-list').insertAdjacentHTML('afterbegin', `<li class="card form add-form" id="video-form"><h2 class="a-h2">Add a video</h2>
      <label>YouTube link <input id="yt-url" type="url" inputmode="url" autocapitalize="off" spellcheck="false" aria-describedby="yt-help"></label>
      <p class="hint" id="yt-help">Paste the link from YouTube’s Share button.</p>
      <p class="hint" id="yt-status" role="status"></p>
      <div class="item" id="yt-found" hidden><img class="ithumb" alt="" width="120" height="68"><div class="ifields">
        <label>Title <input name="title" maxlength="120"></label><label>Date <input name="date" type="date"></label></div></div>
      <div class="btn-row"><button type="button" class="btn" id="yt-add" disabled>Add video</button><button type="button" class="btn btn-outline" data-cancel>Cancel</button></div></li>`);
    const input = $<HTMLInputElement>('#yt-url');
    let looked = '';
    const lookup = async () => {
      const v = input.value.trim();
      if (!v || v === looked) return;
      looked = v;
      const status = $('#yt-status');
      $('#yt-found').hidden = true;
      ($('#yt-add') as HTMLButtonElement).disabled = true;
      status.textContent = 'Looking up the video…';
      try {
        const r = await call('GET', `/youtube?url=${encodeURIComponent(v)}`);
        if (ITEMS.video.some((x: any) => x.id === r.id) || (state.added?.videos ?? []).some((x: any) => x.id === r.id)) {
          status.innerHTML = `That video is already on the site. <button type="button" class="link" data-show="${esc(r.id)}">Show it</button>`;
          return;
        }
        status.textContent = '';
        const found = $('#yt-found');
        found.dataset.id = r.id;
        $<HTMLImageElement>('img', found).src = r.thumb;
        $<HTMLInputElement>('[name=title]', found).value = r.title;
        $<HTMLInputElement>('[name=date]', found).value = r.published ?? etDay(new Date());
        found.hidden = false;
        ($('#yt-add') as HTMLButtonElement).disabled = false;
      } catch (x: any) {
        if (x.status !== 401) status.textContent = 'We couldn’t find that video. Check the link, or that the video is public.';
      }
    };
    input.addEventListener('change', lookup);
    input.addEventListener('blur', lookup);
    input.addEventListener('paste', () => setTimeout(lookup, 0));
    input.focus();
  };
  // Add a podcast episode: an uploaded MP3 or an https link.
  $('#add-episode').onclick = () => {
    if ($('#ep-form')) return $<HTMLInputElement>('#ep-form [name=title]').focus();
    $('#item-list').insertAdjacentHTML('afterbegin', `<li class="card form add-form" id="ep-form"><h2 class="a-h2">Add a podcast episode</h2>
      <label>Title <input name="title" required maxlength="120"></label>
      <label>Date <input name="date" type="date" required value="${etDay(new Date())}"></label>
      <label>Description (optional) <textarea name="about" rows="3" maxlength="600"></textarea></label>
      <fieldset class="types"><legend>Audio</legend>
        <label class="type-card"><input type="radio" name="src" value="upload" checked> Upload an MP3</label>
        <label class="type-card"><input type="radio" name="src" value="link"> Link to an MP3</label></fieldset>
      <label data-src="upload">MP3 file <input type="file" name="file" accept="audio/mpeg,.mp3" aria-describedby="ep-file-help"></label>
      <p class="hint" data-src="upload" id="ep-file-help">Up to 200 MB.</p>
      <label data-src="link" hidden>Link to the MP3 <input name="link" type="url" inputmode="url" placeholder="https://" autocapitalize="off" spellcheck="false"></label>
      <progress max="100" value="0" hidden></progress><p class="hint" id="ep-progress" role="status"></p>
      <p class="err" role="alert" hidden></p>
      <div class="btn-row"><button type="button" class="btn" id="ep-add">Add episode</button><button type="button" class="btn btn-outline" data-cancel>Cancel</button></div></li>`);
    $<HTMLInputElement>('#ep-form [name=title]').focus();
  };
  // Resize in the browser (centre crop), so uploads stay small: 1280×720 for video cards, 600×600 for team photos.
  async function toThumb(file: File, w = 1280, h = 720): Promise<Blob> {
    const img = await createImageBitmap(file);
    const c = Object.assign(document.createElement('canvas'), { width: w, height: h });
    const s = Math.max(w / img.width, h / img.height);
    c.getContext('2d')!.drawImage(img, (w - img.width * s) / 2, (h - img.height * s) / 2, img.width * s, img.height * s);
    return new Promise((res, rej) => c.toBlob((b) => (b ? res(b) : rej(new Error('encode'))), 'image/jpeg', 0.85));
  }
  const list = $('#item-list');
  const rowOf = (t: EventTarget | null) => (t as HTMLElement).closest<HTMLElement>('.item, .add-form')!;
  const dirty = (row: HTMLElement) => { const d = row.querySelector<HTMLElement>('.dirty'); if (d) d.hidden = false; };
  const field = (row: HTMLElement, n: string) => $<HTMLInputElement>(`[name=${n}]`, row);
  list.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    const row = rowOf(t);
    if (row?.classList.contains('item') && ['title', 'date', 'about'].includes(t.name)) dirty(row);
  });
  list.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const row = rowOf(input);
    if (input.name === 'src') { row.querySelectorAll<HTMLElement>('[data-src]').forEach((x) => (x.hidden = x.dataset.src !== input.value)); return; }
    if (input.type !== 'file' || !input.files?.[0] || input.name === 'file') return;
    const file = input.files[0];
    if (input.hasAttribute('data-replace')) { // replace an added episode's audio
      if (!okMp3(file)) return fail(undefined, AUDIO_ERR.audio);
      const id = row.dataset.added!;
      const bar = $<HTMLProgressElement>('progress', row);
      bar.hidden = false;
      try {
        const audio = await uploadMp3(file, (n) => (bar.value = n));
        const old = addedList().find((x) => x.id === id);
        const { item } = await call('PUT', `/added/episode/${encodeURIComponent(id)}`, { ...old, audio });
        Object.assign(old, item);
        toast('Audio replaced.');
        renderItems();
      } catch (x: any) { if (x.status !== 401) fail(undefined, AUDIO_ERR[x.data?.error] ?? 'Couldn’t upload it. Try again.'); }
      finally { bar.hidden = true; }
      return;
    }
    if (file.size > 5 * 1024 * 1024 || !/^image\/(jpeg|png|webp)$/.test(file.type)) return fail(undefined, 'Choose a JPG, PNG or WebP image up to 5 MB.');
    try {
      const blob = await toThumb(file);
      pending.set(row.dataset.id!, blob);
      $<HTMLImageElement>('.ithumb', row).src = URL.createObjectURL(blob);
      dirty(row);
    } catch { fail(undefined, 'That image couldn’t be read. Try another file.'); }
  });
  list.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (t.matches('[data-cancel]')) { rowOf(t).remove(); return $<HTMLButtonElement>(kind === 'video' ? '#add-video' : '#add-episode').focus(); }
    if (t.matches('[data-show]')) {
      $('#video-form')?.remove();
      const row = list.querySelector<HTMLElement>(`[data-id="${t.dataset.show}"], [data-added="${t.dataset.show}"]`);
      row?.scrollIntoView({ block: 'center' });
      return $<HTMLInputElement>('[name=title]', row!)?.focus();
    }
    if (t.id === 'yt-add') {
      const found = $('#yt-found');
      const body = { id: found.dataset.id, title: field(found, 'title').value, date: field(found, 'date').value };
      return save(async () => { const { item } = await call('POST', '/added/video', body); state.added.videos = [item, ...(state.added.videos ?? []).filter((x: any) => x.id !== item.id)]; renderItems(); }, 'Video added. It’s on the Watch page.');
    }
    if (t.id === 'ep-add') {
      const row = $('#ep-form');
      const err = $('.err', row);
      const show = (k: string) => { err.textContent = `⚠ ${AUDIO_ERR[k] ?? 'Couldn’t add it. Try again.'}`; err.hidden = false; };
      err.hidden = true;
      const title = field(row, 'title').value.trim();
      const date = field(row, 'date').value;
      if (!title) return show('title');
      if (!date) return show('date');
      let audio = '';
      try {
        if ((row.querySelector<HTMLInputElement>('[name=src]:checked')!).value === 'upload') {
          const file = field(row, 'file').files?.[0];
          if (!file || !okMp3(file)) return show(file && file.size > 200 * 1024 * 1024 ? 'too_large' : 'audio');
          const bar = $<HTMLProgressElement>('progress', row);
          bar.hidden = false;
          audio = await uploadMp3(file, (n) => { bar.value = n; $('#ep-progress').textContent = `Uploading… ${n}%`; });
          $('#ep-progress').textContent = '';
        } else {
          audio = field(row, 'link').value.trim();
          if (!/^https:\/\//.test(audio)) { err.textContent = '⚠ Enter a link that starts with https://'; err.hidden = false; return; }
        }
        const { item } = await call('POST', '/added/episode', { title, date, about: field(row, 'about').value, audio });
        state.added.episodes = [item, ...(state.added.episodes ?? [])];
        renderItems();
        toast('Episode added. It’s on the Podcast page.');
      } catch (x: any) { if (x.status !== 401) show(x.data?.error); }
      return;
    }
    if (t.matches('.save-added, .remove-added')) {
      const row = rowOf(t);
      const id = row.dataset.added!;
      const ep = kind === 'podcast';
      const path = `/added/${ep ? 'episode' : 'video'}/${encodeURIComponent(id)}`;
      if (t.matches('.remove-added')) {
        if (!(await (ep ? ask('Remove this episode?', 'The uploaded audio is deleted.', 'Remove episode') : ask('Remove this video from the website?', 'It stays on YouTube.', 'Remove video')))) return;
        return save(async () => { await call('DELETE', path); state.added[addedKey()] = addedList().filter((x) => x.id !== id); renderItems(); }, ep ? 'Episode removed.' : 'Video removed.');
      }
      const old = addedList().find((x) => x.id === id);
      const body = { ...old, title: field(row, 'title').value, date: field(row, 'date').value, ...(ep ? { about: field(row, 'about').value } : {}) };
      return save(async () => { const { item } = await call('PUT', path, body); Object.assign(old, item); renderItems(); }, 'Saved.');
    }
    if (!t.matches('.save, .reset')) return;
    const row = rowOf(t);
    const id = row.dataset.id!;
    const orig = ITEMS[kind].find((x: any) => x.id === id);
    const path = `/items/${kind}/${encodeURIComponent(id)}`;
    if (t.matches('.reset')) {
      if (!(await ask('Reset to the original title and thumbnail?', 'The YouTube or podcast feed version shows again.', 'Reset'))) return;
      return save(async () => { await call('DELETE', path); delete overrides()[id]; pending.delete(id); renderItems(); }, 'Saved.');
    }
    const title = $<HTMLInputElement>('[name=title]', row).value.trim();
    save(async () => {
      const blob = pending.get(id);
      if (blob) { const { item } = await call('POST', `/thumb/${id}`, undefined, blob); overrides()[id] = item; pending.delete(id); }
      const { item } = await call('PUT', path, { title: title === orig.title ? '' : title });
      if (item) overrides()[id] = item; else delete overrides()[id];
      renderItems();
