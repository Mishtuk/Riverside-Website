    const file = input.files[0];
    if (file.size > 5 * 1024 * 1024 || !/^image\/(jpeg|png|webp)$/.test(file.type)) return fail(undefined, 'Choose a JPG, PNG or WebP image up to 5 MB.');
    try {
      const blob = await toThumb(file);
      pending.set(row.dataset.id!, blob);
      $<HTMLImageElement>('.ithumb', row).src = URL.createObjectURL(blob);
