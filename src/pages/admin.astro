  // ---------- groups ----------
  // One collapsible card per group (closed by default). The form saves the group; "Post update" publishes a news
  // post on its own, so the group's other unsaved edits stay as they are.
  const TYPE_LABEL = Object.fromEntries(GROUP_TYPES) as Record<string, string>;
  const nextDay = (day: number) => { // the group's meeting day this week (ET), for a one-tap "Not meeting"
    const today = etDay(new Date());
    const d = new Date(`${today}T12:00:00Z`);
    if (day !== VARIES) d.setUTCDate(d.getUTCDate() + ((day - d.getUTCDay() + 7) % 7));
    return d.toISOString().slice(0, 10);
  };
  const short = (iso: string, o: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' }) => new Date(iso).toLocaleDateString('en-US', { ...o, timeZone: TZ });
  const updated = (iso?: string) => (iso ? `Updated ${short(iso)}` : 'Not saved yet');
  const eventRow = (e: any, place = '') => `<fieldset class="ev" data-id="${esc(e.id ?? crypto.randomUUID())}"><legend class="sr-only">Event</legend>
      <label>Event title <input data-f="title" required maxlength="80" value="${esc(e.title)}"></label>
      <div class="two"><label>Date <input type="date" data-f="date" required min="${etDay(new Date())}" value="${esc(e.date)}"></label>
      <label>Starts <input type="time" data-f="start" required value="${esc(e.start)}"></label></div>
      <div class="two"><label>Ends (optional) <input type="time" data-f="end" value="${esc(e.end)}"></label>
      <label>Place <input data-f="place" maxlength="80" value="${esc(e.place)}" placeholder="${esc(place || 'Same as the group')}"></label></div>
      <label>Note (optional) <input data-f="note" maxlength="140" value="${esc(e.note)}"></label>
      <p><button type="button" class="link ev-remove">Remove event</button></p>
    </fieldset>`;
  const summary = (g: any) => {
    const s = groupStatus(g, new Date());
    const alertOn = activeAlerts(state.alerts).some((a: any) => a.group === g.id);
    return `<span class="gname">${esc(g.name || 'New group')}</span><span class="gmeta"><span class="chip-status is-${s.kind}">${s.label}</span><span>${esc(TYPE_LABEL[g.type] ?? TYPE_LABEL.other)}</span>${alertOn ? "<span><strong>Alert on</strong></span>" : ""}<span class="hint">${updated(g.updated)}</span></span>`;
  };
  const newsList = (g: any) => {
    const news = g.news ?? [];
    const warn = news.length >= MAX_NEWS ? ` This group has ${MAX_NEWS} updates, so posting another removes the oldest.` : '';
    return `<p class="hint" id="nh-${esc(g.id)}">Plain text. Leave a blank line between paragraphs. Links work as-is.${warn}</p>`
      + `<p><button type="button" class="btn btn-sm post-news">Post update</button></p>`
      + (news.length ? `<ul class="news-list" role="list">${news.map((n: any) => `<li data-nid="${esc(n.id)}"><p class="hint">${short(n.date, { weekday: 'short', month: 'short', day: 'numeric' })}</p><p><strong>${esc(n.title)}</strong></p>${n.body ? `<p class="hint">${esc(n.body.split('\n')[0])}</p>` : ''}<p><button type="button" class="link del-news">Delete</button></p></li>`).join('')}</ul>` : '<p class="hint">No updates yet.</p>');
  };
  function groupCard(g: any, open = false) {
    const k = g.status?.kind ?? 'meeting';
    const d = g.status?.date;
    const r = (v: string) => `name="kind" value="${v}"${k === v ? ' checked' : ''}`;
    const id = esc(g.id ?? '');
    const hid = esc(g.id ?? 'new');
    return `<details class="card gcard" data-id="${id}"${open ? ' open' : ''}><summary>${summary(g)}</summary><form class="form gform">
      <label>Name <input name="name" required maxlength="80" value="${esc(g.name)}"></label>
      <label>Type <select name="type" required>${GROUP_TYPES.map(([key, label]) => `<option value="${key}"${(g.type ?? 'other') === key ? ' selected' : ''}>${label}</option>`).join('')}</select></label>
      <div class="two"><label>Day <select name="day">${[...DAYS, 'Day varies'].map((n, i) => `<option value="${i}"${+g.day === i ? ' selected' : ''}>${n}</option>`).join('')}</select></label>
      <label>Time <input name="time" maxlength="60" value="${esc(g.time)}" aria-describedby="h-${hid}"></label></div>
      <label>Place <input name="place" maxlength="80" value="${esc(g.place)}" aria-describedby="h-${hid}"></label>
      <p class="hint" id="h-${hid}">Leave time or place blank to show “Contact us”.</p>
      <label>Contact (optional) <input name="contact" maxlength="80" value="${esc(g.contact)}" placeholder="Name, phone or email"></label>
      <label>Short description (optional) <textarea name="about" rows="2" maxlength="200">${esc(g.about)}</textarea></label>
      <label>Note (optional) <input name="note" maxlength="140" value="${esc(g.note)}" placeholder="Off for Thanksgiving"></label>
      <fieldset class="week"><legend>This week</legend>
        <label class="check"><input type="radio" ${r('meeting')}> Meeting as usual</label>
        <label class="check"><input type="radio" ${r('off')}> Not meeting on <input type="date" name="off" aria-label="Date not meeting" value="${k === 'off' ? d : nextDay(+g.day)}"></label>
        <label class="check"><input type="radio" ${r('break')}> On break until <input type="date" name="break" aria-label="Back on" value="${k === 'break' ? d : ''}"></label>
      </fieldset>
      <fieldset class="events"><legend>Events</legend>
        <p class="hint">One-off dates, like a picnic or a special study night. They drop off the board after their date.</p>
        <div class="ev-list">${[...(g.events ?? [])].sort((a: any, b: any) => a.date.localeCompare(b.date)).map((e: any) => eventRow(e, g.place)).join('')}</div>
        <p><button type="button" class="btn btn-sm btn-outline ev-add">Add an event</button></p>
      </fieldset>
      <fieldset class="news"><legend>Updates</legend>
        ${g.id ? `<label>Title <input data-n="title" maxlength="80"></label>
        <label>Message <textarea data-n="body" rows="4" maxlength="600" aria-describedby="nh-${hid}"></textarea></label>
        <div class="news-box">${newsList(g)}</div>` : '<p class="hint">Save the group first, then you can post updates.</p>'}
      </fieldset>
      <div class="btn-row"><button class="btn btn-sm" type="submit">Save</button>${g.id ? '<button class="btn btn-sm btn-outline group-alert" type="button">Post a meeting alert</button>' : ''}<button class="link remove" type="button">Remove</button></div>
    </form></details>`;
  }
  function renderGroups(openId = '') {
    const gs = state.groups ?? [];
    const keep = el.group.value;
    el.group.innerHTML = '<option value="">None</option>' + gs.map((g: any) => `<option value="${esc(g.id)}">${esc(g.name)}</option>`).join('');
    el.group.value = gs.some((g: any) => g.id === keep) ? keep : '';
    $('#group-list').innerHTML = gs.length ? gs.map((g: any) => groupCard(g, g.id === openId)).join('') : '<p class="muted" id="no-groups">No groups yet. Add the first one and it appears on the Groups page.</p>';
  }
  const cardOf = (t: Element) => t.closest<HTMLElement>('.gcard')!;
  const groupOf = (card: HTMLElement) => (state.groups ?? []).find((x: any) => x.id === card.dataset.id);
  async function putGroups(gs: any[], openId = '') {
    const before = new Set((state.groups ?? []).map((x: any) => x.id));
    const r = await call('PUT', '/groups', gs);
    state.groups = r.groups;
    state.alerts = r.alerts; // removing a group removes its alerts
    renderAlerts();
    renderGroups(openId || state.groups.find((x: any) => !before.has(x.id))?.id || '');
  }
  $('#add-group').onclick = () => {
    $('#no-groups')?.remove();
    $('#group-list').insertAdjacentHTML('afterbegin', groupCard({ name: '', type: 'other', day: 0, time: '', place: '', note: '' }, true));
    $<HTMLInputElement>('#group-list [name=name]').focus();
  };
  $('#group-list').addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const card = cardOf(form);
    const v = form.elements as any;
    const kindV = v.kind.value;
    const date = kindV === 'off' ? v.off.value : kindV === 'break' ? v.break.value : undefined;
    if (!form.reportValidity()) return;
    if (kindV !== 'meeting' && !date) return (kindV === 'off' ? v.off : v.break).focus();
    const events = [...form.querySelectorAll<HTMLElement>('.ev')].map((row) => {
      const f = (k: string) => $<HTMLInputElement>(`[data-f=${k}]`, row).value.trim();
      return { id: row.dataset.id, title: f('title'), date: f('date'), start: f('start'), end: f('end'), place: f('place'), note: f('note') };
    });
    const bad = events.find((x) => x.end && x.end <= x.start);
    if (bad) return fail(undefined, `“${bad.title}” ends before it starts. Check the times.`);
    const id = card.dataset.id || undefined;
    const g = { id, type: v.type.value, name: v.name.value, day: +v.day.value, time: v.time.value, place: v.place.value, contact: v.contact.value, about: v.about.value, note: v.note.value, status: { kind: kindV, date }, events };
    const gs = state.groups ?? [];
    const next = id && gs.some((x: any) => x.id === id) ? gs.map((x: any) => (x.id === id ? g : x)) : [g, ...gs];
    save(() => putGroups(next, id), 'Saved.');
  });
  $('#group-list').addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const form = t.closest('form');
    if (!form) return;
    const card = cardOf(form);
    if (t.matches('.ev-add')) {
      $('.ev-list', form).insertAdjacentHTML('beforeend', eventRow({}, (form.elements as any).place.value));
      return $<HTMLInputElement>('.ev:last-child [data-f=title]', form).focus();
    }
    if (t.matches('.ev-remove')) { // removed for good when the group is saved
      const row = t.closest('.ev')!;
      const next = (row.nextElementSibling ?? row.previousElementSibling)?.querySelector<HTMLElement>('[data-f=title]');
      row.remove();
      return (next ?? $('.ev-add', form)).focus();
    }
    if (t.matches('.post-news')) {
      const title = $<HTMLInputElement>('[data-n=title]', form);
      const body = $<HTMLTextAreaElement>('[data-n=body]', form);
      if (!title.value.trim()) { fail(undefined, 'Give the update a title.'); return title.focus(); }
      return save(async () => {
        const { group } = await call('POST', `/groups/${encodeURIComponent(card.dataset.id!)}/news`, { title: title.value, body: body.value });
        Object.assign(groupOf(card), { news: group.news, updated: group.updated });
        title.value = ''; body.value = '';
        $('.news-box', form).innerHTML = newsList(group);
        $('summary', card).innerHTML = summary(groupOf(card));
      }, 'Update posted. It’s on the Groups page.');
    }
    if (t.matches('.del-news')) {
      const nid = t.closest<HTMLElement>('[data-nid]')!.dataset.nid!;
      if (!(await ask('Delete this update?', 'It disappears from the Groups page.', 'Delete update'))) return;
      return save(async () => {
        const { group } = await call('DELETE', `/groups/${encodeURIComponent(card.dataset.id!)}/news/${encodeURIComponent(nid)}`);
        Object.assign(groupOf(card), { news: group.news, updated: group.updated });
        $('.news-box', form).innerHTML = newsList(group);
        $<HTMLButtonElement>('.post-news', form).focus();
      }, 'Update deleted.');
    }
    if (t.matches('.group-alert')) {
      resetCompose();
      el.group.value = card.dataset.id; el.type.value = 'urgent';
      syncCompose();
      go('alerts');
      return el.message.focus({ preventScroll: true });
    }
    if (!t.matches('.remove')) return;
    const name = (form.elements as any).name.value || 'this group';
    if (!(await ask(`Remove ${name} from the board?`, 'This can’t be undone.', 'Remove group'))) return;
    if (!card.dataset.id) { card.remove(); return toast('Group removed.'); } // never saved
    save(() => putGroups((state.groups ?? []).filter((x: any) => x.id !== card.dataset.id)), 'Group removed.');
  });

  // ---------- staff accounts ----------
  const when = (ms: number) => new Date(ms).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: TZ }).replace(/\s([AP]M)/, (m) => m.trim().toLowerCase());
  async function renderStaff() {
    const r = await call('GET', '/staff');
    $('#own-pw').hidden = r.kind !== 'password';
    $('#accounts').innerHTML = r.accounts.map((a: any) => `<li><p><strong>${esc(a.username)}</strong>${a.username === r.me ? ' (you)' : ''}</p>`
      + `<p class="hint">${a.defaultPassword ? 'Default password: change it before launch' : a.mustChange ? 'Waiting for a new password' : `Password set ${when(a.updated)}`}</p>`
      + (a.username !== r.me ? `<div class="btn-row"><button type="button" class="btn btn-sm btn-outline reset-staff" data-u="${esc(a.username)}" aria-expanded="false">Reset password</button>`
        + (r.accounts.length > 1 ? `<button type="button" class="link del-staff" data-u="${esc(a.username)}">Remove</button>` : '') + '</div>'
        + `<form class="form reset-form" data-u="${esc(a.username)}" hidden novalidate><label>Temporary password for ${esc(a.username)} <input name="password" type="text" required minlength="12" autocomplete="off" spellcheck="false"></label>`
        + '<p class="hint">At least 12 characters. Give it to them in person or by phone. They must choose their own the next time they sign in.</p><p class="err" role="alert" hidden></p>'
        + '<p><button class="btn btn-sm" type="submit">Set temporary password</button></p></form>' : '') + '</li>').join('');
    $('#logins').innerHTML = r.logins.length ? r.logins.map((l: any) => `<li><p><strong>${esc(l.who)}</strong> · ${when(l.at)}</p><p class="hint">${l.method === 'link' ? 'Email link' : 'Password'} · ${esc(l.ip)}</p></li>`).join('') : '<li class="hint">No sign-ins yet.</li>';
    $('#default-warning').hidden = !r.accounts.some((a: any) => a.defaultPassword);
    renderPerms(r);
  }
  const op = $<HTMLFormElement>('#own-pw');
  op.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = op.elements as any;
    if (v.password.value.length < 12) return showErr('#own-err', PW_ERR.too_short);
    if (v.password.value !== v.again.value) return showErr('#own-err', 'The two passwords don’t match.');
    try { await call('POST', '/password', { current: v.current.value, password: v.password.value }); op.reset(); showErr('#own-err', ''); toast('Password changed.'); renderStaff(); }
    catch (err: any) { if (err.status !== 401) showErr('#own-err', PW_ERR[err.data?.error] ?? 'Couldn’t save. Try again.'); }
  });
  $('#accounts').addEventListener('submit', async (e) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('.reset-form');
    if (!form) return;
    e.preventDefault();
    const u = form.dataset.u!;
    const pw = (form.elements as any).password.value;
    const err = $('.err', form);
    if (pw.length < 12) { err.textContent = `⚠ ${PW_ERR.too_short}`; err.hidden = false; return; }
    if (!(await ask(`Reset the password for ${u}?`, 'They are signed out everywhere and must choose a new password the next time they sign in.', 'Reset password'))) return;
    try { await call('POST', `/staff/${encodeURIComponent(u)}/reset`, { password: pw }); toast(`Password reset. Give ${u} the temporary password.`); renderStaff(); }
    catch (x: any) { if (x.status !== 401) { err.textContent = `⚠ ${PW_ERR[x.data?.error] ?? 'Couldn’t reset it. Try again.'}`; err.hidden = false; } }
  });
  const as = $<HTMLFormElement>('#add-staff');
  as.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = as.elements as any;
    const role = (as.querySelector<HTMLInputElement>('[name=role]:checked')!).value;
    const areas = [...as.querySelectorAll<HTMLInputElement>('[name=areas]:checked')].map((b) => b.value);
    try { await call('POST', '/staff', { username: v.username.value, password: v.password.value, role, areas }); as.reset(); showErr('#add-err', ''); toast('Account added. They must choose a new password when they sign in.'); renderStaff(); }
    catch (err: any) { if (err.status !== 401) showErr('#add-err', PW_ERR[err.data?.error] ?? 'Couldn’t save. Try again.'); }
  });
  $('#accounts').addEventListener('click', async (e) => {
    const rb = (e.target as HTMLElement).closest<HTMLButtonElement>('.reset-staff');
    if (rb) { // show / hide that account's reset form
      const form = rb.closest('li')!.querySelector<HTMLFormElement>('.reset-form')!;
      form.hidden = !form.hidden;
      rb.setAttribute('aria-expanded', String(!form.hidden));
      if (!form.hidden) (form.elements as any).password.focus();
      return;
    }
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.del-staff');
    if (!b) return;
    if (!(await ask(`Remove ${b.dataset.u}?`, 'They can’t sign in with a password any more.', 'Remove account'))) return;
    try { await call('DELETE', `/staff/${encodeURIComponent(b.dataset.u!)}`); toast('Account removed.'); renderStaff(); }
    catch (err: any) { if (err.status !== 401) fail(undefined, PW_ERR[err.data?.error] ?? 'Couldn’t remove it. Try again.'); }
  });

  // ---------- events (church-wide) ----------
  const EV_ERR: Record<string, string> = { title: 'Give the event a title.', date: 'Choose a date.', past: 'That date has passed.', time: 'The end time must be after the start time (and needs a start time).', link: 'Enter a full link starting with https://, or a page on this site starting with /' };
  const evDate = (e: any) => [new Date(`${e.date}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' }), timeLabel(e.start, e.end).replace('&ndash;', '–')].filter(Boolean).join(' · ');
  function eventCard(e: any, open = false) {
    const id = esc(e.id ?? '');
    const hid = esc(e.id ?? 'new');
    return `<details class="card gcard" data-id="${id}"${open ? ' open' : ''}><summary><span class="gname">${esc(e.title || 'New event')}</span><span class="gmeta">${e.date ? `<span>${esc(evDate(e))}</span>` : ''}<span class="chip-imp${e.major ? ' is-major' : ''}">${e.major ? 'Major' : 'Minor'}</span></span></summary>
      <form class="form gform" novalidate>
      <label>Title <input name="title" required maxlength="80" value="${esc(e.title)}"></label>
      <div class="two"><label>Date <input type="date" name="date" required min="${etDay(new Date())}" value="${esc(e.date)}"></label>
      <label>Starts (optional) <input type="time" name="start" value="${esc(e.start)}"></label></div>
      <div class="two"><label>Ends (optional) <input type="time" name="end" value="${esc(e.end)}"></label>
      <label>Place <input name="place" maxlength="80" value="${esc(e.place)}" aria-describedby="ep-${hid}"></label></div>
      <p class="hint" id="ep-${hid}">Leave the place blank to show “Contact us”.</p>
      <label>Description (optional) <textarea name="about" rows="3" maxlength="300" aria-describedby="ea-${hid}">${esc(e.about)}</textarea></label>
      <p class="hint" id="ea-${hid}">Up to 300 characters.</p>
      <fieldset class="types"><legend>Importance</legend>
        <label class="type-card"><input type="radio" name="major" value="1"${e.major ? ' checked' : ''}> Major: shown big on the home page</label>
        <label class="type-card"><input type="radio" name="major" value="0"${e.major ? '' : ' checked'}> Minor: shown in the list</label>
      </fieldset>
      <label>Link (optional) <input name="link" type="text" inputmode="url" autocapitalize="off" spellcheck="false" placeholder="https:// or /page" value="${esc(e.link)}"></label>
      <p class="err" role="alert" hidden></p>
      <div class="btn-row"><button class="btn btn-sm" type="submit">Save</button><button class="link remove-event" type="button">Remove</button></div>
    </form></details>`;
  }
  function renderEvents(openId = '') {
    const list = state.events ?? [];
    $('#event-list').innerHTML = list.length ? list.map((e: any) => eventCard(e, e.id === openId)).join('') : '<p class="muted" id="no-events">No church events yet. Add one and it appears on the home page and Events.</p>';
  }
  $('#add-event').onclick = () => {
    $('#no-events')?.remove();
    $('#event-list').insertAdjacentHTML('afterbegin', eventCard({ title: '', date: '', major: false }, true));
    $<HTMLInputElement>('#event-list [name=title]').focus();
  };
  $('#event-list').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const card = form.closest<HTMLElement>('.gcard')!;
    const v = form.elements as any;
    const err = $('.err', form);
    const body = { title: v.title.value, date: v.date.value, start: v.start.value, end: v.end.value, place: v.place.value, about: v.about.value, major: v.major.value === '1', link: v.link.value };
    const local = !body.title.trim() ? 'title' : !body.date ? 'date' : body.end && (!body.start || body.end <= body.start) ? 'time' : '';
    if (local) { err.textContent = `⚠ ${EV_ERR[local]}`; err.hidden = false; return; }
    try {
      const r = await call('PUT', `/events/${encodeURIComponent(card.dataset.id || 'new')}`, body);
      state.events = r.events;
      renderEvents(r.event.id);
      toast('Event saved. It’s on the home page.');
    } catch (x: any) {
      if (x.status === 401) return;
      if (EV_ERR[x.data?.error]) { err.textContent = `⚠ ${EV_ERR[x.data.error]}`; err.hidden = false; } else fail(() => form.requestSubmit());
    }
  });
  $('#event-list').addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (!t.matches('.remove-event')) return;
    const card = t.closest<HTMLElement>('.gcard')!;
    const title = ($<HTMLInputElement>('[name=title]', card).value || 'this event');
    if (!(await ask(`Remove ${title}?`, 'It disappears from the home page and Events.', 'Remove event'))) return;
    if (!card.dataset.id) { card.remove(); return toast('Event removed.'); }
    save(async () => { state.events = (await call('DELETE', `/events/${encodeURIComponent(card.dataset.id!)}`)).events; renderEvents(); }, 'Event removed.');
  });

  // ---------- our team ----------
  let team: any[] = [];
  const teamDirty = (on = true) => ($('#team-dirty').hidden = !on);
  function renderTeam() {
    call('GET', '/team').then((r) => { team = r.team; drawTeam(); }).catch(() => {});
  }
  function drawTeam() {
    $('#team-list').innerHTML = team.map((m, i) => `<li class="card item member-row" data-i="${i}">`
      + (m.photo ? `<img class="team-photo" src="${esc(m.photo)}" alt="" width="96" height="96">` : '<span class="team-photo" aria-hidden="true"></span>')
      + `<div class="ifields"><p class="hint">${i === 0 ? 'Featured first' : `Position ${i + 1}`}</p>`
      + `<label>Name <input data-k="name" required maxlength="80" value="${esc(m.name)}"></label>`
      + `<label>Role <input data-k="role" maxlength="80" value="${esc(m.role)}" placeholder="Elder"></label>`
      + `<label>Short bio <textarea data-k="bio" rows="4" maxlength="800">${esc(m.bio)}</textarea></label>`
      + `<div class="btn-row"><label class="btn btn-sm btn-outline file">${m.photo ? 'Change photo' : 'Add photo'}<input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only"></label>`
      + (m.photo ? '<button type="button" class="link m-nophoto">Remove photo</button>' : '')
      + (i > 0 ? `<button type="button" class="btn btn-sm btn-outline m-up" aria-label="Move ${esc(m.name)} up">Move up</button>` : '')
      + (i < team.length - 1 ? `<button type="button" class="btn btn-sm btn-outline m-down" aria-label="Move ${esc(m.name)} down">Move down</button>` : '')
      + (team.length > 1 ? `<button type="button" class="link m-remove">Remove</button>` : '') + '</div></div></li>').join('');
  }
  const tl = $('#team-list');
  const idx = (t: EventTarget | null) => +((t as HTMLElement).closest<HTMLElement>('[data-i]')!.dataset.i!);
  tl.addEventListener('input', (e) => { const t = e.target as HTMLInputElement; if (!t.dataset.k) return; team[idx(t)][t.dataset.k] = t.value; teamDirty(); });
  tl.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    if (input.type !== 'file' || !input.files?.[0]) return;
    const file = input.files[0];
    if (file.size > 5 * 1024 * 1024 || !/^image\/(jpeg|png|webp)$/.test(file.type)) return fail(undefined, 'Choose a JPG, PNG or WebP photo up to 5 MB.');
    try {
      const { photo } = await call('POST', '/photo', undefined, await toThumb(file, 600, 600));
      team[idx(input)].photo = photo; drawTeam(); teamDirty();
    } catch (x: any) { if (x.status !== 401) fail(undefined, 'That photo couldn’t be used. Try another file.'); }
  });
  tl.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (!t.matches('.m-up, .m-down, .m-remove, .m-nophoto')) return;
    const i = idx(t);
    if (t.matches('.m-nophoto')) team[i].photo = '';
    if (t.matches('.m-up')) [team[i - 1], team[i]] = [team[i], team[i - 1]];
    if (t.matches('.m-down')) [team[i + 1], team[i]] = [team[i], team[i + 1]];
    if (t.matches('.m-remove')) {
      if (!(await ask(`Remove ${team[i].name || 'this person'}?`, 'They disappear from the About page when you save.', 'Remove'))) return;
      team.splice(i, 1);
    }
    drawTeam(); teamDirty();
  });
  $('#add-member').onclick = () => { team.push({ name: '', role: '', bio: '', photo: '' }); drawTeam(); teamDirty(); $<HTMLInputElement>('#team-list li:last-child [data-k=name]').focus(); };
  $('#save-team').onclick = () => {
    if (team.some((m) => !m.name.trim())) return fail(undefined, 'Every person needs a name.');
    save(async () => { team = (await call('PUT', '/team', team)).team; drawTeam(); teamDirty(false); }, 'Saved. The About page is updated.');
  };

  // ---------- activity ----------
  function renderActivity() {
    call('GET', '/activity').then((r) => {
      $('#activity-list').innerHTML = r.activity.length
        ? r.activity.map((a: any) => `<li><p>${esc(a.what)}</p><p class="hint">${esc(a.who)} · ${when(a.at)}</p></li>`).join('')
        : '<li class="hint">Nothing yet.</li>';
    }).catch(() => {});
  }
  // Keep the log current after any save.
  const _toast = toast;
  // @ts-ignore reassigning the function binding
  toast = (msg: string) => { _toast(msg); renderActivity(); };

  // ---------- livestream ----------
  const lf = $<HTMLFormElement>('#live-form');
  const lv = lf.elements as any;
  lf.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!lf.reportValidity()) return;
    save(async () => { state.live = (await call('PUT', '/live', { mode: lv.mode.value, video: lv.video.value.trim() })).live; }, 'Saved.');
  });

  // ---------- shell: views by #hash, phone drawer, user menu ----------
  const VIEWS: Record<string, string> = {
    dashboard: 'Dashboard', alerts: 'Alerts', events: 'Events', groups: 'Groups', email: 'Email', items: 'Videos & podcast', live: 'Livestream',
    team: 'Our team', stats: 'Statistics', activity: 'Activity', staff: 'Staff accounts', backup: 'Backup', help: 'Help',
  };
  const body = document.body;
  const side = $('#a-side');
  const menuBtn = $<HTMLButtonElement>('#a-menu');
  const scrim = $('#a-scrim');
  const mainEl = $('#main');
  const drawerOpen = () => body.classList.contains('a-drawer');
  function openDrawer() {
    body.classList.add('a-drawer');
    scrim.hidden = false;
    menuBtn.setAttribute('aria-expanded', 'true');
    mainEl.inert = true;
    side.scrollTop = 0;
    $<HTMLElement>('.a-nav', side).focus({ preventScroll: true });
  }
  function closeDrawer(returnFocus: boolean) {
    if (!drawerOpen()) return;
    body.classList.remove('a-drawer');
    scrim.hidden = true;
    menuBtn.setAttribute('aria-expanded', 'false');
    mainEl.inert = false;
    if (returnFocus) menuBtn.focus();
  }
  menuBtn.onclick = () => (drawerOpen() ? closeDrawer(true) : openDrawer());
  scrim.onclick = () => closeDrawer(true);

  const userBtn = $<HTMLButtonElement>('#a-user-btn');
  const userMenu = $('#a-user-menu');
  const userMenuOpen = (open: boolean, returnFocus = false) => {
    userMenu.hidden = !open;
    userBtn.setAttribute('aria-expanded', String(open));
    if (open) $<HTMLElement>('#a-change-pw').focus();
    else if (returnFocus) userBtn.focus();
  };
  userBtn.onclick = () => userMenuOpen(userMenu.hidden);
  document.addEventListener('click', (e) => { if (!userMenu.hidden && !(e.target as HTMLElement).closest('#a-user')) userMenuOpen(false); });
  $('#a-change-pw').addEventListener('click', () => {
    userMenuOpen(false);
    setTimeout(() => $<HTMLInputElement>('#own-pw:not([hidden]) input, #accounts button, #staff h1').focus(), 0);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!userMenu.hidden) return userMenuOpen(false, true);
    if (drawerOpen()) closeDrawer(true);
  });

  /** Show one view (from the hash). Unknown or missing ones show the dashboard. */
  function show(focus = true) {
    let v = location.hash.slice(1);
    if (!VIEWS[v] || !document.getElementById(v)) v = 'dashboard';
    const denied = !can(VIEW_AREA[v]);
    for (const id of Object.keys(VIEWS)) { const s = document.getElementById(id); if (s) s.hidden = denied || id !== v; }
    $('#a-denied').hidden = !denied;
    document.querySelectorAll<HTMLElement>('.a-nav').forEach((a) => { if (a.dataset.view === v) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current'); });
    $('#a-crumb').textContent = VIEWS[v];
    document.title = `${VIEWS[v]} · Admin`;
    closeDrawer(false);
    scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
    if (v === 'dashboard' && !denied) renderDashboard();
    if (focus) {
      const h = document.getElementById(denied ? 'a-denied' : v)!.querySelector<HTMLElement>('h1, h2');
      if (h) { if (!h.hasAttribute('tabindex')) h.tabIndex = -1; h.focus({ preventScroll: true }); }
    }
  }
  /** Open a view from code (Post a meeting alert, quick actions). */
  function go(v: string) { if (location.hash === `#${v}`) show(); else location.hash = v; }
  addEventListener('hashchange', () => show());
  document.querySelectorAll<HTMLButtonElement>('[data-quick]').forEach((b) => (b.onclick = () => {
    const v = b.dataset.quick!;
    go(v);
    if (v === 'alerts') el.message.focus();
    if (v === 'events') $<HTMLButtonElement>('#add-event').click();
  }));

  // ---------- dashboard (existing APIs only) ----------
  const tile = (label: string, num: unknown, note = '', delta?: number) => `<div class="a-tile"><p class="a-tile-label">${esc(label)}</p><p class="a-tile-num">${esc(num ?? '–')}</p>`
    + (delta === undefined ? '' : `<p class="a-tile-note"><span class="a-delta${delta > 0 ? ' is-up' : delta < 0 ? ' is-down' : ''}">${delta > 0 ? `▲ ${delta}` : delta < 0 ? `▼ ${-delta}` : 'No change'}</span> in 7 days</p>`)
    + (note ? `<p class="a-tile-note">${esc(note)}</p>` : '') + '</div>';
  async function renderDashboard() {
    const hour = +new Intl.DateTimeFormat('en-US', { hour: 'numeric', hourCycle: 'h23', timeZone: TZ }).format(new Date());
    $('#a-greeting').textContent = `Good ${hour < 12 ? 'morning' : hour < 17 ? 'afternoon' : 'evening'}, ${me}.`;
    // Alerts
    const list = activeAlerts(state.alerts);
    $('#d-alerts').innerHTML = list.length
      ? list.map((a: any) => `<div class="active-row">${alertCard(a, BASE)}<p class="hint">Ends ${ends(a.expires)} <a class="btn btn-sm btn-outline" href="#alerts">Manage</a></p></div>`).join('')
      : '<p class="a-muted">No active alerts. The site shows no banner.</p><p><button type="button" class="btn btn-sm" data-go="alerts">Post an alert</button></p>';
    // Coming up: church events and group events, next two weeks
    const items = upcomingItems(state.events, state.groups ?? [], new Date(), 14).filter((it: any) => it.kind !== 'meeting').slice(0, 6);
    $('#d-events').innerHTML = items.length
      ? items.map((it: any) => `<li><span class="a-list-text"><span class="a-list-main">${esc(it.title)}</span><span class="a-list-meta">${new Date(`${it.date}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' })}${it.time ? ` · ${it.time}` : ''}${it.group ? ` · ${esc(it.group.name)}` : ''}${it.major ? ' <span class="chip-imp is-major">Major</span>' : ''}</span></span></li>`).join('')
      : '<li><span class="a-muted">No events in the next two weeks.</span><button type="button" class="btn btn-sm btn-outline a-list-end" data-go="events">Add an event</button></li>';
    // Groups this week
    const gs = state.groups ?? [];
    $('#d-groups').innerHTML = gs.length
      ? gs.map((g: any) => { const s = groupStatus(g, new Date()); return `<li><a class="a-list-main a-link" href="#groups">${esc(g.name)}</a><span class="chip-status is-${s.kind} a-list-end">${s.label}</span></li>`; }).join('')
      : '<li class="a-muted">No groups yet.</li>';
    // Activity
    if (can('activity')) call('GET', '/activity').then((r) => {
      $('#d-activity').innerHTML = r.activity.length
        ? r.activity.slice(0, 6).map((a: any) => `<li><span class="a-list-text"><span class="a-list-main">${esc(a.what)}</span><span class="a-list-meta">${esc(a.who)} · ${when(a.at)}</span></span></li>`).join('')
        : '<li class="a-muted">Nothing yet.</li>';
    }).catch(() => {});
    // This week at a glance
    if (!can('stats')) return;
    const [sum, counts] = await Promise.all([call('GET', '/stats/summary?range=7d').catch(() => null), can('email') ? call('GET', '/email/counts').catch(() => null) : null]);
    const subs = counts?.total ?? sum?.subscribers?.total;
    $('#d-tiles').innerHTML = tile('Email subscribers', subs, '', sum?.subscribers?.change)
      + (sum ? tile('Visits', sum.visitors, `${sum.views} page views`) + tile('Video plays', sum.plays?.video) + tile('Podcast plays', sum.plays?.podcast) : '');
    $('#d-tiles-note').hidden = Boolean(sum);
  }
  $('#dashboard').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-go]');
    if (!b) return;
    go(b.dataset.go!);
    if (b.dataset.go === 'alerts') el.message.focus();
    if (b.dataset.go === 'events') $<HTMLButtonElement>('#add-event').click();
  });

  // ---------- permissions (Staff accounts › Permissions) ----------
  const AREA_LABEL: [string, string][] = [['alerts', 'Alerts'], ['events', 'Events'], ['groups', 'Groups'], ['email', 'Email'], ['media', 'Videos & podcast'], ['live', 'Livestream'],
    ['team', 'Our team'], ['stats', 'Statistics'], ['staff', 'Staff accounts & permissions'], ['activity', 'Activity'], ['backup', 'Backup']];
  const areaBoxes = (areas: string[], disabled: boolean) => AREA_LABEL.map(([k, l]) => `<label class="check"><input type="checkbox" name="areas" value="${k}"${areas.includes(k) ? ' checked' : ''}${disabled ? ' disabled' : ''}> ${l}</label>`).join('');
  function renderPerms(r: any) {
    const admins = r.accounts.filter((a: any) => a.role === 'admin').length;
    $('#staff-perms').innerHTML = r.accounts.map((a: any) => {
      const last = a.role === 'admin' && admins <= 1;
      const isAdmin = a.role === 'admin';
      return `<form class="card form perm" data-u="${esc(a.username)}" novalidate><h2 class="a-h2">${esc(a.username)}${a.username === r.me ? ' (you)' : ''}</h2>
        <fieldset class="types"><legend>Role</legend>
          <label class="type-card"><input type="radio" name="role" value="admin"${isAdmin ? ' checked' : ''}> Admin: can do everything</label>
          <label class="type-card"><input type="radio" name="role" value="limited"${isAdmin ? '' : ' checked'}${last ? ' disabled aria-describedby="last-' + esc(a.username) + '"' : ''}> Limited: only the areas ticked below</label>
        </fieldset>
        ${last ? `<p class="hint" id="last-${esc(a.username)}">There must always be at least one admin. Make someone else an admin first.</p>` : ''}
        <p class="hint all-areas"${isAdmin ? '' : ' hidden'}>Admins can use every area.</p>
        <fieldset class="area-boxes"${isAdmin ? ' hidden' : ''}><legend>Areas</legend><div class="two">${areaBoxes(a.areas ?? [], false)}</div></fieldset>
        <p><button class="btn btn-sm" type="submit">Save permissions</button></p></form>`;
    }).join('');
  }
  $('#staff-perms').addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name !== 'role') return;
    $('.area-boxes', t.form!).hidden = t.value === 'admin';
    $('.all-areas', t.form!).hidden = t.value !== 'admin';
  });
  $('#staff-perms').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const u = form.dataset.u!;
    const role = (form.querySelector<HTMLInputElement>('[name=role]:checked')!).value;
    const areas = [...form.querySelectorAll<HTMLInputElement>('[name=areas]:checked')].map((b) => b.value);
    const self = u === me;
    if (self && role !== 'admin' && access.role === 'admin' && !(await ask('Remove your own admin rights?', 'You’ll only see the areas you tick.', 'Save permissions'))) return;
    try {
      await call('PUT', `/staff/${encodeURIComponent(u)}/access`, { role, areas });
      if (self) return location.reload();
      toast(`Permissions saved. They apply the next time ${u} loads the admin.`);
      renderStaff();
    } catch (x: any) { if (x.status !== 401 && !x.handled) fail(undefined, x.data?.error === 'last_admin' ? 'There must always be at least one admin. Make someone else an admin first.' : 'Couldn’t save. Try again.'); }
  });
  document.querySelectorAll<HTMLButtonElement>('[data-staff-tab]').forEach((b) => (b.onclick = () => {
    document.querySelectorAll('[data-staff-tab]').forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
    $('#staff-accounts').hidden = b.dataset.staffTab !== 'accounts';
    $('#staff').dataset.tab = b.dataset.staffTab;
    $('#staff-perms').hidden = b.dataset.staffTab !== 'permissions';
  }));
  // New accounts: Limited with Alerts, Events and Groups unless changed.
  $('#add-staff-areas').innerHTML = areaBoxes(['alerts', 'events', 'groups'], false);
  $('#add-staff').addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'role') { $('#add-staff .area-boxes').hidden = t.value === 'admin'; $('#add-staff .all-areas').hidden = t.value !== 'admin'; }
  });

  // ---------- what this account may use ----------
  let access: { kind: string; role: string; areas: string[] } = { kind: 'email', role: 'admin', areas: [] };
  const VIEW_AREA: Record<string, string> = { alerts: 'alerts', events: 'events', groups: 'groups', email: 'email', items: 'media', live: 'live', team: 'team', stats: 'stats', activity: 'activity', backup: 'backup' };
  const can = (area?: string) => !area || access.kind === 'email' || access.role === 'admin' || access.areas.includes(area);
  /** Limited accounts: only their areas in the menu and on the dashboard (the server enforces it as well). */
  function applyAccess() {
    // The menu lists only usable areas; Staff accounts stays reachable from the user menu for your own password.
    document.querySelectorAll<HTMLElement>('.a-navs .a-nav[data-view]').forEach((a) => (a.closest('li')!.hidden = !can(a.dataset.view === 'staff' ? 'staff' : VIEW_AREA[a.dataset.view!])));
    document.querySelectorAll<HTMLElement>('.a-navs > ul').forEach((ul) => {
      const empty = ![...ul.children].some((li) => !(li as HTMLElement).hidden);
      ul.hidden = empty;
      const label = ul.getAttribute('aria-labelledby');
      if (label) document.getElementById(label)!.hidden = empty;
    });
    document.querySelectorAll<HTMLElement>('#dashboard [data-area]').forEach((x) => (x.hidden = !can(x.dataset.area)));
    const staffAll = can('staff');
    $('#staff-tabs').hidden = !staffAll;
    $('#staff-accounts').hidden = !staffAll;
    if (!staffAll) $('#staff-perms').hidden = true;
  }

  function setUser(name: string) {
    $('#a-user').hidden = false;
    $('#a-initials').textContent = (name.replace(/@.*/, '').match(/[a-z0-9]/gi) ?? ['?']).slice(0, 2).join('');
    $('#a-user-name').textContent = name;
    $('#a-user-who').textContent = name ? `Signed in as ${name}` : 'Signed in';
  }

  // ---------- start ----------
  (async () => {
    if (!document.documentElement.hasAttribute('data-signed-in')) return gate();
    if (document.documentElement.hasAttribute('data-must-change')) {
      body.classList.add('a-must');
      setUser('');
      $('#must-change').hidden = false;
      $('#sign-out').hidden = false;
      return $<HTMLInputElement>('#change-form [name=password]').focus();
    }
    try {
      const r = await call('GET', '/state');
      state = r.state; emailOn = r.email; me = r.user;
      access = { kind: r.kind ?? 'email', role: r.role ?? 'admin', areas: r.areas ?? [] };
      $('#default-warning').hidden = !(r.defaultPassword && can('staff'));
    } catch (e: any) {
      if (e.data?.error !== 'must_change') return gate();
      body.classList.add('a-must');
      setUser(String(e.data?.user ?? ''));
      $('#must-change').hidden = false;
      $('#sign-out').hidden = false;
      return $<HTMLInputElement>('#change-form [name=password]').focus();
    }
    app.hidden = false;
    body.classList.add('a-in');
    setUser(me);
    $('#sign-out').hidden = false;
    lv.mode.value = state.live?.mode ?? 'auto';
    lv.video.value = state.live?.video ?? '';
    applyAccess();
    renderAlerts(); renderItems(); renderGroups(); resetCompose(); renderEvents();
    if (can('staff')) renderStaff();
    if (can('team')) renderTeam();
    if (can('activity')) renderActivity();
    show(false);
  })();
</script>

