  // ---------- staff accounts ----------
  const when = (ms: number) => new Date(ms).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: TZ }).replace(/\s([AP]M)/, (m) => m.trim().toLowerCase());
  async function renderStaff() {
    const r = await call('GET', '/staff');
    $('#own-pw').hidden = r.kind !== 'password';
    $('#accounts').innerHTML = r.accounts.map((a: any) => `<li><p><strong>${esc(a.username)}</strong>${a.username === r.me ? ' (you)' : ''}</p>`
      + `<p class="hint">${a.defaultPassword ? 'Default password: change it before launch' : a.mustChange ? 'Waiting for a new password' : `Password set ${when(a.updated)}`}</p>`
      + (a.username !== r.me ? `<div class="btn-row"><button type="button" class="btn btn-sm btn-outline reset-staff" data-u="${esc(a.username)}" aria-expanded="false">Reset password</button>`
        + (r.accounts.length > 1 ? `<button type="button" class="link del-staff" data-u="${esc(a.username)}">Remove</button>` : '') + '</div>'
        + `<form class="form reset-form" data-u="${esc(a.username)}" hidden novalidate><label>Temporary password for ${esc(a.username)} <input name="password" type="text" required minlength="12" autocomplete="off" spellcheck="false"></label>`
        + '<p class="hint">At least 12 characters. Give it to them in person or by phone. They must choose their own the next time they sign in.</p><p class="err" role="alert" hidden></p>'
        + '<p><button class="btn btn-sm" type="submit">Set temporary password</button></p></form>' : '') + '</li>').join('');
    $('#logins').innerHTML = r.logins.length ? r.logins.map((l: any) => `<li><p><strong>${esc(l.who)}</strong> · ${when(l.at)}</p><p class="hint">${l.method === 'link' ? 'Email link' : 'Password'} · ${esc(l.ip)}</p></li>`).join('') : '<li class="hint">No sign-ins yet.</li>';
    $('#default-warning').hidden = !r.accounts.some((a: any) => a.defaultPassword);
  }
  const op = $<HTMLFormElement>('#own-pw');
  op.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = op.elements as any;
    if (v.password.value.length < 12) return showErr('#own-err', PW_ERR.too_short);
    if (v.password.value !== v.again.value) return showErr('#own-err', 'The two passwords don’t match.');
    try { await call('POST', '/password', { current: v.current.value, password: v.password.value }); op.reset(); showErr('#own-err', ''); toast('Password changed.'); renderStaff(); }
    catch (err: any) { if (err.status !== 401) showErr('#own-err', PW_ERR[err.data?.error] ?? 'Couldn’t save. Try again.'); }
  });
  $('#accounts').addEventListener('submit', async (e) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('.reset-form');
    if (!form) return;
    e.preventDefault();
    const u = form.dataset.u!;
    const pw = (form.elements as any).password.value;
    const err = $('.err', form);
    if (pw.length < 12) { err.textContent = `⚠ ${PW_ERR.too_short}`; err.hidden = false; return; }
    if (!(await ask(`Reset the password for ${u}?`, 'They are signed out everywhere and must choose a new password the next time they sign in.', 'Reset password'))) return;
    try { await call('POST', `/staff/${encodeURIComponent(u)}/reset`, { password: pw }); toast(`Password reset. Give ${u} the temporary password.`); renderStaff(); }
    catch (x: any) { if (x.status !== 401) { err.textContent = `⚠ ${PW_ERR[x.data?.error] ?? 'Couldn’t reset it. Try again.'}`; err.hidden = false; } }
  });
  const as = $<HTMLFormElement>('#add-staff');
  as.addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = as.elements as any;
    try { await call('POST', '/staff', { username: v.username.value, password: v.password.value }); as.reset(); showErr('#add-err', ''); toast('Account added. They must choose a new password when they sign in.'); renderStaff(); }
    catch (err: any) { if (err.status !== 401) showErr('#add-err', PW_ERR[err.data?.error] ?? 'Couldn’t save. Try again.'); }
  });
  $('#accounts').addEventListener('click', async (e) => {
    const rb = (e.target as HTMLElement).closest<HTMLButtonElement>('.reset-staff');
    if (rb) { // show / hide that account's reset form
      const form = rb.closest('li')!.querySelector<HTMLFormElement>('.reset-form')!;
      form.hidden = !form.hidden;
      rb.setAttribute('aria-expanded', String(!form.hidden));
      if (!form.hidden) (form.elements as any).password.focus();
      return;
    }
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.del-staff');
    if (!b) return;
    if (!(await ask(`Remove ${b.dataset.u}?`, 'They can’t sign in with a password any more.', 'Remove account'))) return;
    try { await call('DELETE', `/staff/${encodeURIComponent(b.dataset.u!)}`); toast('Account removed.'); renderStaff(); }
    catch (err: any) { if (err.status !== 401) fail(undefined, PW_ERR[err.data?.error] ?? 'Couldn’t remove it. Try again.'); }
  });

  // ---------- events (church-wide) ----------
  const EV_ERR: Record<string, string> = { title: 'Give the event a title.', date: 'Choose a date.', past: 'That date has passed.', time: 'The end time must be after the start time (and needs a start time).', link: 'Enter a full link starting with https://, or a page on this site starting with /' };
  const evDate = (e: any) => [new Date(`${e.date}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' }), timeLabel(e.start, e.end).replace('&ndash;', '–')].filter(Boolean).join(' · ');
  function eventCard(e: any, open = false) {
    const id = esc(e.id ?? '');
    const hid = esc(e.id ?? 'new');
    return `<details class="card gcard" data-id="${id}"${open ? ' open' : ''}><summary><span class="gname">${esc(e.title || 'New event')}</span><span class="gmeta">${e.date ? `<span>${esc(evDate(e))}</span>` : ''}<span class="chip-imp${e.major ? ' is-major' : ''}">${e.major ? 'Major' : 'Minor'}</span></span></summary>
      <form class="form gform" novalidate>
      <label>Title <input name="title" required maxlength="80" value="${esc(e.title)}"></label>
      <div class="two"><label>Date <input type="date" name="date" required min="${etDay(new Date())}" value="${esc(e.date)}"></label>
      <label>Starts (optional) <input type="time" name="start" value="${esc(e.start)}"></label></div>
      <div class="two"><label>Ends (optional) <input type="time" name="end" value="${esc(e.end)}"></label>
      <label>Place <input name="place" maxlength="80" value="${esc(e.place)}" aria-describedby="ep-${hid}"></label></div>
      <p class="hint" id="ep-${hid}">Leave the place blank to show “Contact us”.</p>
      <label>Description (optional) <textarea name="about" rows="3" maxlength="300" aria-describedby="ea-${hid}">${esc(e.about)}</textarea></label>
      <p class="hint" id="ea-${hid}">Up to 300 characters.</p>
      <fieldset class="types"><legend>Importance</legend>
        <label class="type-card"><input type="radio" name="major" value="1"${e.major ? ' checked' : ''}> Major: shown big on the home page</label>
        <label class="type-card"><input type="radio" name="major" value="0"${e.major ? '' : ' checked'}> Minor: shown in the list</label>
      </fieldset>
      <label>Link (optional) <input name="link" type="text" inputmode="url" autocapitalize="off" spellcheck="false" placeholder="https:// or /page" value="${esc(e.link)}"></label>
      <p class="err" role="alert" hidden></p>
      <div class="btn-row"><button class="btn btn-sm" type="submit">Save</button><button class="link remove-event" type="button">Remove</button></div>
    </form></details>`;
  }
  function renderEvents(openId = '') {
    const list = state.events ?? [];
    $('#event-list').innerHTML = list.length ? list.map((e: any) => eventCard(e, e.id === openId)).join('') : '<p class="muted" id="no-events">No church events yet. Add one and it appears on the home page and Events.</p>';
  }
  $('#add-event').onclick = () => {
    $('#no-events')?.remove();
    $('#event-list').insertAdjacentHTML('afterbegin', eventCard({ title: '', date: '', major: false }, true));
    $<HTMLInputElement>('#event-list [name=title]').focus();
  };
  $('#event-list').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const card = form.closest<HTMLElement>('.gcard')!;
    const v = form.elements as any;
    const err = $('.err', form);
    const body = { title: v.title.value, date: v.date.value, start: v.start.value, end: v.end.value, place: v.place.value, about: v.about.value, major: v.major.value === '1', link: v.link.value };
    const local = !body.title.trim() ? 'title' : !body.date ? 'date' : body.end && (!body.start || body.end <= body.start) ? 'time' : '';
    if (local) { err.textContent = `⚠ ${EV_ERR[local]}`; err.hidden = false; return; }
    try {
      const r = await call('PUT', `/events/${encodeURIComponent(card.dataset.id || 'new')}`, body);
      state.events = r.events;
      renderEvents(r.event.id);
      toast('Event saved. It’s on the home page.');
    } catch (x: any) {
      if (x.status === 401) return;
      if (EV_ERR[x.data?.error]) { err.textContent = `⚠ ${EV_ERR[x.data.error]}`; err.hidden = false; } else fail(() => form.requestSubmit());
    }
  });
  $('#event-list').addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (!t.matches('.remove-event')) return;
    const card = t.closest<HTMLElement>('.gcard')!;
    const title = ($<HTMLInputElement>('[name=title]', card).value || 'this event');
    if (!(await ask(`Remove ${title}?`, 'It disappears from the home page and Events.', 'Remove event'))) return;
    if (!card.dataset.id) { card.remove(); return toast('Event removed.'); }
    save(async () => { state.events = (await call('DELETE', `/events/${encodeURIComponent(card.dataset.id!)}`)).events; renderEvents(); }, 'Event removed.');
  });

  // ---------- our team ----------
  let team: any[] = [];
  const teamDirty = (on = true) => ($('#team-dirty').hidden = !on);
  function renderTeam() {
    call('GET', '/team').then((r) => { team = r.team; drawTeam(); }).catch(() => {});
  }
  function drawTeam() {
    $('#team-list').innerHTML = team.map((m, i) => `<li class="card item member-row" data-i="${i}">`
      + (m.photo ? `<img class="team-photo" src="${esc(m.photo)}" alt="" width="96" height="96">` : '<span class="team-photo" aria-hidden="true"></span>')
      + `<div class="ifields"><p class="hint">${i === 0 ? 'Featured first' : `Position ${i + 1}`}</p>`
      + `<label>Name <input data-k="name" required maxlength="80" value="${esc(m.name)}"></label>`
      + `<label>Role <input data-k="role" maxlength="80" value="${esc(m.role)}" placeholder="Elder"></label>`
      + `<label>Short bio <textarea data-k="bio" rows="4" maxlength="800">${esc(m.bio)}</textarea></label>`
      + `<div class="btn-row"><label class="btn btn-sm btn-outline file">${m.photo ? 'Change photo' : 'Add photo'}<input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only"></label>`
      + (m.photo ? '<button type="button" class="link m-nophoto">Remove photo</button>' : '')
      + (i > 0 ? `<button type="button" class="btn btn-sm btn-outline m-up" aria-label="Move ${esc(m.name)} up">Move up</button>` : '')
      + (i < team.length - 1 ? `<button type="button" class="btn btn-sm btn-outline m-down" aria-label="Move ${esc(m.name)} down">Move down</button>` : '')
      + (team.length > 1 ? `<button type="button" class="link m-remove">Remove</button>` : '') + '</div></div></li>').join('');
  }
  const tl = $('#team-list');
  const idx = (t: EventTarget | null) => +((t as HTMLElement).closest<HTMLElement>('[data-i]')!.dataset.i!);
  tl.addEventListener('input', (e) => { const t = e.target as HTMLInputElement; if (!t.dataset.k) return; team[idx(t)][t.dataset.k] = t.value; teamDirty(); });
  tl.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    if (input.type !== 'file' || !input.files?.[0]) return;
    const file = input.files[0];
    if (file.size > 5 * 1024 * 1024 || !/^image\/(jpeg|png|webp)$/.test(file.type)) return fail(undefined, 'Choose a JPG, PNG or WebP photo up to 5 MB.');
    try {
      const { photo } = await call('POST', '/photo', undefined, await toThumb(file, 600, 600));
      team[idx(input)].photo = photo; drawTeam(); teamDirty();
    } catch (x: any) { if (x.status !== 401) fail(undefined, 'That photo couldn’t be used. Try another file.'); }
  });
  tl.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (!t.matches('.m-up, .m-down, .m-remove, .m-nophoto')) return;
    const i = idx(t);
    if (t.matches('.m-nophoto')) team[i].photo = '';
    if (t.matches('.m-up')) [team[i - 1], team[i]] = [team[i], team[i - 1]];
    if (t.matches('.m-down')) [team[i + 1], team[i]] = [team[i], team[i + 1]];
    if (t.matches('.m-remove')) {
      if (!(await ask(`Remove ${team[i].name || 'this person'}?`, 'They disappear from the About page when you save.', 'Remove'))) return;
      team.splice(i, 1);
    }
    drawTeam(); teamDirty();
  });
  $('#add-member').onclick = () => { team.push({ name: '', role: '', bio: '', photo: '' }); drawTeam(); teamDirty(); $<HTMLInputElement>('#team-list li:last-child [data-k=name]').focus(); };
  $('#save-team').onclick = () => {
    if (team.some((m) => !m.name.trim())) return fail(undefined, 'Every person needs a name.');
    save(async () => { team = (await call('PUT', '/team', team)).team; drawTeam(); teamDirty(false); }, 'Saved. The About page is updated.');
  };

  // ---------- activity ----------
  function renderActivity() {
    call('GET', '/activity').then((r) => {
      $('#activity-list').innerHTML = r.activity.length
        ? r.activity.map((a: any) => `<li><p>${esc(a.what)}</p><p class="hint">${esc(a.who)} · ${when(a.at)}</p></li>`).join('')
        : '<li class="hint">Nothing yet.</li>';
    }).catch(() => {});
  }
  // Keep the log current after any save.
  const _toast = toast;
  // @ts-ignore reassigning the function binding
  toast = (msg: string) => { _toast(msg); renderActivity(); };

  // ---------- livestream ----------
  const lf = $<HTMLFormElement>('#live-form');
  const lv = lf.elements as any;
  lf.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!lf.reportValidity()) return;
    save(async () => { state.live = (await call('PUT', '/live', { mode: lv.mode.value, video: lv.video.value.trim() })).live; }, 'Saved.');
  });

  // ---------- start ----------
  (async () => {
    try {
      const r = await call('GET', '/state');
      state = r.state; emailOn = r.email; me = r.user;
      $('#default-warning').hidden = !r.defaultPassword;
    } catch (e: any) {
      if (e.data?.error !== 'must_change') return gate();
      $('#must-change').hidden = false;
      $('#sign-out').hidden = false;
      return $<HTMLInputElement>('#change-form [name=password]').focus();
    }
    app.hidden = false;
    $('#sign-out').hidden = false;
    lv.mode.value = state.live?.mode ?? 'auto';
    lv.video.value = state.live?.video ?? '';
    renderAlerts(); renderItems(); renderGroups(); resetCompose(); renderStaff(); renderEvents(); renderTeam(); renderActivity();
  })();
</script>

<style is:global>
