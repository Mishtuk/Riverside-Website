    return !msg;
  }
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!checkCompose()) return;
    const body = { ...alertBody(), email: el.email.checked, topics: el.email.checked ? emailTopics() : undefined, replaces: editing || undefined };
    if (body.email) {
      let count: number;
      try { ({ count } = await call('GET', `/recipients?type=${body.type}&group=${encodeURIComponent(body.group ?? '')}&topics=${encodeURIComponent(body.topics.join(','))}`)); }
      catch { return fail(undefined, 'Couldn’t count subscribers. Try again.'); }
      if (!(await ask(`Post and email ${count} ${count === 1 ? 'person' : 'people'}?`, `${body.group ? 'Each person gets it once, whichever lists they are on.' : `They’re on “${TOPIC[body.type]}”.`} Emails can’t be unsent.`, 'Post and email'))) return;
    }
    try {
      const { alert, recipients } = await call('POST', '/alerts', body);
      state.alerts = [...(state.alerts ?? []).filter((x: any) => x.id !== editing), alert];
