---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHead from '../components/PageHead.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import MinistryForm from '../components/MinistryForm.astro';
import { CHURCH } from '../lib/site';
import { page, sections } from '../lib/md';

const giving = await page('giving');
const faq = sections((await page('giving-faq')).entry.body).filter((s) => !/still have more/i.test(s.title));
const tel = `tel:+1${CHURCH.phone.replace(/\D/g, '')}`;
const sms = `sms:+1${CHURCH.textToGive.replace(/\D/g, '')}`;
---

<Base
  title="Give | Riverside Community Church"
  description="Give to Riverside Community Church online, by text to 267-274-2425, by check, or through your bank's bill pay."
>
  <Header slot="header" />

  <PageHead eyebrow="Give" title="Generosity is our language." image="/media/photos/preach.jpg" focus="center">
    <blockquote class="verse fade-up" style="--i:2">
      &ldquo;Each one must give as he has decided in his heart, not reluctantly or under compulsion, for God loves a cheerful giver.&rdquo;
      <cite>2 Corinthians 9:7</cite>
    </blockquote>
  </PageHead>

  <section class="section band-paper" id="online">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Ways to give</p>
        <h2 class="h1">Simple, secure and <span class="accent">easy.</span></h2>
        <p>Jesus was generous with us beyond measure. We want to be known as a generous church. Give online by card, debit or bank account, or choose another way.</p>
      </div>
      <div class="give-grid">
        <MinistryForm id={giving.entry.data.form!} title="Online giving form" />
        <aside class="other" aria-labelledby="other-title">
          <h3 id="other-title" class="eyebrow">Other ways to give</h3>
          <div class="way">
            <h4>Text to give</h4>
            <a class="num" href={sms}>{CHURCH.textToGive}</a>
            <p>Text an amount. Add a fund name to choose where it goes (ex: $50 General).</p>
          </div>
          <div class="way">
            <h4>By mail</h4>
            <p>Make checks payable to <strong>{CHURCH.name}</strong><br />{CHURCH.street}, {CHURCH.city}, {CHURCH.region} {CHURCH.zip}</p>
          </div>
          <div class="way">
            <h4>Bill pay</h4>
            <p>Set up one-time or recurring payments through your bank's online bill pay, with no fees. You can also use the offering basket on Sunday.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="section-head">
        <h2 class="h1">Common <span class="accent">questions.</span></h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <Cta title="Still have questions?" text="We are happy to help.">
    <a class="btn" href={`mailto:${CHURCH.email}`}>Email us</a>
    <a class="btn btn-light" href={tel}>Call {CHURCH.phone}</a>
  </Cta>

  <Footer slot="footer" />
</Base>

<style>
  .verse { margin-top: 1.5rem; max-width: 40ch; border-left: 3px solid var(--gold); padding-left: 1.25rem; font-family: var(--font-display); font-size: var(--step-1); line-height: 1.45; }
  .verse cite { display: block; margin-top: 0.5rem; font-family: var(--font-body); font-size: var(--step--1); font-style: normal; font-weight: 700; letter-spacing: 0.04em; color: var(--gold-ink-sm); }
  .give-grid { display: grid; gap: 2rem; align-items: start; }
  .other { display: grid; gap: 0; }
  .other .eyebrow { margin-bottom: 0.5rem; }
  .way { padding: 1.4rem 0; border-top: 1px solid var(--line-gold); }
  .way h4 { font-family: var(--font-display); font-weight: 400; font-size: var(--step-2); line-height: 1.2; }
  .way p { margin-top: 0.4rem; color: var(--muted); max-width: 42ch; }
  .way strong { color: var(--ink); }
  .num { display: inline-block; margin-top: 0.3rem; font-family: var(--font-display); font-size: var(--step-3); line-height: 1.1; color: var(--gold-ink); text-decoration-color: var(--gold); text-underline-offset: 6px; }
  .num:hover { color: var(--ink); }
  @media (min-width: 960px) {
    .give-grid { grid-template-columns: minmax(0, 620px) minmax(0, 1fr); gap: clamp(3rem, 6vw, 6rem); }
    .other { padding-top: 0.5rem; }
  }
</style>
