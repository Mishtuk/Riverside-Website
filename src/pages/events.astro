---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHead from '../components/PageHead.astro';
import Cta from '../components/Cta.astro';
import { CHURCH, href } from '../lib/site';

// Recurring weekly items (from events.md; the old calendar was generated by the CMS).
const weekly = [
  { day: 'Every Sunday', title: 'Sunday Worship', time: CHURCH.times, note: `${CHURCH.timesNote}.`, cta: ['Plan your visit', '/im-new'] },
  { day: 'Every Sunday', title: 'Sunday Morning Prayer Group', time: CHURCH.prayerTime, note: 'Meets in the Counseling Office. All are welcome.', cta: ['More about prayer', '/get-involved#prayer'] },
  { day: 'Every Sunday', title: 'Kids’ Classes', time: '10:30am', note: 'Ages 0–2, 2–3, 4–5 and 6–12, during the second service.', cta: ['Kids info', '/im-new#kids'] },
] as const;
---

<Base
  title="Events | Riverside Community Church"
  description="Weekly events at Riverside Community Church in Horsham, PA: Sunday worship, the Sunday morning prayer group and kids' classes."
>
  <Header slot="header" />

  <PageHead eyebrow="Events" title="What's happening." image="/media/photos/coffee.jpg" focus="center" lede="Our weekly rhythms, and how to hear about everything else." />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Every week</p>
        <h2 class="h1">Weekly <span class="accent">gatherings.</span></h2>
      </div>
      <div class="cards-grid">
        {weekly.map((e) => (
          <article class="card ev reveal">
            <p class="day">{e.day}</p>
            <h3>{e.title}</h3>
            <p class="time">{e.time}</p>
            <p>{e.note}</p>
            <a class="link link-arrow" href={href(e.cta[1])}>{e.cta[0]}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-paper">
    <div class="container soon">
      <p class="eyebrow">Coming up</p>
      <h2 class="h1">More events <span class="accent">coming soon.</span></h2>
      <p class="lede">Special events and seasonal gatherings are announced by email. Join the list so you never miss one.</p>
      <div class="btn-row"><a class="btn" href={href('/subscribe')}>Get our emails</a></div>
    </div>
  </section>

  <Cta title="Join us this Sunday.">
    <a class="btn" href={href('/im-new')}>Plan your visit</a>
    <a class="btn btn-light" href={CHURCH.mapsUrl} rel="noopener">Get directions</a>
  </Cta>

  <Footer slot="footer" />
</Base>

<style>
  .ev { display: flex; flex-direction: column; gap: 0.25rem; }
  .day { font-size: var(--step--1); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold-ink-sm) !important; }
  .ev h3 { font-size: var(--step-2); margin-bottom: 0; }
  .time { font-family: var(--font-display); font-size: var(--step-1); color: var(--ink) !important; margin-bottom: 0.5rem; }
  .ev .link { margin-top: auto; padding-top: 1rem; align-self: flex-start; font-weight: 700; }
  .soon .btn-row { margin-top: 2rem; }
  .soon .lede { margin-top: 1rem; }
</style>
