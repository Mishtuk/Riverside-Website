---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHead from '../components/PageHead.astro';
import { CHURCH, href, photo } from '../lib/site';
import { page } from '../lib/md';

// Recurring rhythms. Only facts already on the site; unknown times say so instead of guessing.
const bapt = await page('baptisms');
const baptismVideo = (bapt.entry.data.youtube ?? '').split(',')[0].trim();
const ASK = 'Contact us for times';
const rhythms = [
  {
    day: 'Every Sunday', title: 'Sunday worship', time: CHURCH.times.replace('Sundays ', ''),
    text: `Join us at either service. ${CHURCH.timesNote}.`,
    img: href('/media/photos/vocals.jpg'), alt: 'A worship leader singing at the keyboard during a Sunday service',
    cta: ['Plan your visit', href('/im-new')],
  },
  {
    day: 'Every Sunday', title: 'Morning prayer group', time: CHURCH.prayerTime,
    text: 'We meet in the Counseling Office to pray for our church, its members and our community. All are welcome.',
    img: href('/media/photos/keys.jpg'), alt: 'Hands on a keyboard during quiet worship',
    cta: ['More about prayer', href('/get-involved#prayer')],
  },
  {
    day: 'Every Sunday', title: 'Kids’ classes', time: '10:30am',
    text: 'Classes for ages 0–2, 2–3, 4–5 and 6–12 during the second service.',
    img: href('/media/photos/storytime.jpg'), alt: 'Children listening to a story in a Riverside kids’ class',
    cta: ['Kids at Riverside', href('/im-new#kids')],
  },
  {
    day: 'Classes', title: 'ESL classes', time: ASK,
    text: 'Practice English in a friendly, patient class. Everyone is welcome.',
    img: href('/media/photos/embrace.jpg'), alt: 'Two women sharing a hug at Riverside',
    cta: ['Register for ESL', href('/get-involved#esl')],
  },
  {
    day: 'Small groups', title: 'Discipleship groups', time: ASK,
    text: 'Men’s and women’s groups of 3–5 people who meet consistently to study the Bible and grow together.',
    img: href('/media/photos/cafe.jpg'), alt: 'Coffee being poured at the Riverside Cafe',
    cta: ['Join a group', href('/get-involved#discipleship')],
  },
  {
    day: 'Celebrations', title: 'Baptisms', time: 'Contact us for dates',
    text: 'We love celebrating when a follower of Jesus makes a public profession of faith. Watch their stories, or ask about your own.',
    img: `https://i.ytimg.com/vi/${baptismVideo}/hqdefault.jpg`, alt: 'A baptism testimony video from a Riverside service',
    cta: ['Baptism stories', href('/get-involved#baptisms')],
  },
];
const sunday = [
  { time: CHURCH.services[0].label, title: 'Worship service' },
  { time: CHURCH.prayerTime, title: 'Prayer group', note: 'Counseling Office' },
  { time: CHURCH.services[1].label, title: 'Worship service', note: 'Kids’ classes & livestream' },
];
---

<Base
  title="Events | Riverside Community Church"
  description="Weekly rhythms at Riverside Community Church in Horsham, PA: Sunday worship at 9:00 & 10:30am, the morning prayer group, kids' classes, ESL, discipleship groups and baptisms."
>
  <Header slot="header" />

  <PageHead eyebrow="Events" title="What's happening." image="/media/photos/welcome.jpg" focus="60% 40%" lede="The rhythms of our church family, week in and week out." />

  <section class="section" aria-labelledby="sunday-title">
    <div class="container glance">
      <div class="section-head">
        <p class="eyebrow">Sunday at a glance</p>
        <h2 class="h1" id="sunday-title">Every Sunday on <span class="accent">Columbia Avenue.</span></h2>
        <p>Come for one service or stay the whole morning. The Riverside Cafe has coffee and donuts waiting.</p>
        <div class="btn-row"><a class="btn" href={href('/im-new')}>Plan your visit</a><a class="btn btn-outline" href={CHURCH.mapsUrl} rel="noopener">Get directions</a></div>
      </div>
      <ol class="timeline">
        {sunday.map((s) => (
          <li>
            <span class="t-time">{s.time}</span>
            <span class="t-what"><strong>{s.title}</strong>{s.note && <span>{s.note}</span>}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section band-paper" aria-labelledby="rhythms-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Weekly rhythms</p>
        <h2 class="h1" id="rhythms-title">Find your <span class="accent">place to belong.</span></h2>
      </div>
      <ul class="rhythms">
        {rhythms.map((r) => (
          <li class="rhythm reveal">
            <div class:list={['media', r.img.includes('ytimg') && 'yt']}><img src={r.img} srcset={r.img.includes('/media/photos/') ? photo(r.img).srcset : undefined} sizes="(min-width: 700px) 400px, 100vw" alt={r.alt} width="1200" height="675" loading="lazy" decoding="async" /></div>
            <div class="rhythm-body">
              <p class="day">{r.day}</p>
              <h3>{r.title}</h3>
              <p class:list={['time', r.time.startsWith('Contact') && 'time-ask']}>{r.time}</p>
              <p class="text">{r.text}</p>
              <a class="link link-arrow" href={r.cta[1]}>{r.cta[0]}<span class="sr-only">: {r.title}</span></a>
            </div>
          </li>
        ))}
      </ul>
      <p class="ask-note">For ESL, discipleship group and baptism times, email <a href={`mailto:${CHURCH.email}`}>{CHURCH.email}</a> or call <a href={`tel:${CHURCH.phone.replace(/-/g, '')}`}>{CHURCH.phone}</a> and we will point you to the next one.</p>
    </div>
  </section>

  <section class="section signup" aria-labelledby="signup-title">
    <div class="container signup-inner">
      <div class="signup-seal" aria-hidden="true"><img src={href('/brand/church-reduce.png')} alt="" width="622" height="622" loading="lazy" /></div>
      <div class="signup-copy">
        <p class="eyebrow">Stay in the loop</p>
        <h2 class="h1" id="signup-title">Hear about special events <span class="accent">first.</span></h2>
        <p>Seasonal gatherings and special events are announced by email. Join the list so you never miss one.</p>
      </div>
      <div class="signup-cta">
        <a class="btn btn-dark" href={href('/subscribe')}>Get our emails</a>
        <p class="fine">Free. Unsubscribe anytime.</p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  /* Sunday at a glance */
  .glance { display: grid; gap: clamp(2rem, 1.5rem + 3vw, 4.5rem); align-items: center; }
  .glance .section-head { margin-bottom: 0; }
  .glance .btn-row { margin-top: 1.75rem; }
  .timeline { list-style: none; padding: 0; position: relative; display: grid; gap: 0.9rem; }
  .timeline::before { content: ''; position: absolute; left: 0.55rem; top: 1.4rem; bottom: 1.4rem; width: 2px; background: var(--line-gold); }
  .timeline li {
    position: relative; display: grid; grid-template-columns: 8.75rem 1fr; gap: 1rem; align-items: baseline;
    margin-left: 2rem; padding: 1.1rem 1.4rem; background: var(--paper); border-radius: var(--radius); box-shadow: var(--shadow-s);
  }
  .timeline li::before { /* dot on the rail */
    content: ''; position: absolute; left: -1.85rem; top: 50%; translate: 0 -50%;
    width: 0.9rem; height: 0.9rem; border-radius: 50%; background: var(--cream); border: 2px solid var(--gold);
  }
  .t-time { font-family: var(--font-display); font-size: var(--step-1); color: var(--gold-ink); line-height: 1.2; }
  .t-what strong { display: block; font-size: var(--step-0); }
  .t-what span { display: block; color: var(--muted); font-size: var(--step--1); }

  /* Rhythm cards */
  .rhythms { list-style: none; padding: 0; display: grid; gap: clamp(1.25rem, 0.75rem + 1.5vw, 2rem); grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .rhythm { display: flex; flex-direction: column; background: #fff; border-radius: var(--radius); box-shadow: var(--shadow-s); overflow: hidden; }
  .rhythm .media { aspect-ratio: 16 / 10; border-radius: 0; }
  .rhythm:hover .media img { transform: scale(1.04); }
  .rhythm .yt img { scale: 1.12; } /* hqdefault thumbnails carry letterbox bars; crop them out */
  .rhythm-body { display: flex; flex-direction: column; flex: 1; padding: clamp(1.25rem, 1rem + 1vw, 1.75rem); }
  .day { font-size: var(--step--1); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold-ink-sm); }
  .rhythm h3 { font-size: var(--step-2); margin: 0.3rem 0 0.2rem; }
  .time { font-family: var(--font-display); font-size: var(--step-1); color: var(--ink); }
  .time-ask { font-family: var(--font-body); font-size: var(--step--1); font-weight: 700; color: var(--muted); }
  .text { margin-top: 0.75rem; color: var(--muted); }
  .rhythm .link { margin-top: auto; padding-top: 1.25rem; align-self: flex-start; font-weight: 700; color: var(--gold-ink); }
  .ask-note { margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem); max-width: 60ch; color: var(--muted); }
  .ask-note a { color: var(--gold-ink); font-weight: 700; overflow-wrap: anywhere; }

  /* Email sign-up band */
  .signup { background: radial-gradient(45% 80% at 12% 50%, rgb(228 210 166 / 0.55), rgb(228 210 166 / 0) 70%), var(--parchment); border-top: 1px solid var(--line-gold); }
  .signup-inner { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 2.5rem); align-items: center; }
  .signup-seal {
    width: 7.5rem; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center;
    background: var(--paper); box-shadow: 0 0 0 1.5px var(--gold), 0 0 0 8px var(--parchment), 0 0 0 9px var(--line-gold), var(--shadow-m);
  }
  .signup-seal img { width: 68%; height: auto; mix-blend-mode: multiply; }
  .signup-copy h2 { margin-top: 0.75rem; max-width: 18ch; }
  .signup-copy p:last-child { margin-top: 1rem; color: var(--muted); font-size: var(--step-1); line-height: 1.5; max-width: 44ch; }
  .signup-cta { display: grid; gap: 0.6rem; justify-items: start; }
  .fine { font-size: var(--step--1); color: var(--muted); }

  @media (min-width: 900px) {
    .glance { grid-template-columns: 1fr 1fr; }
    .signup-inner { grid-template-columns: auto 1fr auto; max-width: 66rem; gap: 3rem; }
    .signup-cta .btn { min-height: 56px; padding-inline: 2rem; font-size: var(--step-0); }
    .signup-cta { justify-items: center; text-align: center; }
  }
  @media (max-width: 420px) {
    .timeline li { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
