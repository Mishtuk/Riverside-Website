---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHead from '../components/PageHead.astro';
import Facade from '../components/Facade.astro';
import MinistryForm from '../components/MinistryForm.astro';
import { CHURCH, href } from '../lib/site';
import { page, sections, intro } from '../lib/md';
import { MAILCHIMP_PRAYER, ESL_FORM, DISCIPLESHIP_FORM, RIGHTNOW_URL } from '../lib/links';

const mail = `mailto:${CHURCH.email}`;
const disc = await page('discipleship');
const women = await page('women');
const prayer = await page('prayer');
const serving = await page('serving');
const bapt = await page('baptisms');
const rightnow = await page('rightnow');
const guides = await page('study-guides');
const guideCount = (guides.entry.body ?? '').match(/^- \[/gm)?.length ?? 0;

const ids = (bapt.entry.data.youtube ?? '').split(',').map((s) => s.trim());
const names = (bapt.entry.body ?? '').split('## Testimonies')[1]?.split('<!--')[0].trim().split(/,\s*/) ?? [];
const testimonies = ids.map((id, i) => ({ id, name: names[i] ?? 'Baptism testimony' })).slice(0, 6);
const titleCase = (s: string) => s.toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());

// The first n sentences of the opening paragraphs stay visible; everything after goes behind "Read more".
// Scripture (<p><em>) and non-paragraph blocks always go behind it. Nothing is dropped.
const teaser = (html = '', n = 2) => {
  const head: string[] = [], tail: string[] = [];
  for (const block of html.split(/(?=<(?:p|h[1-6]|ul|ol)\b)/).map((b) => b.trim()).filter(Boolean)) {
    const inner = block.match(/^<p>([\s\S]*)<\/p>$/)?.[1];
    if (!n || !inner || inner.startsWith('<em>')) { tail.push(block); continue; }
    const s = inner.split(/(?<=[.!?])\s+(?=[A-Z“"])/);
    head.push(`<p>${s.slice(0, n).join(' ')}</p>`);
    if (s.length > n) tail.push(`<p>${s.slice(n).join(' ')}</p>`);
    n = Math.max(0, n - s.length);
  }
  return { head: head.join(''), tail: tail.join('') };
};
// Discipleship: the sign-up form is the visible CTA, so its "Get Connected" section is not repeated.
const discT = teaser((disc.entry.rendered?.html ?? '').split(/<h2[^>]*>Get Connected/i)[0], 1);
const womenT = teaser(women.entry.rendered?.html, 1);
const servingT = teaser(intro(serving.entry.body), 2);
const baptT = teaser(intro(bapt.entry.body), 1);
const rightnowT = teaser(rightnow.entry.rendered?.html, 1);

const chips = [
  ['discipleship', 'Discipleship'], ['esl', 'ESL'], ['prayer', 'Prayer'],
  ['serving', 'Serving'], ['baptisms', 'Baptisms'], ['resources', 'Resources'],
];
---

<Base
  title="Get Involved | Riverside Community Church"
  description="Grow, belong and serve at Riverside: discipleship groups, ESL classes, prayer, serving teams, baptisms, RightNow Media and Bible study guides."
>
  <Header slot="header" />

  <PageHead eyebrow="Get involved" title="Grow, belong and serve." image="/media/photos/cafe.jpg" focus="70% 50%" lede="There is a place for you at Riverside. Pick a next step." />

  <nav class="subnav" aria-label="On this page">
    <div class="container">
      <ul class="chips">{chips.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
    </div>
  </nav>

  <section class="section" id="discipleship">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Discipleship</p>
        <h2 class="h1">Follow Jesus <span class="accent">together.</span></h2>
      </div>
      <div class="lead-copy" set:html={discT.head} />
      <div class="btn-row cta"><a class="btn" href={DISCIPLESHIP_FORM} rel="noopener">Join a discipleship group</a></div>
      <p class="groups-link"><a class="link link-arrow" href={href('/groups')}>See which groups are meeting this week</a></p>
      <details class="readmore">
        <summary><span class="rm-more">Current study &amp; guides</span><span class="rm-less">Hide the study</span></summary>
        <div class="readmore-body prose" set:html={discT.tail} />
      </details>

      <div class="cards-grid pair">
        <article class="card" id="men">
          <h3>Men</h3>
          <p>Men At The River is our men&rsquo;s group. Email us and we will help you get connected.</p>
          <p class="card-cta"><a class="link link-arrow" href={mail}>Ask about the men&rsquo;s group</a></p>
        </article>
        <article class="card" id="women">
          <h3>Women</h3>
          <div set:html={womenT.head} />
          <details class="readmore">
            <summary><span class="rm-more">Read more</span><span class="rm-less">Show less</span><span class="sr-only"> about Women&rsquo;s Ministry</span></summary>
            <div class="readmore-body" set:html={womenT.tail} />
          </details>
          <p class="card-cta"><a class="link link-arrow" href={mail}>Ask about Women&rsquo;s Ministry</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band-paper" id="esl">
    <div class="container split">
      <div class="stack">
        <p class="eyebrow">ESL</p>
        <h2 class="h1">English classes, <span class="accent">everyone welcome.</span></h2>
        <p class="muted">Practice English in a friendly, patient class. Registration for our ESL program takes one short online form.</p>
        <div class="btn-row"><a class="btn" href={ESL_FORM} rel="noopener">Register for ESL</a></div>
      </div>
      <p class="hello" aria-hidden="true">Hello <span>Hola</span> Ol&aacute; <span>Bonjour</span> &#20320;&#22909;</p>
    </div>
  </section>

  <section class="section" id="prayer">
    <div class="container prayer">
      <div class="section-head">
        <p class="eyebrow">Prayer</p>
        <h2 class="h1">We would love to <span class="accent">pray with you.</span></h2>
        <p>Our Sunday morning prayer group meets {CHURCH.prayerTime} in the Counseling Office. Everyone is welcome.</p>
      </div>
      <div class="card prayer-card">
        <details class="request" name="prayer">
          <summary class="btn btn-dark">Get daily prayer emails</summary>
          <form class="mc" action={MAILCHIMP_PRAYER.action} method="post" target="_blank">
            <p>Daily prayer emails, plus a note when there are requests from the church, our members or the community.</p>
            <label>Email address <input type="email" name="EMAIL" required autocomplete="email" inputmode="email" autocapitalize="off" /></label>
            <div class="mc-names">
              <label>First name <input type="text" name="FNAME" required autocomplete="given-name" /></label>
              <label>Last name <input type="text" name="LNAME" required autocomplete="family-name" /></label>
            </div>
            <div class="hp" aria-hidden="true"><input type="text" name={MAILCHIMP_PRAYER.honeypot} tabindex="-1" autocomplete="off" /></div>
            <button class="btn btn-dark" type="submit">Sign up</button>
          </form>
        </details>
        <details class="request" name="prayer">
          <summary class="btn btn-outline">Send a request or praise</summary>
          <p class="request-note">You choose whether it can be shared publicly or only with our pastors and elders.</p>
          <MinistryForm id={prayer.entry.data.form!} title="Prayer request form" />
        </details>
      </div>
    </div>
  </section>

  <section class="section band-stone" id="serving">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Serving</p>
        <h2 class="h1">Get into <span class="accent">gear.</span></h2>
        <div set:html={servingT.head} />
        <details class="readmore">
          <summary><span class="rm-more">Read more</span><span class="rm-less">Show less</span><span class="sr-only"> about serving</span></summary>
          <div class="readmore-body" set:html={servingT.tail} />
        </details>
      </div>
      <div class="cards-grid snap-row" tabindex="0" role="region" aria-label="Serving teams">
        {sections(serving.entry.body).map((s) => (
          <article class="card"><h3>{s.title}</h3><div set:html={s.html} /></article>
        ))}
      </div>
      <div class="btn-row more"><a class="btn btn-dark" href={mail}>Email us to serve</a></div>
    </div>
  </section>

  <section class="section" id="baptisms">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Baptisms</p>
        <h2 class="h1">Take the <span class="accent">next step.</span></h2>
      </div>
      <div class="lead-copy" set:html={baptT.head} />
      <details class="readmore">
        <summary><span class="rm-more">Read more</span><span class="rm-less">Show less</span><span class="sr-only"> about baptism</span></summary>
        <div class="readmore-body" set:html={baptT.tail} />
      </details>
      <div class="vids snap-row">
        {testimonies.map((t) => (
          <figure>
            <Facade
              embed={`https://www.youtube-nocookie.com/embed/${t.id}?autoplay=1&rel=0`}
              href={`https://www.youtube.com/watch?v=${t.id}`}
              thumb={`https://i.ytimg.com/vi/${t.id}/hqdefault.jpg`}
              title={`${titleCase(t.name)} baptism testimony`}
            />
            <figcaption>{titleCase(t.name)}</figcaption>
          </figure>
        ))}
      </div>
      <div class="btn-row more">
        <a class="btn btn-dark" href={mail}>Ask about baptism</a>
        <a class="link link-arrow yt" href={CHURCH.socials.youtube} rel="noopener">More testimonies on YouTube</a>
      </div>
    </div>
  </section>

  <section class="section band-paper" id="resources">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Resources</p>
        <h2 class="h1">Keep <span class="accent">growing.</span></h2>
      </div>
      <div class="cards-grid pair">
        <article class="card" id="rightnow">
          <h3>RightNow Media</h3>
          <div set:html={rightnowT.head} />
          <details class="readmore">
            <summary><span class="rm-more">Read more</span><span class="rm-less">Show less</span><span class="sr-only"> about RightNow Media</span></summary>
            <div class="readmore-body" set:html={rightnowT.tail} />
          </details>
          <div class="btn-row"><a class="btn btn-sm" href={RIGHTNOW_URL} rel="noopener">Create a free account</a></div>
        </article>
        <article class="card" id="study-guides">
          <h3>Study guides</h3>
          <p class="guides-intro">Free printable PDF guides for small groups and personal study, from Deuteronomy to Revelation.</p>
          <details class="guides">
            <summary class="btn btn-sm btn-outline">Browse {guideCount} study guides</summary>
            <div class="prose small"><guides.Content /></div>
          </details>
        </article>
      </div>
      <p class="start"><strong>Not sure where to start?</strong> <a class="link link-arrow" href={href('/connect')}>Tell us about yourself</a> and we will help you find your place.</p>
    </div>
  </section>


  <Footer slot="footer" />
</Base>

<style>
  .lead-copy { max-width: 46rem; font-size: var(--step-1); line-height: 1.55; color: var(--ink); }
  .cta { margin-top: 1.5rem; }
  .groups-link { margin-top: 1rem; }
  #discipleship .readmore { display: block; margin-top: 1rem; max-width: 46rem; }
  .readmore-body.prose { font-size: var(--step-0); }
  .pair .card { display: flex; flex-direction: column; }
  .pair .card > p, .pair .card > div:not(.readmore-body) > :global(p) { color: var(--ink); }
  .card-cta { margin-top: auto; padding-top: 1.25rem; font-weight: 700; }
  .card-cta .link { color: var(--gold-ink); }
  .prayer { display: grid; gap: 0 clamp(2rem, 1rem + 4vw, 5rem); align-items: start; }
  .prayer-card { display: grid; gap: 1rem; border-top: 3px solid var(--gold); }
  .mc-names { display: grid; gap: 1rem; grid-template-columns: 1fr 1fr; }
  .request > summary { list-style: none; width: 100%; }
  .request > summary::-webkit-details-marker { display: none; }
  .request > summary::after { content: '+'; margin-left: 0.6rem; font-size: 1.25em; line-height: 1; }
  .request[open] > summary::after { content: '\2212'; }
  .request :global(.embed) { margin-inline: calc(-1 * clamp(1.25rem, 1rem + 1vw, 2rem)); box-shadow: none; }
  .pair { grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); margin-top: 3rem; }
  .pair .card { height: 100%; }
  .pair .card h3 { font-size: var(--step-2); }
  .prose.small { font-size: max(1rem, var(--step-0)); max-width: none; }
  .prose.small p { color: var(--ink); }
  .prose :global(h2) { font-size: var(--step-2); }
  .hello { font-family: var(--font-display); font-size: var(--step-5); line-height: 1.1; color: var(--gold-ink); }
  .hello span { color: var(--ink); }
  .mc { display: grid; gap: 1rem; margin-top: 1.25rem; }
  .mc p, .request-note { color: var(--muted); margin-top: 1rem; }
  .mc button { justify-self: start; }
  .mc label { display: grid; gap: 0.3rem; font-weight: 700; font-size: var(--step--1); }
  .mc label { min-width: 0; }
  .mc input { width: 100%; min-width: 0; padding: 0.75rem 1rem; min-height: 48px; border: 1.5px solid var(--stone-2); border-radius: var(--radius-s); background: #fff; font-weight: 400; font-size: max(1rem, 16px); }
  .hp { position: absolute; left: -5000px; }
  .vids { display: grid; gap: 1.5rem; margin-top: 2.5rem; }
  @media (min-width: 700px) { .vids { grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); } }
  figure { margin: 0; }
  figcaption { margin-top: 0.6rem; font-weight: 700; }
  .more { margin-top: 2rem; }
  .guides-intro { font-size: var(--step--1); color: var(--ink) !important; }
  .guides { margin-top: 1.25rem; }
  .guides summary { list-style: none; }
  .guides summary::-webkit-details-marker { display: none; }
  .guides[open] summary { margin-bottom: 1rem; }
  .guides :global(li a) { display: block; padding-block: 0.3rem; }
  /* Phones: tighter chapter rhythm so the page stays a quick scroll; long copy sits behind "Read more". */
  @media (max-width: 699px) {
    .section { padding-block: 3rem; }
    .lead-copy { font-size: var(--step-0); }
    .pair { margin-top: 2rem; }
    .section-head { margin-bottom: 1.5rem; }
    .hello { font-size: var(--step-2); }
    #serving .snap-row { align-items: start; }
    #serving .snap-row .card :global(p) { font-size: var(--step--1); }
  }
  .more { align-items: center; gap: 1rem 1.5rem; }
  .yt { font-weight: 700; color: var(--gold-ink); }
  @media (min-width: 720px) and (max-width: 1023px) { .hello { font-size: var(--step-3); } }
  @media (min-width: 720px) { .prayer { grid-template-columns: 1fr 1fr; } .prayer .section-head { margin-bottom: 0; } }
  .start { margin-top: clamp(1.75rem, 1.25rem + 2vw, 3rem); padding-top: 1.5rem; border-top: 1px solid var(--line-gold); font-size: var(--step-1); line-height: 1.5; }
  .start strong { font-family: var(--font-display); font-weight: 400; }
  .start .link { font-weight: 700; color: var(--gold-ink); }
</style>
