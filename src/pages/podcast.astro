---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHead from '../components/PageHead.astro';
import Cta from '../components/Cta.astro';
import VideoCard from '../components/VideoCard.astro';
import { CHURCH, href } from '../lib/site';
import { APPLE_PODCASTS_URL, getSermons } from '../lib/podcast';
import { getVideos } from '../lib/youtube';

const [videos, sermons] = await Promise.all([getVideos(3), getSermons()]);
const date = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
const year = (d: Date) => d.getUTCFullYear();
const SMALL = new Set(['a', 'an', 'the', 'and', 'but', 'or', 'nor', 'for', 'of', 'in', 'on', 'at', 'to', 'by', 'as', 'is', 'vs']);
// Old titles are often ALL CAPS: title-case those for display (mixed-case titles pass through). Scripture refs and
// short acronyms (ESV, NT...) are kept; Roman numerals stay upper.
const nice = (t: string) => {
  t = t.replace(/\b(?:[A-Za-z] ){2,}[A-Za-z]\b/g, (m) => m.replace(/ /g, '')).replace(/\s+/g, ' ').trim(); // "J O H N  17" -> "JOHN 17"
  if (t !== t.toUpperCase() || !/[A-Z]/.test(t)) return t;
  return t.toLowerCase().replace(/[a-z0-9][a-z0-9'’]*/g, (w, i) =>
    /^[ivx]+$/.test(w) || /^(esv|niv|nt|ot|ad|bc|usa|tv)$/.test(w) ? w.toUpperCase()
    : i > 0 && SMALL.has(w) ? w : w[0].toUpperCase() + w.slice(1));
};
const shown = sermons.slice(0, 6);
const rest = sermons.slice(6);
const span = sermons.length ? `${year(sermons[sermons.length - 1].pubDate)}–${year(sermons[0].pubDate)}` : '';
---

<Base
  title="Podcast | Riverside Community Church"
  description="Listen to messages from Riverside Community Church on YouTube, plus an archive of older sermon audio."
>
  <Header slot="header" />

  <PageHead eyebrow="Podcast" title="Listen anywhere." image="/media/photos/pulpit.jpg" focus="center" lede="Take Sunday with you: on your commute, on a walk, or at home.">
    <div class="btn-row" style="margin-top:2rem">
      <a class="btn btn-dark" href={CHURCH.socials.youtube} rel="noopener">Watch &amp; listen on YouTube</a>
      <a class="btn btn-outline" href={APPLE_PODCASTS_URL} rel="noopener">Podcast archive on Apple</a>
    </div>
  </PageHead>

  <section class="section" id="archive">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Audio archive</p>
        <h2 class="h1">Riverside Sunday <span class="accent">Messages</span> {span && <span class="muted">({span})</span>}</h2>
        <p class="muted">These recordings are from our previous podcast (2017–2020). New messages are on YouTube.</p>
      </div>

      {sermons.length === 0 ? (
        <p class="muted">The audio archive is unavailable right now. Try <a class="link" href={CHURCH.socials.youtube} rel="noopener">YouTube</a>.</p>
      ) : (
        <>
          <audio id="pod-audio" preload="none"></audio>
          <ol class="episodes" role="list">
            {shown.map((s) => (
              <li class="ep">
      <a class="ep-btn" data-pod={s.guid} href={s.audioUrl} aria-label={`Play ${nice(s.title)}`}></a>
      <div class="ep-info">
        <h3 data-pod={s.guid}>{nice(s.title)}</h3>
        <p class="date"><time datetime={s.pubDate.toISOString()}>{date(s.pubDate)}</time><span class="ep-time" aria-live="off"></span></p>
        <input class="ep-seek" data-pod={s.guid} type="range" min="0" max="100" step="1" value="0" aria-label={`Seek ${nice(s.title)}`} />
      </div>
    </li>
            ))}
          </ol>
          {rest.length > 0 && (
            <details class="older">
              <summary class="btn btn-outline">Show {rest.length} more episodes</summary>
              <ol class="episodes" role="list">
                {rest.map((s) => (
                  <li class="ep">
      <a class="ep-btn" data-pod={s.guid} href={s.audioUrl} aria-label={`Play ${nice(s.title)}`}></a>
      <div class="ep-info">
        <h3 data-pod={s.guid}>{nice(s.title)}</h3>
        <p class="date"><time datetime={s.pubDate.toISOString()}>{date(s.pubDate)}</time><span class="ep-time" aria-live="off"></span></p>
        <input class="ep-seek" data-pod={s.guid} type="range" min="0" max="100" step="1" value="0" aria-label={`Seek ${nice(s.title)}`} />
      </div>
    </li>
                ))}
              </ol>
            </details>
          )}
        </>
      )}
    </div>
  </section>

  <section class="section band-paper" id="latest">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Latest on YouTube</p>
        <h2 class="h1">Fresh from <span class="accent">Sunday.</span></h2>
        <p>Current messages are on YouTube.</p>
      </div>
      {videos.length > 0 ? (
        <ul class="vids" role="list">
          {videos.map((v) => (
            <li><VideoCard v={v} /></li>
          ))}
        </ul>
      ) : (
        <p class="muted">Recent videos are unavailable right now. Please visit <a class="link" href={CHURCH.socials.youtube} rel="noopener">our YouTube channel</a>.</p>
      )}
      <p class="more"><a class="link link-arrow" href={href('/watch')}>See all on Watch</a></p>
    </div>
  </section>

  <Cta title="Join us in person." text={`${CHURCH.times}. ${CHURCH.timesNote}.`}>
    <a class="btn" href={href('/im-new')}>Plan your visit</a>
    <a class="btn btn-light" href={href('/watch')}>Watch live</a>
  </Cta>

  <Footer slot="footer" />
</Base>

<script>
  const audio = document.getElementById('pod-audio') as HTMLAudioElement | null;
  if (audio) {
    const rows = [...document.querySelectorAll<HTMLElement>('.ep')];
    let cur: HTMLElement | null = null;
    const t = (n: number) => (isFinite(n) ? `${Math.floor(n / 60)}:${String(Math.floor(n % 60)).padStart(2, '0')}` : '0:00');
    const paint = () => rows.forEach((r) => {
      const on = r === cur;
      r.classList.toggle('on', on);
      r.querySelector('.ep-btn')!.setAttribute('aria-pressed', String(on && !audio.paused));
      if (!on) return;
      const seek = r.querySelector<HTMLInputElement>('.ep-seek')!;
      const d = audio.duration || 0;
      seek.max = String(Math.floor(d) || 100);
      seek.value = String(Math.floor(audio.currentTime));
      seek.style.setProperty('--p', d ? `${(audio.currentTime / d) * 100}%` : '0%');
      seek.setAttribute('aria-valuetext', `${t(audio.currentTime)} of ${t(d)}`);
      r.querySelector('.ep-time')!.textContent = ` · ${t(audio.currentTime)} / ${t(d)}`;
    });
    rows.forEach((r) => {
      const b = r.querySelector<HTMLAnchorElement>('.ep-btn')!;
      b.setAttribute('role', 'button');
      b.setAttribute('aria-pressed', 'false');
      const toggle = () => {
        if (cur === r) return audio.paused ? audio.play() : audio.pause();
        cur = r;
        audio.src = b.href;
        audio.play();
        paint();
      };
      b.addEventListener('click', (e) => { e.preventDefault(); toggle(); });
      b.addEventListener('keydown', (e) => { if (e.key === ' ') { e.preventDefault(); toggle(); } });
      r.querySelector<HTMLInputElement>('.ep-seek')!.addEventListener('input', (e) => {
        if (cur === r) audio.currentTime = +(e.target as HTMLInputElement).value;
      });
    });
    ['play', 'pause', 'timeupdate', 'loadedmetadata', 'ended'].forEach((ev) => audio.addEventListener(ev, paint));
    audio.addEventListener('error', () => { if (cur) cur.querySelector('.ep-time')!.textContent = ' · Could not load audio'; });
  }
</script>

<style>
  .vids { list-style: none; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  @media (max-width: 599px) { .vids { gap: 0.75rem; } }
  .date { font-size: var(--step--1); font-weight: 700; color: var(--gold-ink-sm); }
  .more { margin-top: 2rem; }

  .episodes { list-style: none; padding: 0; display: grid; gap: 0.75rem; }
  @media (min-width: 900px) { .episodes { grid-template-columns: 1fr 1fr; gap: 1rem; } }
  .ep { display: flex; align-items: center; gap: 1rem; padding: 0.9rem 1.1rem; background: var(--cream); border-radius: var(--radius); }
  .ep.on { box-shadow: inset 0 0 0 1.5px var(--gold); }
  .ep-btn {
    position: relative; flex: none; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--gold);
    transition: transform 0.3s var(--ease), background-color 0.25s;
  }
  .ep-btn:hover { background: var(--gold-soft); transform: scale(1.06); }
  .ep-btn::before { content: ''; position: absolute; left: 54%; top: 50%; translate: -50% -50%; border-block: 8px solid transparent; border-left: 13px solid var(--ink); }
  .ep-btn[aria-pressed='true']::before { left: 50%; width: 12px; height: 15px; border: 0; border-inline: 4px solid var(--ink); }
  .ep-info { min-width: 0; flex: 1; }
  .ep h3 { font-size: var(--step-0); line-height: 1.25; margin: 0; color: var(--ink); }
  .ep .date { margin-top: 0.15rem; font-weight: 600; }
  .ep-time { font-variant-numeric: tabular-nums; color: var(--ink); }
  .ep-seek { display: none; width: 100%; height: 1.5rem; margin: 0.35rem 0 0; background: none; appearance: none; cursor: pointer; --p: 0%; }
  .ep.on .ep-seek { display: block; }
  .ep-seek::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--gold-ink) var(--p), var(--stone-2) var(--p)); }
  .ep-seek::-moz-range-track { height: 4px; border-radius: 2px; background: var(--stone-2); }
  .ep-seek::-moz-range-progress { height: 4px; border-radius: 2px; background: var(--gold-ink); }
  .ep-seek::-webkit-slider-thumb { appearance: none; width: 14px; height: 14px; margin-top: -5px; border-radius: 50%; background: var(--ink); border: 0; }
  .ep-seek::-moz-range-thumb { width: 14px; height: 14px; border-radius: 50%; background: var(--ink); border: 0; }
  .older { margin-top: 1rem; }
  .older summary { cursor: pointer; list-style: none; margin-bottom: 1rem; }
  .older summary::-webkit-details-marker { display: none; }
  .older[open] summary { display: none; }
</style>
