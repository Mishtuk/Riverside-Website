// Cloudflare Worker: serves dist/ (static Astro build) plus src/worker.js for /api/*, /admin and page injection.
{
  "name": "riverside-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The alert banner can appear on every page, so page requests run the Worker first.
    // Media, fonts, logos and built scripts never do: they are served straight from the asset store, unmetered.
    "run_worker_first": ["/*", "!/_astro/*", "!/media/*", "!/fonts/*", "!/brand/*"]
  },
  // No id: Wrangler creates the namespace on first deploy (automatic provisioning).
  "kv_namespaces": [{ "binding": "SITE" }],
  "vars": {
    "MAILCHIMP_LIST_ID": "ab990cb198"
  },
  // Keep the vars set in the dashboard (TEAM_DOMAIN, POLICY_AUD, MAILCHIMP_FROM_NAME, MAILCHIMP_REPLY_TO) on deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
