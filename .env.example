# Local testing: copy this file to .env (git-ignored) and run `npm run build && node server.js`.
# Never use these values in production; the App Service settings are listed in HANDOFF.md.

# Testing period: the first account admin / admin works without a forced password change.
# Remove before launch (and change the admin password).
ALLOW_DEFAULT_ADMIN=1

# Who can get an emailed sign-in link. In development the link is printed in the terminal
# and the email lands in .data/outbox/.
ADMIN_EMAILS=you@example.org

# Skip sign-in entirely on localhost (development only; ignored in production):
# DEV_ADMIN=1
